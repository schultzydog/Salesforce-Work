                        applyHtmlTag="false"
                        standardStylesheets="false"
                        lightningStylesheets="true">
   <html>
      <head>
        <!-- Hotjar Tracking Code for my site -->
        <script>
                (function(h,o,t,j,a,r){
                h.hj=h.hj||function(){(h.hj.q=h.hj.q||[]).push(arguments)};
                h._hjSettings={hjid:3294726,hjsv:6};
                a=o.getElementsByTagName('head')[0];
                r=o.createElement('script');r.async=1;
                r.src=t+h._hjSettings.hjid+j+h._hjSettings.hjsv;
                a.appendChild(r);
                })(window,document,'https://static.hotjar.com/c/hotjar-','.js?sv=');
                function launch(){
                        var disp = document.getElementById('translate').style.display;
                        
                        if(disp == 'block'){
                           document.getElementById('translate').style.display = 'none';
                           document.getElementById('is-active').className = '';
                        }else{
                           document.getElementById('translate').style.display = 'block';
                           document.getElementById('is-active').className = 'is-active';
                        }
                }
        </script>
         <style>
                #awesomebar > li.more > a.is-active {
                        background-color: #5579cf;
                }
                #awesomewrap {
                        color: #fff;
                        font-size: 14px;
                        text-shadow: none;
                        position: relative;
                        z-index: 999;
                        
                }
                #awesomebar {
                        -webkit-box-shadow: 0 2px 2px 0 rgb(0 0 0 / 20%);
                        box-shadow: 0 2px 3px 0 rgb(0 0 0 / 20%);
                }
                #awesomebar {
                        position: fixed;
                        top: 0;
                        left: 0;
                        width: 100%;
                        height: 40px;
                        border-bottom: 1px solid #ccc;
                        background: #3a5dae;
                        
                        opacity: 70%;
                }
                #awesomewrap * {
                        margin: 0;
                        padding: 0;
                        font-family: "Helvetica Neue",Helvetica,Arial,Verdana,sans-serif;
                }
                #awesomewrap li {
                        list-style: none;
                        display: inline;
                }
                #awesomebar > li > a {
                        display: block;
                        font-weight: bold;
                        float: left;
                        line-height: 40px;
                        padding: 0 20px;
                        border-right: 1px solid #ccc;
                }
                #awesomewrap a {
                        color: #fff !important;
                        text-decoration: none;
                }
                #awesomewrap .float-r {
                        float: right;
                }
                #awesomebar > li.more {
                        position: relative;
                }
                .container-fluid{
                        margin-top:55px;
                }

                #awesomebar > li > ul {
                        display: none;
                }
                #translate {
                        position: absolute;
                        top: 41px;
                        right: 0;
                        height: 200px;
                        width: 198px;
                        overflow: auto;
                        max-height: 200px;
                        border: 1px solid #ccc;
                        border-top: none;
                        background: #3a5dae;
                        opacity:90%;
                        z-index: 100;
                }
                #translate a {
                        display: block;
                        line-height: 30px;
                        border-top: 1px solid #ccc;
                        padding: 0 10px 0 20px;
                }
                #translate a:hover {
                        background-color: #5579cf;
                }
                #awesomebar a:hover {
                        background-color: #5579cf;
                }

         </style>
