<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <validationRules>
        <fullName>Budget_Allocation_should_be_100</fullName>
        <active>true</active>
        <errorConditionFormula>ISPICKVAL(Will_client_cover_trip_costs__c , &apos;No&apos;) &amp;&amp;  
(ISPICKVAL( Request_Status__c , &apos;New&apos;) || ISPICKVAL( Request_Status__c , &apos;Submitted&apos;))&amp;&amp; Total_Budget__c  &lt;&gt; 1</errorConditionFormula>
        <errorMessage>Please make sure travel budget allocation adds up to 100%</errorMessage>
    </validationRules>
</CustomObject>
