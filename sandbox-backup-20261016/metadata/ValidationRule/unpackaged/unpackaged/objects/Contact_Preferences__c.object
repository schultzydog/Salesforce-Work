<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <validationRules>
        <fullName>Account_Preference_Validation</fullName>
        <active>false</active>
        <errorConditionFormula>And(

Contact__r.Account.Id &lt;&gt;  Account_Preferences__r.Account__r.Id,
$Profile.Id &lt;&gt; &apos;00e3A000001qOGe&apos;


)</errorConditionFormula>
        <errorMessage>You must select an Account Preference for the Account associated with the select Contact</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Contact_Required</fullName>
        <active>true</active>
        <errorConditionFormula>OR( ISNULL( Contact__c ), ISBLANK( Contact__c ))</errorConditionFormula>
        <errorDisplayField>Contact__c</errorDisplayField>
        <errorMessage>A contact is required when saving a Contact Preference</errorMessage>
    </validationRules>
</CustomObject>
