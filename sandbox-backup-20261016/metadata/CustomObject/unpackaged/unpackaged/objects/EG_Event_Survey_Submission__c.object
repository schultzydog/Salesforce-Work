    <fields>
        <fullName>Counter_How_easy_to_access_call__c</fullName>
        <externalId>false</externalId>
        <formula>CASE(How_easy_was_it_to_access_call__c, 
&apos;Very easy&apos;, 5, 
&apos;Somewhat easy&apos;, 4,
&apos;Neutral&apos;, 3,
&apos;Somewhat difficult&apos;, 2,
&apos;Very difficult&apos;, 1,

null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Counter - How easy to access call</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Counter_Recommendation_scale__c</fullName>
        <externalId>false</externalId>
        <formula>CASE( Recommendation_scale__c ,
&apos;10&apos;, 10,
&apos;9&apos;, 9,
&apos;8&apos;, 8,
&apos;7&apos;, 7,
&apos;6&apos;, 6,
&apos;5&apos;, 5,
&apos;4&apos;, 4,
&apos;3&apos;, 3,
&apos;2&apos;, 2,
&apos;1&apos;, 1,
&apos;0&apos;, 0,

null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Counter - Recommendation scale</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Counter_Speaker_clarity__c</fullName>
        <externalId>false</externalId>
        <formula>CASE( Speaker_clarity_and_understandability__c ,
&apos;Very clear&apos;, 5,
&apos;Somewhat clear&apos;, 4,
&apos;Neutral&apos;, 3,
&apos;Somewhat unclear&apos;, 2,
&apos;Very unclear&apos;, 1,

null)</formula>
