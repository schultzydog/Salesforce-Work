        <externalId>false</externalId>
        <formula>IF( TEXT(Status) = &quot;New&quot;, IMAGE(&quot;https://eurasiagroup.file.force.com/servlet/servlet.ImageServer?id=0154V000005RYL4&amp;oid=00DWL00000BtPgz&amp;lastMod=1656446538000&quot;, &quot;red&quot;),
IF( TEXT(Status) = &quot;In Progress&quot;, IMAGE(&quot;https://eurasiagroup.file.force.com/servlet/servlet.ImageServer?id=0154V000005RYL9&amp;oid=00DWL00000BtPgz&amp;lastMod=1656446525000&quot;, &quot;orange&quot;),

IF( TEXT(Status) = &quot;Completed&quot;, IMAGE(&quot;https://eurasiagroup.file.force.com/servlet/servlet.ImageServer?id=0154V000005RYLY&amp;oid=00DWL00000BtPgz&amp;lastMod=1656446470000&quot;, &quot;green&quot;), 

IMAGE(&quot;https://eurasiagroup.file.force.com/servlet/servlet.ImageServer?id=0154V000005M6LB&amp;oid=00DWL00000BtPgz&amp;lastMod=1674067317000&quot;, &quot;blue&quot;))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Status indicator</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
