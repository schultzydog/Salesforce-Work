    <fields>
        <fullName>Days_between_Last_Send_Read__c</fullName>
        <externalId>false</externalId>
        <formula>IF( NOT ISNULL(Worldflow_Last_Email_Read__c ), 
IF(Worldflow_Last_Email_Read__c -  Worldflow_Last_Email_Sent__c &gt; 0, &apos;0&apos;,

TEXT(ABS(ROUND(Worldflow_Last_Email_Read__c -  Worldflow_Last_Email_Sent__c, 0)))), 
&apos;No emails read&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Days between Last Sent/Read email</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Days_since_last_WF_Login__c</fullName>
        <externalId>false</externalId>
        <formula>IF( ISPICKVAL(Status__c, &apos;Enabled&apos;) &amp;&amp; Worldflow_Portal_Access__c = TRUE &amp;&amp;  Worldflow_Email_Access__c = TRUE, 
 TODAY() - DateValue(Worldflow_Last_Login__c),
null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Days since last WF Login</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
