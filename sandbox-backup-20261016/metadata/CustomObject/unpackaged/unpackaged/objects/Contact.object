        <lookupFilter>
            <active>true</active>
            <booleanFilter>(1 OR 2) AND 3</booleanFilter>
            <filterItems>
                <field>ia_crm__Intacct_Entity__c.ia_crm__Entity_Type__c</field>
                <operation>equals</operation>
                <value>Entity</value>
            </filterItems>
            <filterItems>
                <field>ia_crm__Intacct_Entity__c.ia_crm__Entity_Type__c</field>
                <operation>equals</operation>
                <value>Top Level</value>
            </filterItems>
            <filterItems>
                <field>ia_crm__Intacct_Entity__c.ia_crm__Hidden__c</field>
                <operation>notEqual</operation>
                <value>True</value>
            </filterItems>
            <isOptional>true</isOptional>
        </lookupFilter>
        <referenceTo>ia_crm__Intacct_Entity__c</referenceTo>
        <relationshipLabel>Contacts</relationshipLabel>
        <relationshipName>Contacts</relationshipName>
