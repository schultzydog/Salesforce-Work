    <fields>
        <fullName>Contact_Level__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
OR(
CONTAINS(UPPER( Title ), &quot;CHIEF&quot;),
CONTAINS(UPPER(Title), &quot;CEO&quot;),
CONTAINS(UPPER(Title), &quot;CFO&quot;),
CONTAINS(UPPER(Title), &quot;COO&quot;),
CONTAINS(UPPER(Title), &quot;CIO&quot;),
CONTAINS(UPPER(Title), &quot;CTO&quot;),
CONTAINS(UPPER(Title), &quot;CISO&quot;),
CONTAINS(UPPER(Title), &quot;CHRO&quot;),
CONTAINS(UPPER(Title), &quot;PRESIDENT&quot;)
),
&quot;C-suite&quot;,
IF(
OR(
CONTAINS(UPPER(Title), &quot;EVP&quot;),
CONTAINS(UPPER(Title), &quot;EXECUTIVE VICE PRESIDENT&quot;),
CONTAINS(UPPER(Title), &quot;SVP&quot;),
CONTAINS(UPPER(Title), &quot;SENIOR VICE PRESIDENT&quot;),
CONTAINS(UPPER(Title), &quot;VP&quot;),
CONTAINS(UPPER(Title), &quot;VICE PRESIDENT&quot;),
CONTAINS(UPPER(Title), &quot;HEAD&quot;),
CONTAINS(UPPER(Title), &quot;BOARD&quot;),
CONTAINS(UPPER(Title), &quot;MD&quot;),
CONTAINS(UPPER(Title), &quot;MANAGING DIRECTOR&quot;),
CONTAINS(UPPER(Title), &quot;PARTNER&quot;)
),
&quot;Senior Leader&quot;,
IF(
OR(
CONTAINS(UPPER(Title), &quot;DIRECTOR&quot;),
CONTAINS(UPPER(Title), &quot;MANAGER&quot;),
CONTAINS(UPPER(Title), &quot;PM&quot;),
CONTAINS(UPPER(Title), &quot;LEAD&quot;),
CONTAINS(UPPER(Title), &quot;COUNSEL&quot;),
CONTAINS(UPPER(Title), &quot;ANALYST&quot;),
CONTAINS(UPPER(Title), &quot;ASSOCIATE&quot;),
CONTAINS(UPPER(Title), &quot;SPECIALIST&quot;),
CONTAINS(UPPER(Title), &quot;COORDINATOR&quot;)
),
&quot;Working-Level&quot;,
&quot;No Title&quot;
)
)
)</formula>
        <label>Contact Level</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
