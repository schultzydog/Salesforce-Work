        <formula>Account.Risk_Dashboard_subscriber__c  &amp;&amp;   NOT ISNULL(Portal_User__c) &amp;&amp; NOT ISBLANK(Portal_User__c) &amp;&amp;  Portal_User__r.IsActive</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Risk Dashboard Access</label>
