    <fields>
        <fullName>Sunday_sync_with_WF__c</fullName>
        <description>(NOT ISBLANK(Email) &amp;&amp; ISBLANK(Last_WF_Sync_Date__c)) ||
((LastModifiedById &lt;&gt; &apos;0053A00000Dl2Z7&apos;) &amp;&amp; 
(LastModifiedById &lt;&gt; &apos;0054V00000G8MzD&apos;) &amp;&amp; 
(LastModifiedById &lt;&gt; &apos;0054V00000FPfJn&apos;) &amp;&amp; 
NOT CONTAINS(LastModifiedBy.Username, &apos;integration&apos;) &amp;&amp;
NOT CONTAINS(LastModifiedBy.Username, &apos;worldflow&apos;))</description>
        <formula>Id = &apos;0034V00004JWyWH&apos; || Not_syncing_with_WF__c || (NOT ISBLANK(Email) &amp;&amp; 
((LastModifiedById &lt;&gt; &apos;0053A00000Dl2Z7&apos;) &amp;&amp; (LastModifiedById &lt;&gt; &apos;0054V00000G8MzD&apos;) &amp;&amp;

(LastModifiedById &lt;&gt; &apos;0054V00000FPfJn&apos;) &amp;&amp; 
NOT CONTAINS(LastModifiedBy.Username, &apos;integration&apos;) &amp;&amp;
NOT CONTAINS(LastModifiedBy.Username, &apos;worldflow&apos;)) &amp;&amp; 
 DATEVALUE(LastModifiedDate) &gt;  Last_WF_Sync_Date_formula__c + 14)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Sunday sync with WF</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
