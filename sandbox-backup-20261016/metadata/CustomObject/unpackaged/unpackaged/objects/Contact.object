        <label>Remove prefs</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Remove_prefs_from_disabled_contact__c</fullName>
        <formula>ISPICKVAL(Status__c, &apos;Disabled&apos;) &amp;&amp; TODAY() -datevalue(Latest_Status_Disablement_date__c) &gt; 120</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Remove prefs from disabled contact</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>ReportsToId</fullName>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Research_Status__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(Status__c, &quot;Enabled&quot;) &amp;&amp;  Worldflow_Email_Access__c &amp;&amp; Number_of_Active_Prefs__c &gt; 0 &amp;&amp;  DATEVALUE(Worldflow_Last_Email_Sent__c) &gt; Today() - 30 &amp;&amp; NOT(Worldflow_Hard_Bounce__c) , 
&quot;Is Receiving Research&quot;, 
IF(DATEVALUE(Worldflow_Last_Email_Sent__c) &lt; Today() - 30,&quot;No Longer Receiving Research&quot;, &quot;Not Receiving Research&quot;))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>This field can take up to 24 hours to display the user&apos;s actual research status.</inlineHelpText>
        <label>Research Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
