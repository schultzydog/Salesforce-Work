<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>Org-level SerpAPI key for contact enrichment. Do not retrieve populated keys into git.</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>API_Key__c</fullName>
        <description>SerpAPI private key. Set at the org default. Not stored in this repo.</description>
        <externalId>false</externalId>
        <label>API Key</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>SerpAPI Settings</label>
    <visibility>Public</visibility>
</CustomObject>
