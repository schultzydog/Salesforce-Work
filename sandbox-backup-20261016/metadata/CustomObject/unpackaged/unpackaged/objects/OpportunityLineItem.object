        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Opportunity_Product_Id__c</fullName>
        <externalId>false</externalId>
        <formula>casesafeid(Id)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>18 Char Opportunity Product Id</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Poll__c</fullName>
        <formula>CONTAINS( Product_Family__c , &apos;Poll&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Poll</label>
        <type>Checkbox</type>
    </fields>
