    <fields>
        <fullName>Has_Product_Libraries__c</fullName>
        <formula>PricebookEntry.Product2.Has_Product_Libraries__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Has Product Libraries</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Ian_speaking__c</fullName>
        <formula>CONTAINS( Product_Name__c , &apos;Ian Bremmer - In-Person&apos;) ||  CONTAINS( Product_Name__c , &apos;Ian Bremmer - Virtual&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Ian speaking</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Include_in_Top_30__c</fullName>
        <formula>Opportunity.IsWon &amp;&amp;
Opportunity.Account.Name != &apos;WNET&apos; &amp;&amp;
Opportunity.Account.Name != &apos;Washington Speakers Bureau&apos; &amp;&amp;

( (NOT(ISPICKVAL( Revenue_Type__c , &apos;Recurring&apos;)) &amp;&amp; ( Opportunity.Contract_Start_Date__c &gt; Today() - 365 &amp;&amp; Opportunity.Contract_Start_Date__c &lt; Today() +1) )

||

(( NOT ISBLANK(Opportunity.Renewal_Opportunity__c) &amp;&amp; Opportunity.Renewal_Opportunity_Open__c = TRUE &amp;&amp; ISPICKVAL(Opportunity.Contract_Status__c, &apos;Expired&apos;) || Opportunity.Contract_Active__c ) ))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Include in Top 30</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>IsActive__c</fullName>
        <formula>PricebookEntry.IsActive</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>IsActive?</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>LastSyncTime</fullName>
    </fields>
    <fields>
        <fullName>Linked_EG_Project_Task__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Linked EG Project Task</label>
        <referenceTo>EG_Project_Task__c</referenceTo>
        <relationshipLabel>Opportunity Product</relationshipLabel>
        <relationshipName>Opportunity_Product</relationshipName>
        <required>false</required>
