    <validationRules>
        <fullName>Lock_Oppty_Product_Records_after_Closed</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
(ISPICKVAL( Opportunity.StageName ,&quot;Win&quot;) || ISPICKVAL(Opportunity.StageName,&quot;Closed Lost&quot;)),
 $User.Id &lt;&gt; &apos;0054V00000G8XY7&apos;,
 $User.Id &lt;&gt; &apos;0054V00000GOIjR&apos;,
 $User.Id &lt;&gt; &apos;005dK000001YNT3&apos;,
CASE($Profile.Name,
&quot;System Admin - Digital Operations&quot;,1,
&quot;Finance&quot;,1,
&quot;System Administrator&quot;,1,
0)=0
)</errorConditionFormula>
        <errorMessage>Once the Opportunity Stage has been Won or Lost the Opportunity Product Records are Locked. Please contact Finance for any corrections or updates.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ia_crm__Amount_cannot_be_empty</fullName>
        <active>false</active>
        <description>Flat/Fixed amount(Amount__c) cannot be empty if billing method is Fixed price.</description>
        <errorConditionFormula>IF(AND(ISPICKVAL(ia_crm__Billing_Method__c, &apos;Fixed price&apos;), Opportunity.RecordType.DeveloperName = &apos;Contract&apos; ), ISBLANK(ia_crm__Amount__c), false)</errorConditionFormula>
        <errorMessage>Flat/Fixed amount cannot be empty if billing method is Fixed price.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ia_crm__Billing_Template_Dates_Required</fullName>
        <active>false</active>
        <description>For &apos;Use billing template&apos; Billing template, Billing start and Billing End date should be required.</description>
        <errorConditionFormula>IF( Opportunity.RecordType.DeveloperName = &apos;Contract&apos; ,IF(ISPICKVAL(ia_crm__Contract_Line_Save_Cancel_He__c, &apos;Use billing template&apos;), IF(OR(ISBLANK( ia_crm__Billing_Start_Date__c), ISBLANK( ia_crm__Billing_End_Date__c),  ISBLANK( ia_crm__Billing_Template__r.Name ) ), true, false),false), false)</errorConditionFormula>
        <errorMessage>Billing Template, Billing Start Date and Billing End Date are required when Flat/Fixed amount frequency is &apos;Use billing template&apos;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ia_crm__Contract_Dates_Validation</fullName>
        <active>false</active>
        <errorConditionFormula>IF(Opportunity.RecordType.DeveloperName = &apos;Contract&apos;,
IF(!ISBLANK(Opportunity.ContractId), 
OR( 
IF(AND(!(AND(ia_crm__Start_Date__c &gt;= Opportunity.Contract.StartDate, ia_crm__Start_Date__c &lt;= Opportunity.Contract.EndDate)), !ISBLANK(ia_crm__Start_Date__c)) , true, false), 
IF(AND(!(AND(ia_crm__End_Date__c &gt;= Opportunity.Contract.StartDate, ia_crm__End_Date__c &lt;= Opportunity.Contract.EndDate)), !ISBLANK(ia_crm__End_Date__c)) , true, false), 
IF(ISPICKVAL( ia_crm__Contract_Line_Save_Cancel_He__c , &apos;Use billing template&apos;), 
OR( 
IF(!(AND(ia_crm__Billing_Start_Date__c &gt;= Opportunity.Contract.StartDate, ia_crm__Billing_Start_Date__c &lt;= Opportunity.Contract.EndDate)) , true, false), 
IF(!(AND(ia_crm__Billing_End_Date__c &gt;= Opportunity.Contract.StartDate, ia_crm__Billing_End_Date__c &lt;= Opportunity.Contract.EndDate)) , true, false) 
), false) 
), false), false)</errorConditionFormula>
        <errorMessage>If the Opportunity has a Contract associated with it dates must be within the Start Date and End Date of the Contract.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ia_crm__Flat_Fixed_amount_frequency</fullName>
        <active>false</active>
        <description>If &apos;Flat/Fixed amount frequency&apos; = &apos;One Time&apos; or &apos;Include with every invoice&apos;, then the Start Date and End Date should be required.</description>
        <errorConditionFormula>IF(Opportunity.RecordType.DeveloperName = &apos;Contract&apos;,
IF(OR(ISPICKVAL(ia_crm__Contract_Line_Save_Cancel_He__c, &apos;One-time&apos;), ISPICKVAL(ia_crm__Contract_Line_Save_Cancel_He__c, &apos;Include with every invoice&apos;)),IF(OR(ISBLANK( ia_crm__Start_Date__c ),ISBLANK( ia_crm__End_Date__c )), true, false), false), false)</errorConditionFormula>
        <errorDisplayField>ia_crm__Contract_Line_Save_Cancel_He__c</errorDisplayField>
        <errorMessage>If &apos;Flat/Fixed amount frequency&apos; = &apos;One Time&apos; or &apos;Include with every invoice&apos; the Start Date and End Date are required.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ia_crm__Intacct_Entities_Match</fullName>
        <active>false</active>
        <description>The Intacct Location from the Opportunity Product should match the Opportunity Intacct Entity or be a sub-location for it.</description>
        <errorConditionFormula>IF(Opportunity.RecordType.DeveloperName = &apos;Contract&apos;,
IF(!ISBLANK( Opportunity.ia_crm__Intacct_Location__c ), IF(OR( ia_crm__Intacct_Location__c =  Opportunity.ia_crm__Intacct_Location__c,  ia_crm__Intacct_Location__r.ia_crm__Top_Entity__c  =  Opportunity.ia_crm__Intacct_Location__c, ISBLANK(ia_crm__Intacct_Location__c)), false, true), false), false)</errorConditionFormula>
        <errorDisplayField>ia_crm__Intacct_Location__c</errorDisplayField>
        <errorMessage>The Intacct Location should match the Opportunity Intacct Entity or be a sublocation for it.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ia_crm__Order_Entry_Entity_Match</fullName>
        <active>false</active>
        <description>On Order Entry opportunities the Intacct Entity should match the Opportunity Intacct Entity or be a sublocation for it.</description>
        <errorConditionFormula>IF(Opportunity.RecordType.DeveloperName = &apos;OrderEntry&apos;,
IF(!ISBLANK( Opportunity.ia_crm__Intacct_Location__c ), IF(OR( ia_crm__Intacct_Entity__c = Opportunity.ia_crm__Intacct_Location__c, ia_crm__Intacct_Entity__r.ia_crm__Top_Entity__c = Opportunity.ia_crm__Intacct_Location__c, ISBLANK(ia_crm__Intacct_Entity__c)), false, true), false), false)</errorConditionFormula>
        <errorDisplayField>ia_crm__Intacct_Entity__c</errorDisplayField>
        <errorMessage>The Intacct Entity from the Opportunity Product should match the Opportunity Intacct Entity or be a sublocation for it.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ia_crm__Quantity_Rate_Required</fullName>
        <active>false</active>
        <description>If Rate, Quantity or Multiplier, then both Rate and Quantity need to be filled in.</description>
        <errorConditionFormula>IF(Opportunity.RecordType.DeveloperName = &apos;Contract&apos;,
AND(OR(NOT(ISBLANK(UnitPrice)), NOT(ISBLANK(Quantity)), NOT(ISBLANK( ia_crm__Multiplier__c ))), OR(ISBLANK(UnitPrice), ISBLANK(Quantity))), false)</errorConditionFormula>
        <errorMessage>Incomplete input data is provided for &apos;Rate&apos;, &apos;Quantity&apos;, and &apos;Multiplier&apos;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ia_crm__Start_and_End_Dates_Validation</fullName>
        <active>false</active>
        <errorConditionFormula>OR(ia_crm__Start_Date__c &gt; ia_crm__End_Date__c, ia_crm__Billing_Start_Date__c &gt; ia_crm__Billing_End_Date__c)</errorConditionFormula>
        <errorMessage>Start dates must be earlier than the end dates.</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>ia_crm__Add_Line</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <linkType>url</linkType>
        <masterLabel>Add Line</masterLabel>
        <openType>replace</openType>
        <protected>false</protected>
        <requireRowSelection>false</requireRowSelection>
        <url>{!URLFOR($Site.Prefix + &apos;/apex/ia_crm__AddProduct?recordId=&apos; + Opportunity.Id + &apos;&amp;pageAction=Add&apos;)}</url>
    </webLinks>
    <webLinks>
        <fullName>ia_crm__Bulk_update</fullName>
        <availability>online</availability>
        <description>This button can be used in classic interface only, it contains item selection from Opportunity page.</description>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Bulk update</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>var ids = {!GETRECORDIDS($ObjectType.OpportunityLineItem)}; 

var url = &apos;{!URLFOR($Site.Prefix)}/apex/ia_crm__OpportunityProductsBulkUpdate?recordId={!Opportunity.Id}&amp;recordType={!Opportunity.RecordTypeId}&amp;hasOpportunityLine={!if(Opportunity.HasOpportunityLineItem,&apos;true&apos;,&apos;false&apos;)}&apos;;   

var isValid = true;
if (ids.length) { 
if (ids.length &lt;= 50) { 
url += &apos;&amp;oproductIds=&apos; + ids.join(&apos;,&apos;); 
} else { 
alert(&apos;You have selected more than 50 items, please select less items.&apos;); 
isValid=false;
} 
}
if(isValid) {
window.location = url;
}</url>
    </webLinks>
    <webLinks>
        <fullName>ia_crm__Bulk_update_lightning</fullName>
        <availability>online</availability>
        <description>This button must be used in lightning experience interface,  the functionality for selecting items from interface is disabled.</description>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <linkType>url</linkType>
        <masterLabel>Bulk update</masterLabel>
        <openType>replace</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>{!URLFOR($Site.Prefix + &apos;/apex/ia_crm__OpportunityProductsBulkUpdate?recordId=&apos; + Opportunity.Id + &apos;&amp;recordType=&apos; + Opportunity.RecordTypeId + &apos;&amp;hasOpportunityLine=&apos; +
IF(Opportunity.HasOpportunityLineItem, &apos;true&apos;, &apos;false&apos;))}</url>
    </webLinks>
