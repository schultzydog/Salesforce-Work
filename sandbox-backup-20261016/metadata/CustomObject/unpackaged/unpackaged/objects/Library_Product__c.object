    <fields>
        <fullName>Distribution_List_Category__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Library_Type__c = &apos;Distribution List&apos;,  Library__r.Distribution_List_SubCategory__r.Distribution_List_Category__r.Id , Library__c)</formula>
