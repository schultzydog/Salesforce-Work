        <externalId>false</externalId>
        <label>Record Type Name</label>
        <length>80</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SortName__c</fullName>
        <externalId>false</externalId>
        <formula>IF(OR(ISNULL(Distribution_List_SubCategory__r.Name),ISBLANK(Distribution_List_SubCategory__r.Name)),
if( Record_Type_Name__c = &quot;Portal Region Permission&quot;, 
  LEFT( &quot;RP - &quot; &amp; Name,80), 
  if( Record_Type_Name__c = &quot;Portal Sector Permission&quot;, 
     LEFT( &quot;SP - &quot; &amp; Name,80), 
     LEFT(Name,80) 
  )  
),
  LEFT( DL_Subcategory_Display__c &amp; &quot; - &quot; &amp;  Name,80)
)</formula>
        <label>Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Sort_Order__c</fullName>
        <externalId>false</externalId>
        <label>Sort Order</label>
        <precision>2</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Starter__c</fullName>
        <defaultValue>false</defaultValue>
        <inlineHelpText>ties to the Starter button on pref edit UI</inlineHelpText>
        <label>Starter</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Summary_Emails_ratio__c</fullName>
        <formula>Count_of_Summary_Email_Contact_Prefs__c / Count_of_Active_Contact_Prefs__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Summary Emails ratio</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Summary_Only_ratio__c</fullName>
        <formula>Count_of_Summary_Only_Prefs__c / Count_of_Active_Contact_Prefs__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Summary Only ratio</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>US_China_Tech__c</fullName>
        <defaultValue>false</defaultValue>
        <label>US-China Tech</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
