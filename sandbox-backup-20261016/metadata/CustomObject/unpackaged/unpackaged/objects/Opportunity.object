        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Taxable__c</fullName>
        <formula>Tax_Exempt__c = FALSE &amp;&amp; Estimated_Sales_Tax_Amount__c &gt; 0 &amp;&amp; 
(  ia_crm__Bill_to__r.MailingState = &apos;DC&apos; ||  ia_crm__Bill_to__r.MailingState = &apos;NY&apos; || ia_crm__Bill_to__r.MailingState = &apos;CT&apos; || ia_crm__Bill_to__r.MailingState = &apos;PA&apos; || ia_crm__Bill_to__r.MailingState = &apos;TX&apos; ||ia_crm__Bill_to__r.MailingState = &apos;WA&apos; ||ia_crm__Bill_to__r.MailingState = &apos;WI&apos; || ia_crm__Bill_to__r.MailingState = &apos;NJ&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Taxable</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
