        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Voting</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Won_60_days_in_advance__c</fullName>
        <formula>IF(
  IsWon = TRUE,
  Days_Between_Close_Date_and_Current_Star__c &lt;= 60,
  FALSE
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Won 60 days in advance</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
