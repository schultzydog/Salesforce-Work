        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SLR_Formula_test__c</fullName>
        <formula>IsWon  &amp;&amp;  NOT Bypass_Stage_Win_Automations__c &amp;&amp; NOT ISBLANK(Project_Code__c) &amp;&amp; Count_of_SLR_Entries__c &lt; 1 &amp;&amp;   Trigger_SLR_creation_flow__c &amp;&amp; 
( ISPICKVAL( Approval_Status__c , &apos;Approved&apos;)  || 
ISPICKVAL( Approval_Status__c , &apos;Pending Finance Approval&apos;) )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>SLR Formula test</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
