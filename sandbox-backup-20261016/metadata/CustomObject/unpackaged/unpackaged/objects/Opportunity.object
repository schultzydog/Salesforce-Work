        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(RevenueType__c , &apos;Recurring&apos;) &amp;&amp; (ISPICKVAL(Type, &apos;New Sale&apos; ) || ISPICKVAL(Type, &apos;Trial Conversion&apos; )) ,  Annualized_Value_USD__c , IF(ISPICKVAL(RevenueType__c , &apos;Recurring&apos;) &amp;&amp; ISPICKVAL(Type, &apos;Renewal&apos;) , UpSell_DownSell_Annualized_Value_USD__c , Contract_Amount_USD__c ))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>SLR Amount (USD)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
