    <fields>
        <fullName>PF_Number_of_installments__c</fullName>
        <externalId>false</externalId>
        <formula>IF(Number_of_months_in_Contract_term__c &gt; 0,
CASE(  PF_Billing_Cycle__c ,
&apos;One Time&apos;, 1,
&apos;Monthly in Advance&apos;, Number_of_months_in_Contract_term__c ,
&apos;Quarterly in Advance&apos;, Number_of_months_in_Contract_term__c/3,
&apos;Semi-Annually in Advance&apos;, Number_of_months_in_Contract_term__c/6,
&apos;Annually in Advance&apos;, Number_of_months_in_Contract_term__c/12,
&apos;50:50 (Speaking only)&apos;, 2,


null)
 , null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Number of installments</label>
        <precision>18</precision>
