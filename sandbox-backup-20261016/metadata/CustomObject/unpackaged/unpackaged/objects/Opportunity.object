    <fields>
        <fullName>Number_of_months_in_Contract_term__c</fullName>
        <externalId>false</externalId>
        <formula>Round(IF(( Contract_End_Date__c - Contract_Start_Date__c ) / 365 * 12 &lt; 1, 1, (Contract_End_Date__c - Contract_Start_Date__c ) / 365 * 12), 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Number of months in Contract term</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Number_of_year_ends_in_contract__c</fullName>
        <externalId>false</externalId>
