    <fields>
        <fullName>PV_Reporting_Year__c</fullName>
        <externalId>false</externalId>
        <formula>IF( 
Contract_Start_Date__c &lt;= DATE(2012, 12,31)  &amp;&amp;  Contract_End_Date__c &gt;= DATE(2012, 12,31), &apos;2012&apos;, 
IF( 
Contract_Start_Date__c &lt;= DATE(2013, 12,31)  &amp;&amp;  Contract_End_Date__c &gt;= DATE(2013, 12,31), &apos;2013&apos;,
IF(
Contract_Start_Date__c &lt;= DATE(2014, 12,31)  &amp;&amp;  Contract_End_Date__c &gt;= DATE(2014, 12,31), &apos;2014&apos;, 
IF( 
Contract_Start_Date__c &lt;= DATE(2015, 12,31)  &amp;&amp;  Contract_End_Date__c &gt;= DATE(2015, 12,31), &apos;2015&apos;,
IF(
Contract_Start_Date__c &lt;= DATE(2016, 12,31)  &amp;&amp;  Contract_End_Date__c &gt;= DATE(2016, 12,31), &apos;2016&apos;, 
IF( 
Contract_Start_Date__c &lt;= DATE(2017, 12,31)  &amp;&amp;  Contract_End_Date__c &gt;= DATE(2017, 12,31), &apos;2017&apos;,
IF( 
Contract_Start_Date__c &lt;= DATE(2018, 12,31)  &amp;&amp;  Contract_End_Date__c &gt;= DATE(2018, 12,31), &apos;2018&apos;, 
IF( 
Contract_Start_Date__c &lt;= DATE(2019, 12,31)  &amp;&amp;  Contract_End_Date__c &gt;= DATE(2019, 12,31), &apos;2019&apos;,
IF(
Contract_Start_Date__c &lt;= DATE(2020, 12,31)  &amp;&amp;  Contract_End_Date__c &gt;= DATE(2020, 12,31), &apos;2020&apos;, 
IF( 
Contract_Start_Date__c &lt;= DATE(2021, 12,31)  &amp;&amp;  Contract_End_Date__c &gt;= DATE(2021, 12,31), &apos;2021&apos;,
IF(
Contract_Start_Date__c &lt;= DATE(2022, 12,31)  &amp;&amp;  Contract_End_Date__c &gt;= DATE(2022, 12,31), &apos;2022&apos;, 
IF( 
Contract_Start_Date__c &lt;= DATE(2023, 12,31)  &amp;&amp;  Contract_End_Date__c &gt;= DATE(2023, 12,31), &apos;2023&apos;,
IF(
Contract_Start_Date__c &lt;= DATE(2024, 12,31)  &amp;&amp;  Contract_End_Date__c &gt;= DATE(2024, 12,31), &apos;2024&apos;, 
IF( 
Contract_Start_Date__c &lt;= DATE(2025, 12,31)  &amp;&amp;  Contract_End_Date__c &gt;= DATE(2025, 12,31), &apos;2025&apos;,
IF(
Contract_Start_Date__c &lt;= DATE(2026, 12,31)  &amp;&amp;  Contract_End_Date__c &gt;= DATE(2026, 12,31), &apos;2026&apos;, 
IF( 
Contract_Start_Date__c &lt;= DATE(2027, 12,31)  &amp;&amp;  Contract_End_Date__c &gt;= DATE(2027, 12,31), &apos;2027&apos;,

null))))))))))))))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>PV Reporting Year</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
