        <formula>Contract_Start_Date__c -  Account.Date_Research_Delivery_Began__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Days between Research and Contract</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Days_from_creation_to_Close__c</fullName>
        <externalId>false</externalId>
        <formula>CloseDate -  Datevalue(CreatedDate)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Days from creation to Close</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Days_past_Close_Date__c</fullName>
        <externalId>false</externalId>
        <formula>IF( NOT IsClosed , CloseDate - Today( ), null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Days past Close Date</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Days_past_Renewal_Date__c</fullName>
        <externalId>false</externalId>
        <formula>IF( NOT(IsClosed) &amp;&amp; Today() - Contract_Start_Date__c &gt; 0, Today() - Contract_Start_Date__c, null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Days past Renewal Date</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Days_since_last_touched__c</fullName>
        <externalId>false</externalId>
        <formula>TODAY() -  Tracked_Fields_Last_Change_Date__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Days since last touched</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Days_until_next_renewal_due__c</fullName>
        <externalId>false</externalId>
        <formula>IF(  NOT(IsClosed)  , Contract_Start_Date__c - Today(), null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Days until next renewal due</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
