        <formula>OR( AND(CEILING( MONTH (CloseDate)  / 3 )  &lt;=  CEILING( MONTH(  Contract_Start_Date__c -1  ) / 3 ),
   YEAR(  CloseDate  )  &lt;=  YEAR(   Contract_Start_Date__c -1  )), CEILING( MONTH (CloseDate)  / 3 )    &gt;=    CEILING( MONTH(  Contract_Start_Date__c -1  ) / 3 )  &amp;&amp; YEAR(  CloseDate  )   &lt;   YEAR(   Contract_Start_Date__c -1  ), 	Renewal_Won_on_Time_Day__c = TRUE)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
