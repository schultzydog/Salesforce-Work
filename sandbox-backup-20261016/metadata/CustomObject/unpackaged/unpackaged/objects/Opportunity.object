LPAD(TEXT(VALUE(RIGHT(Previous_Opportunity__r.Project_Code__c, 4)) + 1), 4, &quot;0&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
