    <fields>
        <fullName>Net_Lost_Revenue__c</fullName>
        <description>Downsell Renewal Value OR Lost Opportunity Value</description>
        <formula>IF( UpSell_DownSell_Annualized_Value_OC__c &lt;&gt; 0,  ABS(UpSell_DownSell_Annualized_Value_OC__c ) , 
 IF(  IsClosed  &amp;&amp;  NOT IsWon  ,    Amount  , 0) )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Net Lost Revenue</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Net_New_Revenue__c</fullName>
        <description>Upsell Renewal Value OR New Sale Value</description>
        <formula>IF( UpSell_DownSell_Annualized_Value_OC__c &lt;&gt; 0, UpSell_DownSell_Annualized_Value_OC__c , 
 IF( ISPICKVAL( Type , &apos;New Sale&apos;)  || ISPICKVAL( Type , &apos;Trial&apos;), Amount, 
 IF(NOT IsWon, -Amount, 0) ))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Net New Revenue</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
