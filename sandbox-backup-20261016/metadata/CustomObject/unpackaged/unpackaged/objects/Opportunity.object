    <fields>
        <fullName>Status__c</fullName>
        <description>Color-coded status display of renewal status</description>
        <externalId>false</externalId>
        <formula>IF( Days_until_next_renewal_due__c &lt; 0 , IMAGE(&quot;https://eurasiagroup--c.na138.content.force.com/servlet/servlet.ImageServer?id=0154V000005RYLd&amp;oid=00DWL00000BtPgz&amp;lastMod=1656452847000&quot;, &quot;dark red&quot;),

IF( Days_until_next_renewal_due__c &lt; 30 &amp;&amp;  Days_until_next_renewal_due__c &gt; -44, IMAGE(&quot;https://eurasiagroup--c.na138.content.force.com/servlet/servlet.ImageServer?id=0154V000005RYL4&amp;oid=00DWL00000BtPgz&amp;lastMod=1656446538000&quot;, &quot;red&quot;), 

IF( Days_until_next_renewal_due__c &lt; 60&amp;&amp;  Days_until_next_renewal_due__c &gt; 29, IMAGE(&quot;https://eurasiagroup--c.na138.content.force.com/servlet/servlet.ImageServer?id=0154V000005RYL9&amp;oid=00DWL00000BtPgz&amp;lastMod=1656446505000&quot;, &quot;orange&quot;), 

IF( Days_until_next_renewal_due__c &gt; 59 , IMAGE(&quot;https://eurasiagroup--c.na138.content.force.com/servlet/servlet.ImageServer?id=0154V000005RYLY&amp;oid=00DWL00000BtPgz&amp;lastMod=1656446470000&quot;, &quot;green&quot;), 


null))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
