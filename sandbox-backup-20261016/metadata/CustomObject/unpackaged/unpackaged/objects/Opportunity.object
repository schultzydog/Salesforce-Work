    <fields>
        <fullName>Unpaid_Trial_Opportunity__c</fullName>
        <externalId>false</externalId>
        <formula>IF(IsClosed = FALSE &amp;&amp; 
    Account.Count_of_Open_Renewals_Opportunities__c = 0 &amp;&amp; 
    Account.Count_of_Active_Contracts__c = 0 &amp;&amp; 
 Account.Count_of_Enabled_Contacts__c &gt; 0 &amp;&amp;
    NOT(ISPICKVAL(Account.Type, &quot;Media&quot;)) &amp;&amp;  
    NOT(ISPICKVAL(Account.Type, &quot;Friend of Firm&quot;)) &amp;&amp;  
    NOT(ISPICKVAL(Account.Type, &quot;Friend of Ian&quot;)) &amp;&amp; 
    NOT(ISPICKVAL(Account.Type, &quot;Client&quot;)) &amp;&amp; 
    NOT(ISPICKVAL(Type, &quot;Renewal&quot;)) &amp;&amp;  
    NOT(ISPICKVAL(Type, &quot;Voting&quot;)) &amp;&amp; 
    NOT(ISPICKVAL(Type, &quot;Vote Invoice Request&quot;)) &amp;&amp; 
    NOT(ISPICKVAL(Business_Line__c, &quot;GZERO&quot;)) &amp;&amp; 
    NOT(ISPICKVAL(Business_Line__c, &quot;OOP&quot;)), &quot;Yes&quot;, TEXT(Unpaid_Trial_Opportunity_history__c))</formula>
        <label>Unpaid Trial Opportunity</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Unpaid_Trial_Opportunity_history__c</fullName>
        <description>used to hold a static value of unpaid trial oppty when oppty closes</description>
        <label>Unpaid Trial Opportunity history</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <controllingField>Type</controllingField>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>No</fullName>
                    <default>false</default>
                    <label>No</label>
                </value>
                <value>
                    <fullName>Yes</fullName>
                    <default>false</default>
                    <label>Yes</label>
                </value>
            </valueSetDefinition>
            <valueSettings>
                <controllingFieldValue>New Sale</controllingFieldValue>
                <controllingFieldValue>Trial Conversion</controllingFieldValue>
                <controllingFieldValue>Renewal</controllingFieldValue>
                <controllingFieldValue>Voting</controllingFieldValue>
                <valueName>No</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>New Sale</controllingFieldValue>
                <valueName>Yes</valueName>
            </valueSettings>
        </valueSet>
    </fields>
    <fields>
        <fullName>UpSellDownSellAmount_OC__c</fullName>
        <description>Net Sale Amount displays the difference between this Opportunity amount and the Previous Opportunity Amount</description>
        <externalId>false</externalId>
        <formula>IF( (ISPICKVAL(Type,&apos;Renewal&apos;) &amp;&amp; NOT ISBLANK(Previous_Opportunity__c)) , Amount  -  Previous_Opportunity__r.Amount, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Net Sale Amount displays the difference between this Opportunity amount and the Previous Opportunity Amount.  If there is no Previous Opportunity then Net Sale equals this Opportunity amount.</inlineHelpText>
        <label>UpSell/DownSell Amount (OC)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>UpSell_DownSell_Amount_USD__c</fullName>
        <externalId>false</externalId>
        <formula>UpSellDownSellAmount_OC__c  / FX_rate__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>UpSell/DownSell Amount (USD)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>UpSell_DownSell_Annualized_Recurring__c</fullName>
        <externalId>false</externalId>
        <formula>IF( ISPICKVAL( RevenueType__c ,&apos;Recurring&apos;) &amp;&amp; NOT ISPICKVAL( Type ,&apos;New Sale&apos;) &amp;&amp; NOT ISPICKVAL( Type ,&apos;Trial Conversion&apos;) &amp;&amp; NOT ISBLANK(Previous_Opportunity__c),  Annualized_Value_USD_Recurring__c  -  Previous_Opportunity__r.Annualized_Value_USD_Recurring__c , 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>UpSell/DownSell- Annualized (Recurring)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>UpSell_DownSell_Annualized_Value_OC__c</fullName>
        <formula>IF( ISPICKVAL( RevenueType__c ,&apos;Recurring&apos;) &amp;&amp; NOT ISPICKVAL( Type ,&apos;New Sale&apos;) &amp;&amp; NOT ISPICKVAL( Type ,&apos;Trial Conversion&apos;)
,  Annualized_Value_OC__c - Previous_Opportunity__r.Annualized_Value_OC__c , 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>UpSell/DownSell - Annualized Value (OC)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>UpSell_DownSell_Annualized_Value_USD__c</fullName>
        <externalId>false</externalId>
        <formula>U_D_Annual_Value_Corporate_USD__c +  U_D_Annual_Value_Gloma_USD__c +  U_D_Annual_Value_GZERO_USD__c +  U_D_Annual_Value_OOP_USD__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>UpSell/DownSell - Annualized Value (USD)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>UpSell_DownSell_Expected_Revenue__c</fullName>
        <formula>Probability *  UpSellDownSellAmount_OC__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>UpSell/DownSell Expected Revenue</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Update__c</fullName>
        <label>Update for Maziar</label>
        <length>2000</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Update_to_Closed_Aged_out__c</fullName>
        <formula>NOT IsClosed &amp;&amp; Age__c &gt; 360 &amp;&amp; Days_since_last_touched__c &gt; 90 &amp;&amp; Days_past_Close_Date__c &gt; 30 &amp;&amp; ISPICKVAL(Type, &apos;New Sale&apos;) &amp;&amp; AccountId  &lt;&gt;  &apos;00130000016FGqUAAW&apos;</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Update to Closed/Aged out</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
