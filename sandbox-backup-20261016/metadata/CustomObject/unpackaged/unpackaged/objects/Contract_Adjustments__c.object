    <fields>
        <fullName>SLR_Amount_USD_formula__c</fullName>
        <externalId>false</externalId>
        <formula>IF (ISPICKVAL( Opportunity__r.RevenueType__c , &apos;Recurring&apos;) &amp;&amp; CONTAINS(TEXT(Contract_Adjustment_Reason__c) ,&apos;Mid-Year&apos;),  Annualized_Upsell_Downsell_Amount_USD__c , 
IF (ISPICKVAL( Opportunity__r.RevenueType__c , &apos;Recurring&apos;) &amp;&amp; NOT CONTAINS(TEXT(Contract_Adjustment_Reason__c) ,&apos;Mid-Year&apos;), 0,
New_Contract_Value_USD__c - Original_Contract_Amount_USD__c ))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>SLR Amount (USD) formula</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
