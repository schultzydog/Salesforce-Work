    <fields>
        <fullName>Annualized_Upsell_Downsell_Amount_OC__c</fullName>
        <externalId>false</externalId>
        <formula>IF( ISPICKVAL( Opportunity__r.RevenueType__c,&apos;Recurring&apos;) , New_Annualized_Value_OC__c -  Pre_Adjustment_Annualized_Value_OC__c, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Annualized Upsell/Downsell Amount (OC)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Annualized_Upsell_Downsell_Amount_USD__c</fullName>
        <externalId>false</externalId>
        <formula>Annualized_Upsell_Downsell_Amount_OC__c /  Opportunity__r.FX_rate__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Annualized Upsell/Downsell Amount (USD)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
