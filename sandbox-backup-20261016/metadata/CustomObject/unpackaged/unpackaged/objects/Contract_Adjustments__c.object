    <listViews>
        <fullName>X2023_Contract_Adj</fullName>
        <columns>Account__c</columns>
        <columns>NAME</columns>
        <columns>CREATED_DATE</columns>
        <columns>New_Contract_Value_OC__c</columns>
        <columns>New_End_Date__c</columns>
        <columns>New_Start_Date__c</columns>
        <columns>Contract_Adjustment_Reason__c</columns>
        <columns>New_Annualized_Value_OC__c</columns>
        <columns>Project_Code__c</columns>
        <columns>UpSell_DownSell_Amount_OC__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CREATED_DATE</field>
            <operation>greaterThan</operation>
            <value>8/1/2023 12:00 AM</value>
        </filters>
        <filters>
            <field>Account__c</field>
            <operation>notEqual</operation>
            <value>EG Testing Grounds</value>
        </filters>
        <label>2023 Contract Adj</label>
    </listViews>
