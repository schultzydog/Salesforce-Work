        <fullName>Contract_Adjustment_Reason__c</fullName>
        <label>Contract Adjustment Reason</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Voting</fullName>
                    <default>false</default>
                    <label>Voting</label>
                </value>
                <value>
                    <fullName>Cancellation</fullName>
                    <default>false</default>
                    <label>Cancellation</label>
                </value>
                <value>
                    <fullName>Flat Extension</fullName>
                    <default>false</default>
                    <label>Flat Extension</label>
                </value>
                <value>
                    <fullName>Mid-Year Upsell</fullName>
                    <default>false</default>
                    <label>Mid-Year Upsell</label>
                </value>
                <value>
                    <fullName>Mid-Year Downsell</fullName>
                    <default>false</default>
                    <label>Mid-Year Downsell</label>
                </value>
                <value>
                    <fullName>No Cost Extension</fullName>
                    <default>false</default>
                    <label>No Cost Extension (-)</label>
                </value>
                <value>
                    <fullName>Correction</fullName>
                    <default>false</default>
                    <label>Correction</label>
                </value>
                <value>
                    <fullName>Contract Consolidation</fullName>
                    <default>false</default>
                    <label>Contract Consolidation</label>
                </value>
                <value>
                    <fullName>Subcontractor Costs</fullName>
                    <default>false</default>
                    <label>Subcontractor Costs</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
