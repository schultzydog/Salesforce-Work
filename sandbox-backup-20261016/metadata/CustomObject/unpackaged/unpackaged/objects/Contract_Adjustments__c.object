    <fields>
        <fullName>Average_Month_OC__c</fullName>
        <externalId>false</externalId>
        <formula>New_Contract_Value_OC__c / Round(IF(( New_End_Date__c -  New_Start_Date__c ) / 365 * 12 &lt; 1, 1, (New_End_Date__c - New_Start_Date__c ) / 365 * 12), 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Average $/Month (OC)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
