    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Prevent_edit_by_non_admin</fullName>
        <active>true</active>
        <errorConditionFormula>NOT(Contains($Profile.Name , &apos;Admin&apos;))</errorConditionFormula>
        <errorMessage>Only System Admins are permitted to make changes to Product entries</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ia_crm__Cost_Method_Required_Inventory</fullName>
        <active>true</active>
        <description>Cost Method should be required if item type is inventory.</description>
        <errorConditionFormula>AND( ISPICKVAL(ia_crm__Item_Type__c, &apos;Inventory&apos;),  IsPICKVAL( ia_crm__Cost_Method__c, &apos;&apos; ) )</errorConditionFormula>
        <errorMessage>Cost method is required for Inventory products.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ia_crm__Product_Code_Required</fullName>
        <active>true</active>
        <description>Enforces the user to add a value to &apos;Product Code&apos; field.</description>
        <errorConditionFormula>ISBLANK(ProductCode)</errorConditionFormula>
        <errorDisplayField>ProductCode</errorDisplayField>
        <errorMessage>You must enter a value</errorMessage>
    </validationRules>
