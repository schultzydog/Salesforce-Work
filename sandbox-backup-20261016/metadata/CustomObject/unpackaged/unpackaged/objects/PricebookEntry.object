    <listViews>
        <fullName>Active_EG_Products</fullName>
        <columns>PRICEBOOK.NAME</columns>
        <columns>PRODUCT.NAME</columns>
        <columns>PRODUCT.CUSTOMER_PRODUCT_ID</columns>
        <columns>PRICEBOOK.CURRENCY_ISO_CODE</columns>
        <columns>PRODUCT.DEFAULT_PRICE</columns>
        <columns>PRODUCT.ACTIVE</columns>
        <columns>HAS_DEF_REV_SCHEDULE</columns>
        <columns>PRODUCT2.DESCRIPTION</columns>
        <filterScope>Queue</filterScope>
        <filters>
            <field>PRODUCT2.ACTIVE</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <label>Active EG Products</label>
        <queue>Eurasia Group</queue>
    </listViews>
