    <listViews>
        <fullName>All_of_My_Tasks</fullName>
        <columns>SUBJECT</columns>
        <columns>WHO_NAME</columns>
        <columns>WHAT_NAME</columns>
        <columns>DUE_DATE</columns>
        <columns>LAST_UPDATE</columns>
        <columns>CORE.USERS.ALIAS</columns>
        <columns>PRIORITY</columns>
        <columns>STATUS</columns>
        <columns>UPDATEDBY_USER.ALIAS</columns>
        <filterScope>Mine</filterScope>
        <label>My Tasks - Open and Completed</label>
    </listViews>
    <listViews>
        <fullName>Client_Services_Mexico</fullName>
        <booleanFilter>(1 OR 2 OR 3) AND 4</booleanFilter>
        <columns>SUBJECT</columns>
        <columns>WHO_NAME</columns>
        <columns>WHAT_NAME</columns>
        <columns>DUE_DATE</columns>
        <columns>LAST_UPDATE</columns>
        <columns>CORE.USERS.ALIAS</columns>
        <columns>PRIORITY</columns>
        <columns>STATUS</columns>
        <columns>UPDATEDBY_USER.ALIAS</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CORE.USERS.LAST_NAME</field>
            <operation>equals</operation>
            <value>Marin</value>
        </filters>
        <filters>
            <field>CORE.USERS.LAST_NAME</field>
            <operation>equals</operation>
            <value>Lucht</value>
        </filters>
        <filters>
            <field>CORE.USERS.LAST_NAME</field>
            <operation>equals</operation>
            <value>Cornwall</value>
        </filters>
        <filters>
            <field>STATUS</field>
            <operation>notEqual</operation>
            <value>Completed</value>
        </filters>
        <label>Client Services Mexico</label>
    </listViews>
    <listViews>
        <fullName>Client_Services_Task</fullName>
        <filterScope>Queue</filterScope>
        <label>Client Services</label>
        <queue>Client_Services</queue>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>My_Deliverable_Tasks</fullName>
        <columns>WHAT_NAME</columns>
        <columns>SUBJECT</columns>
        <columns>WHO_NAME</columns>
        <columns>DUE_DATE</columns>
        <columns>CORE.USERS.ALIAS</columns>
        <columns>PRIORITY</columns>
        <columns>STATUS</columns>
        <filterScope>Mine</filterScope>
        <filters>
            <field>STATUS</field>
            <operation>equals</operation>
            <value>Open,Not Started</value>
        </filters>
        <filters>
            <field>TYPE</field>
            <operation>equals</operation>
            <value>Deliverable</value>
        </filters>
        <label>My Deliverable Tasks</label>
    </listViews>
    <listViews>
        <fullName>Sales_Ops_Task</fullName>
        <filterScope>Queue</filterScope>
        <label>Sales Ops</label>
        <queue>Sales_Ops</queue>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
    </listViews>
    <recordTypeTrackFeedHistory>false</recordTypeTrackFeedHistory>
    <recordTypeTrackHistory>false</recordTypeTrackHistory>
    <recordTypes>
        <fullName>Default</fullName>
        <active>true</active>
        <label>Default</label>
        <picklistValues>
            <picklist>Contact_Lead__c</picklist>
            <values>
                <fullName>Contact</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Lead</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Needs_Review__c</picklist>
            <values>
                <fullName>No</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Yes</fullName>
                <default>true</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Priority</picklist>
            <values>
                <fullName>High</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Low</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Normal</fullName>
                <default>true</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Status</picklist>
            <values>
                <fullName>Completed</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Open</fullName>
                <default>true</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Subject</picklist>
            <values>
                <fullName>Call</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Entitlements Review</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Other</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Send Letter</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Send Quote</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Type</picklist>
            <values>
                <fullName>Publication Reply</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>To Do</fullName>
                <default>true</default>
            </values>
        </picklistValues>
    </recordTypes>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <webLinks>
        <fullName>Log_a_Call_Activity_List</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Log a Call</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <requireRowSelection>false</requireRowSelection>
        <url>/apex/taskassignmentpage?nooverride=1&amp;who_id={!Contact.Id}</url>
    </webLinks>
    <webLinks>
        <fullName>Log_a_Call_Lead</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <linkType>url</linkType>
        <masterLabel>Log a Lead Call</masterLabel>
        <openType>replace</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>/apex/taskassignmentpage?nooverride=1&amp;who_id={!Lead.Id}</url>
    </webLinks>
