        <columns>Analyst__c</columns>
        <columns>Travel_Start_Date__c</columns>
        <columns>Travel_End_Date__c</columns>
        <columns>Purpose__c</columns>
        <columns>Destination__c</columns>
        <columns>Will_client_cover_trip_costs__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Request_Status__c</field>
            <operation>equals</operation>
