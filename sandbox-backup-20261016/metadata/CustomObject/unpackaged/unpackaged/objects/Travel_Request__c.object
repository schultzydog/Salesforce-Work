    <fields>
        <fullName>Notes__c</fullName>
        <inlineHelpText>Do we have ability to follow up with prospects/other clients at this event? If so who/how many/any context?
Can we schedule a roadshow or other client visits around it?
Are there other reasons to do it? Are we close to an upsell or downsell with the client or prospect?</inlineHelpText>
        <label>Notes</label>
        <length>3000</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
