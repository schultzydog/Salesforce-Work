    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Budget_Allocation_should_be_100</fullName>
        <active>true</active>
        <errorConditionFormula>ISPICKVAL(Will_client_cover_trip_costs__c , &apos;No&apos;) &amp;&amp;  
(ISPICKVAL( Request_Status__c , &apos;New&apos;) || ISPICKVAL( Request_Status__c , &apos;Submitted&apos;))&amp;&amp; Total_Budget__c  &lt;&gt; 1</errorConditionFormula>
        <errorMessage>Please make sure travel budget allocation adds up to 100%</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Calendar</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Calendar</masterLabel>
        <openType>noSidebar</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>https://eurasiagroup.lightning.force.com/lightning/o/Event/home</url>
    </webLinks>
</CustomObject>
