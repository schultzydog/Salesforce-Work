    </fields>
    <fields>
        <fullName>Client_Sector_Risk__c</fullName>
        <externalId>false</externalId>
        <formula>CASE( Industry , &quot;Aerospace &amp; Defense&quot;, &quot;High&quot;, 
&quot;Agriculture&quot;,&quot;High&quot;,
&quot;Automotive&quot;,&quot;Medium&quot;,
&quot;Banking&quot;,&quot;Medium&quot;,
&quot;Biotechnology&quot;,&quot;Medium&quot;,
&quot;Business Services&quot;,&quot;High&quot;,
&quot;Chemicals&quot;,&quot;Low&quot;,
&quot;Communications &amp; technology&quot;,&quot;High&quot;,
&quot;Consulting&quot;,&quot;Medium&quot;,
&quot;Consumer&quot;,&quot;High&quot;,
&quot;Education&quot;,&quot;Medium&quot;,
&quot;Electronics&quot;,&quot;High&quot;,
&quot;Energy &amp; commodities&quot;,&quot;High&quot;,
&quot;Engineering &amp; construction&quot;,&quot;Medium&quot;,
&quot;Entertainment &quot;,&quot;Medium&quot;,
&quot;Environmental&quot;,&quot;High&quot;,
&quot;Financial Services&quot;,&quot;Medium&quot;,
&quot;Food &amp; Beverage&quot;,&quot;Low&quot;,
&quot;Gas &amp; Power&quot;,&quot;Low&quot;,
&quot;Government &quot;,&quot;Low&quot;,
&quot;Healthcare &quot;,&quot;High&quot;,
&quot;Hospitality &quot;,&quot;Medium&quot;,
&quot;Insurance&quot;,&quot;High&quot;,
&quot;Machinery&quot;,&quot;Medium&quot;,
&quot;Manufacturing&quot;,&quot;Medium&quot;,
&quot;Media &quot;,&quot;Medium&quot;,
&quot;Other&quot;,&quot;Low&quot;,
&quot;Pharma&quot;,&quot;High&quot;,
&quot;Real estate &quot;,&quot;High&quot;,
&quot;Retail &amp; consumer&quot;,&quot;Medium&quot;,
&quot;Services&quot;,&quot;Medium&quot;,
&quot;Telecommunications &quot;,&quot;High&quot;,
&quot;Transportation&quot;,&quot;High&quot;,



null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Client Sector Risk</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
