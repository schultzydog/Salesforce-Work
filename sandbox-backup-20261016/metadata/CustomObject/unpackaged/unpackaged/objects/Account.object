    <fields>
        <fullName>Record_Locator__c</fullName>
        <externalId>false</externalId>
        <formula>IF(NOT(ISBLANK(Crypto_Key__c)),

MID(Account_ID_18_Digit__c, 11, 2) + 
MID(Crypto_Key__c, 1, 8) +
MID(Account_ID_18_Digit__c, 13, 2) +
MID(Crypto_Key__c, 9, LEN(Crypto_Key__c) - 9) +
MID(Account_ID_18_Digit__c, 15, 1) +
RIGHT(Crypto_Key__c, 1),

NULL)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>An additional External Id for Account.</inlineHelpText>
        <label>Record Locator</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
