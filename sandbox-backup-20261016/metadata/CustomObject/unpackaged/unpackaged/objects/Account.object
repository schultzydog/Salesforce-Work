    </fields>
    <fields>
        <fullName>Audience__c</fullName>
        <inlineHelpText>•	To whom are our products delivered?
•	To which office are our products delivered?
•	How are our products used by the client?
•	Are our products distributed or posted, internally or externally by the client? (ie. website, intranet, etc)</inlineHelpText>
        <label>Audience</label>
        <length>32768</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Authorized_Users__c</fullName>
        <externalId>false</externalId>
        <label>Authorized Users</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Average_Contact__c</fullName>
        <externalId>false</externalId>
        <formula>IF(   Sum_of_Active_Recurring_Contracts_USD__c &gt; 0, IF(Count_of_Enabled_Contacts__c &gt; 0, Text(Sum_of_Active_Recurring_Contracts_USD__c /Count_of_Enabled_Contacts__c), &quot;No Enabled Contacts&quot;), &quot;No Recurring Contract&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Average $/Contact</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Average_Recurring_Revenue_Entitlement__c</fullName>
        <description>This field displays the average revenue per entitlement based on Annualized Revenue associated to Recurring products</description>
        <externalId>false</externalId>
        <formula>Sum_of_Recurring_Contracts_Annualized__c /  Number_of_Preferences__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Average Recurring Revenue/Entitlement</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
