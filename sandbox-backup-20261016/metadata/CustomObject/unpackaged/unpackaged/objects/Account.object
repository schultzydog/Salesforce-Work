    <fields>
        <fullName>Account_Conf_Call_Total_Unique_Contacts__c</fullName>
        <defaultValue>0</defaultValue>
        <externalId>false</externalId>
        <inlineHelpText>This field shows the total number of contacts at this account who have attended at least 1 conference call</inlineHelpText>
        <label># of contacts who have joined a call</label>
        <precision>5</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Account_Disablement_Date__c</fullName>
        <inlineHelpText>Latest date that a contact has been disabled.</inlineHelpText>
        <label>Account Disablement Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Account_ID_18_Digit__c</fullName>
        <externalId>false</externalId>
        <formula>casesafeid(Id)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account ID 18 Digit</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Account_Name_for_Risk_Dashboard_PDF__c</fullName>
        <externalId>false</externalId>
        <label>Account Name for Risk Dashboard PDF</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Active_Product_Sales_Price__c</fullName>
        <label>Active Product Sales Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Active_Trial__c</fullName>
        <formula>IF(Count_of_Open_Renewals_Opportunities__c = 0 &amp;&amp;
Count_of_Active_Contracts__c = 0 &amp;&amp;
Count_of_Enabled_Contacts__c &gt; 0 &amp;&amp;
NOT(ISPICKVAL(Type, &quot;Media&quot;)) &amp;&amp;
NOT(ISPICKVAL(Type, &quot;Friend of Firm&quot;)) &amp;&amp;
NOT(ISPICKVAL(Type, &quot;Friend of Ian&quot;)) &amp;&amp;
NOT(ISPICKVAL(Type, &quot;Client&quot;)) &amp;&amp;
NOT(ISPICKVAL(Type, &quot;Renewal&quot;)) &amp;&amp;
NOT(ISPICKVAL(Type, &quot;Voting&quot;)) &amp;&amp;
NOT(ISPICKVAL(Business_Line__c, &quot;GZERO&quot;)) &amp;&amp;
NOT(ISPICKVAL(Business_Line__c, &quot;OOP&quot;)), TRUE, FALSE)</formula>
        <label>Active Trial</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Additional_Scope_of_Work__c</fullName>
        <label>Additional Scope of Work</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Additional_Scope_of_Work</valueSetName>
        </valueSet>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Advisory_Global__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This field is temporary.  It indicates whether the account has an opportunity with the advisory global product that is also related to an active contract</description>
        <label>Advisory Global</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Advisory_Scope_of_Work__c</fullName>
