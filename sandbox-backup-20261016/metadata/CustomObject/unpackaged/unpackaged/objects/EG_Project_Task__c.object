    </fields>
    <fields>
        <fullName>Linked_Opportunity_Product__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Linked Opportunity Product</label>
        <referenceTo>OpportunityLineItem</referenceTo>
        <relationshipLabel>EG Project Tasks</relationshipLabel>
        <relationshipName>EG_Project_Tasks</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Note_Type__c</fullName>
        <externalId>false</externalId>
        <formula>IF( CONTAINS(EG_Project__r.Name, &apos;[Internal] Publications&apos;) &amp;&amp; CONTAINS( Name, &apos;non-recurring&apos;), &apos;Non-recurring&apos;, 
IF(CONTAINS(EG_Project__r.Name, &apos;[Internal] Publications&apos;) &amp;&amp; NOT CONTAINS(Name, &apos;non-recurring&apos;), &apos;Recurring&apos;, null))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Note Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Recurring__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Recurring</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <label>Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Active</fullName>
                    <default>false</default>
                    <label>Active</label>
                </value>
                <value>
                    <fullName>Inactive</fullName>
                    <default>false</default>
                    <label>Inactive</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Time_Category__c</fullName>
        <defaultValue>&apos;Client&apos;</defaultValue>
        <description>Client Time - time on specific clients and the [Internal] Business Development &amp; [Internal] Client Servicing categories

Research/Writing - [Internal] General Research and Services category &amp; [Internal] Publications

Internal - all other internal categories</description>
        <label>Time Category</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Time_Category</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Time_Category_formula__c</fullName>
        <externalId>false</externalId>
        <formula>IF (CONTAINS( EG_Project__r.Name, &apos;[Internal] Business Development&apos;) || 
CONTAINS( EG_Project__r.Name, &apos;[Internal] Client Servicing&apos;) ||
 Name = &apos;Conference Calls and Roundtables&apos; || 
 Name = &apos;Other - Multiple Client&apos; || 
NOT CONTAINS( EG_Project__r.Name, &apos;[Internal]&apos;), &apos;Client&apos;, 
IF (CONTAINS( EG_Project__r.Name, &apos;[Internal] General Research&apos;) , &apos;General Research&apos;, 
IF (CONTAINS( EG_Project__r.Name, &apos;[Internal] Publication&apos;) , &apos;Publications&apos;, 
IF (CONTAINS( EG_Project__r.Name, &apos;[Internal]&apos;), &apos;Internal&apos;, null))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Time Category formula</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>EG Project Task</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>EG_Project__c</columns>
        <columns>Status__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>Internal_Project_Tasks</fullName>
        <columns>EG_Project__c</columns>
        <columns>NAME</columns>
        <columns>Status__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>EG_Project__c</field>
            <operation>contains</operation>
            <value>[Internal</value>
        </filters>
        <label>Internal Project Tasks</label>
    </listViews>
    <nameField>
        <label>EG Project Task Name</label>
        <trackHistory>true</trackHistory>
        <type>Text</type>
    </nameField>
    <pluralLabel>EG Project Tasks</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <startsWith>Vowel</startsWith>
    <visibility>Public</visibility>
