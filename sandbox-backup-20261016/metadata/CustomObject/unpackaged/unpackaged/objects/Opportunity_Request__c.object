        <label>All</label>
    </listViews>
    <listViews>
        <fullName>My_Opportunity_Requests</fullName>
        <columns>NAME</columns>
        <columns>Opportunity__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>Type__c</columns>
        <columns>Amount_to_be_Invoiced__c</columns>
        <columns>Approval_Status__c</columns>
        <filterScope>Mine</filterScope>
        <label>My Opportunity Requests</label>
    </listViews>
    <listViews>
        <fullName>Pending_Business_Approval</fullName>
        <columns>NAME</columns>
        <columns>Opportunity__c</columns>
        <columns>Type__c</columns>
        <columns>Comments__c</columns>
        <columns>Amount_to_be_Invoiced__c</columns>
        <columns>Project_Code__c</columns>
        <columns>CREATEDBY_USER</columns>
        <columns>Opportunity_Owner__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Approval_Status__c</field>
            <operation>equals</operation>
            <value>Pending Business Approval</value>
        </filters>
        <label>Pending Business Approval</label>
    </listViews>
    <listViews>
        <fullName>Pending_Finance_Approval</fullName>
        <columns>NAME</columns>
        <columns>Opportunity__c</columns>
        <columns>Type__c</columns>
        <columns>Comments__c</columns>
        <columns>Amount_to_be_Invoiced__c</columns>
        <columns>Project_Code__c</columns>
        <columns>CREATEDBY_USER</columns>
        <columns>Opportunity_Owner__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Approval_Status__c</field>
            <operation>equals</operation>
            <value>Pending Finance Approval</value>
        </filters>
        <label>Pending Finance Approval</label>
    </listViews>
    <nameField>
        <displayFormat>OR-{0000}</displayFormat>
        <label>Opportunity Request Name</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Opportunity Requests</pluralLabel>
