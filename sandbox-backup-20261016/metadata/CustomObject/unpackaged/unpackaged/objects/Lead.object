        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Data</fullName>
                    <default>false</default>
                    <label>Data: Personal Email; Invalid Email; Invalid Phone; Duplicate; Spam/Test</label>
                </value>
                <value>
                    <fullName>Engagement</fullName>
                    <default>false</default>
                    <label>Engagement: Unreachable; Unresponsive; Opted Out; Not Interested</label>
                </value>
                <value>
                    <fullName>Fit</fullName>
                    <default>false</default>
                    <label>Fit: Not ICP; Wrong Role; Use Case Misaligned; Competitor/Partner; Non-Commercial</label>
                </value>
                <value>
                    <fullName>Status</fullName>
                    <default>false</default>
                    <label>Status: Left Firm; Role Changed; Acquired/Merged; Company Closed</label>
                </value>
                <value>
                    <fullName>Timing/Budget</fullName>
                    <default>false</default>
                    <label>Timing/Budget: No Budget; Budget Frozen; Timeline &gt;12m; Evaluate Later</label>
                </value>
                <value>
                    <fullName>Existing</fullName>
                    <default>false</default>
                    <label>Existing: Vendor Locked-In; Internal Solution; Already Committed</label>
                </value>
                <value>
                    <fullName>Compliance/Legal: Sanctions/AML; KYC Failed; Policy Conflict; Jurisdiction Limitation</fullName>
                    <default>false</default>
                    <label>Compliance/Legal: Sanctions/AML; KYC Failed; Policy Conflict; Jurisdiction Limitation</label>
                </value>
                <value>
                    <fullName>Operational: Capacity Constraint; Coverage Gap; Feature Gap; Pricing Misaligned</fullName>
                    <default>false</default>
                    <label>Operational: Capacity Constraint; Coverage Gap; Feature Gap; Pricing Misaligned</label>
                </value>
                <value>
                    <fullName>Process: Incomplete Info; Missing Consent; Source Unreliable; Misrouted</fullName>
                    <default>false</default>
                    <label>Process: Incomplete Info; Missing Consent; Source Unreliable; Misrouted</label>
                </value>
                <value>
                    <fullName>Other</fullName>
                    <default>false</default>
                    <label>Other</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
