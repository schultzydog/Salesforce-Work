        <fullName>Company_Referral</fullName>
        <active>true</active>
        <businessProcess>Standard Leads Process</businessProcess>
        <label>Company Referral</label>
        <picklistValues>
            <picklist>Attendee_Type__c</picklist>
            <values>
                <fullName>B3 Client</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>EG Client</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Media</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Contact_Status__c</picklist>
            <values>
                <fullName>Disabled</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Enabled</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Contact_us_form_Interested_In__c</picklist>
            <values>
                <fullName>Africa</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Brazil</fullName>
                <default>false</default>
            </values>
