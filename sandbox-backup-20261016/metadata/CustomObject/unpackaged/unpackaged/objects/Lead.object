    <fields>
        <fullName>jpw2__MQL_Date__c</fullName>
        <deprecated>false</deprecated>
        <inlineHelpText>Date and time when the lead was marked as MQL (Marketing qualified) based on Performance and Adoption Manager lead triggers</inlineHelpText>
        <label>MQL Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>jpw2__MQL_to_SAL_Duration__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF(ISBLANK( jpw2__MQL_Date__c) ,null, 
IF (ISBLANK(  jpw2__SAL_Date__c ) ,null,  jpw2__SAL_Date__c -jpw2__MQL_Date__c))</formula>
        <label>MQL to SAL Duration</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>jpw2__Owner_Transfer_Date__c</fullName>
        <deprecated>false</deprecated>
        <formula>DATETIMEVALUE(LastTransferDate)</formula>
        <label>Last Owner Transfer Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>jpw2__PQL_Duration__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF(!ISBLANK( jpw2__MQL_Date__c ),  jpw2__MQL_Date__c - CreatedDate,
IF(!ISBLANK( jpw2__SAL_Date__c ), jpw2__SAL_Date__c - CreatedDate, 
Now() - CreatedDate))</formula>
        <label>PQL Duration</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
