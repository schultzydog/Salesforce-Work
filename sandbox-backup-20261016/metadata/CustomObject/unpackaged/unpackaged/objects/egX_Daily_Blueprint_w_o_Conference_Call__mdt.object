<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>This object holds a Library/Account &apos;value pair&apos; combination.  For the records in this object, the library option will appear on the custom account preference page ONLY if the account id is specified.</description>
    <fields>
        <fullName>Account_Id__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Account Id</label>
        <length>18</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Libary_Id__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Library Id</label>
        <length>18</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Library Exception</label>
    <pluralLabel>Library Exceptions</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
