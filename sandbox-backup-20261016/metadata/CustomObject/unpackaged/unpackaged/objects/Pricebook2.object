    <fields>
        <fullName>ia_crm__Intacct_Entity_Id__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF( ISPICKVAL( ia_crm__Intacct_Entity__r.ia_crm__Entity_Type__c , &apos;Entity&apos;), ia_crm__Intacct_Entity__r.ia_crm__Intacct_Entity_ID__c , &apos;&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Intacct Entity Id</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ia_crm__Intacct_Entity__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <label>Intacct Entity</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>1 AND (2 OR 3)</booleanFilter>
            <filterItems>
                <field>ia_crm__Intacct_Entity__c.ia_crm__Hidden__c</field>
                <operation>notEqual</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>ia_crm__Intacct_Entity__c.ia_crm__Entity_Type__c</field>
                <operation>equals</operation>
                <value>Entity</value>
            </filterItems>
            <filterItems>
                <field>ia_crm__Intacct_Entity__c.ia_crm__Entity_Type__c</field>
                <operation>equals</operation>
                <value>Top level</value>
            </filterItems>
            <isOptional>true</isOptional>
        </lookupFilter>
        <referenceTo>ia_crm__Intacct_Entity__c</referenceTo>
        <relationshipLabel>Price Books</relationshipLabel>
        <relationshipName>Price_Books</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>ia_crm__Intacct_Sync_Errors__c</fullName>
        <deprecated>false</deprecated>
        <label>Intacct Sync Errors</label>
        <length>10000</length>
        <trackHistory>false</trackHistory>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>ia_crm__Intacct_Sync_Status_Image__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>CASE( ia_crm__Intacct_Sync_Status__c , &quot;OK&quot;, IMAGE(&quot;/img/msg_icons/confirm16.png&quot;, &quot;OK&quot;), &quot;Error&quot;, IMAGE(&quot;/img/msg_icons/error16.png&quot;, &quot;Error&quot;), &quot;Warning&quot;, IMAGE(&quot;/img/msg_icons/warning16.png&quot;, &quot;Warning&quot;),TEXT(ia_crm__Intacct_Sync_Status__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Intacct Sync Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ia_crm__Intacct_Sync_Status__c</fullName>
        <deprecated>false</deprecated>
        <label>Intacct Sync Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
