    <fields>
        <fullName>ia_crm__Intacct_Entity_Id__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF( ISPICKVAL( ia_crm__Intacct_Entity__r.ia_crm__Entity_Type__c , &apos;Entity&apos;), ia_crm__Intacct_Entity__r.ia_crm__Intacct_Entity_ID__c ,   ia_crm__Intacct_Entity__r.ia_crm__Top_Entity__r.ia_crm__Intacct_Entity_ID__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
