        <fullName>ia_crm__End_Customer__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <inlineHelpText>For Standard/Direct business leave the field blank. 
For Reseller business, populate this with End Customer. Please note that the value needs to be equal to the Opportunity Account.</inlineHelpText>
        <label>End Customer</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Contracts (End Customer)</relationshipLabel>
        <relationshipName>Contracts</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
