        <protected>false</protected>
        <url>{!URLFOR($Site.Prefix + &apos;/apex/ia_crm__ContractAddOn?isStandard=true&amp;contractId=&apos; + Contract.Id)}</url>
    </webLinks>
    <webLinks>
        <fullName>ia_crm__Create_Add_on_oppotunity</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <linkType>url</linkType>
        <masterLabel>Create Add-on oppotunity</masterLabel>
        <openType>replace</openType>
        <protected>false</protected>
        <url>/apex/ia_crm__ContractAddOn?isStandard=true&amp;contractId={!Contract.Id}</url>
    </webLinks>
    <webLinks>
        <fullName>ia_crm__Create_Contract</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <linkType>url</linkType>
        <masterLabel>Sync to Intacct</masterLabel>
        <openType>replace</openType>
        <protected>false</protected>
        <url>{!URLFOR($Site.Prefix + &apos;/apex/ia_crm__DataSyncronization?action=&apos; + IF(OR(ISNULL(Contract.ia_crm__Renewed_Intacct_Contract__c),NOT(ISNULL(Contract.ia_crm__Intacct_Contract__c)), AND(NOT(ISNULL(Contract.ia_crm__Renewed_Intacct_Contract__c)), NOT(ISNULL(Contract.ia_crm__Synced_With_Intacct_Date__c)))), IF(Contract.ia_crm__Sync_as_Draft__c, &apos;CREATE_DRAFT_CONTRACT&apos;, IF(ISNULL(Contract.ia_crm__Intacct_Contract__c), &apos;CREATE_CONTRACT&apos;, &apos;UPDATE_CONTRACT&apos;)), &apos;SYNC_RENEWAL_CONTRACT&apos;) + &apos;&amp;recordId=&apos; + Contract.Id)}</url>
    </webLinks>
    <webLinks>
        <fullName>ia_crm__Create_Renewal_Opportunity</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <linkType>url</linkType>
        <masterLabel>Create Renewal Opportunity</masterLabel>
        <openType>replace</openType>
        <protected>false</protected>
        <url>{!URLFOR($Site.Prefix + &apos;/apex/ia_crm__ContractRenewal?id=&apos; + IF( NOT( ISNULL(Contract.ia_crm__Intacct_ContractId__c) ) , Contract.ia_crm__Intacct_ContractId__c, Contract.Id ) + &apos;&amp;object=Contract&apos;)}</url>
    </webLinks>
