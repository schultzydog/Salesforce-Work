        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <label>Exchange Rate Type</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>ia_crm__Exchange_Rate_Type__c.ia_crm__Hidden__c</field>
                <operation>notEqual</operation>
                <value>True</value>
            </filterItems>
            <isOptional>true</isOptional>
        </lookupFilter>
        <referenceTo>ia_crm__Exchange_Rate_Type__c</referenceTo>
        <relationshipLabel>Contracts</relationshipLabel>
        <relationshipName>Contracts</relationshipName>
