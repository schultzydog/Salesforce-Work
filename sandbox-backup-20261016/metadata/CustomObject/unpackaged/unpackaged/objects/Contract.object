    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>ia_crm__ContractNameRequired</fullName>
        <active>false</active>
        <description>Check if the Contract Name is empty</description>
        <errorConditionFormula>ISBLANK(Name)</errorConditionFormula>
        <errorDisplayField>Name</errorDisplayField>
        <errorMessage>You must enter a value</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ia_crm__Start_and_End_Dates_Validation</fullName>
        <active>true</active>
        <description>Start Date cannot be greater that End Date.</description>
        <errorConditionFormula>StartDate &gt;  EndDate</errorConditionFormula>
        <errorMessage>Start date must be earlier than the end date.</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>Clone</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Clone</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <url>/flow/AutomaticRenewals?OldOppId={!Opportunity.Id}&amp;retURL=/{!Opportunity.Id}</url>
    </webLinks>
    <webLinks>
        <fullName>New_Contract</fullName>
        <availability>online</availability>
        <description>Populates Account data when used on the Oppty list view</description>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <linkType>url</linkType>
        <masterLabel>New Contract</masterLabel>
        <openType>replace</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>/800/e?CF00N30000009PMZY={!Opportunity.Name}&amp;CF00N30000009PMZY_lkid={!Opportunity.Id}&amp;ctrc7={!Account.Name}&amp;ctrc7_lkid={!Account.Id}&amp;retURL=%2F{!Opportunity.Id}</url>
    </webLinks>
