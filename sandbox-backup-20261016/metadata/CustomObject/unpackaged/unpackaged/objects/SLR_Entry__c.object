    <fields>
        <fullName>Contract_Amount_OC__c</fullName>
        <externalId>false</externalId>
        <label>Contract Amount (OC)</label>
        <precision>17</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Contract_Amount_USD__c</fullName>
        <externalId>false</externalId>
        <formula>IF (NOT ISBLANK(Contract_Amount_OC__c) &amp;&amp; NOT ISNULL(Contract_Amount_OC__c) &amp;&amp; Contract_Amount_OC__c &gt; 0, Contract_Amount_OC__c  /   Opportunity__r.FX_rate__c , 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Contract Amount (USD)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Contract_Amount_validation__c</fullName>
        <externalId>false</externalId>
        <formula>IF(  ROUND(Contract_Amount_OC__c, 2) =   ROUND(Opportunity__r.Amount,2) , &apos;PASS&apos;, &apos;FAIL&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Contract Amount validation</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
