    </fields>
    <fields>
        <fullName>Validation_error_count__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Announcement_Date__c = Opportunity__r.CloseDate , 0, 1) + 
IF( TEXT( Announcement_Type__c ) = TEXT(Opportunity__r.Type) , 0, 1) +
IF(  ROUND(Contract_Amount_OC__c, 2) = ROUND(Opportunity__r.Amount,2) , 0, 1) +
IF( End_Date__c = Opportunity__r.Contract_End_Date__c , 0, 1)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Validation error count</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>SLR Entry</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Contract_Amount_OC__c</columns>
        <columns>SLR_Amount_USD__c</columns>
        <columns>Announcement_Date__c</columns>
        <columns>Announcement_Type__c</columns>
        <columns>Assessment__c</columns>
        <columns>End_Date__c</columns>
        <columns>Task_Code__c</columns>
        <columns>CURRENCY_ISO_CODE</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>Created_by_automation</fullName>
        <columns>NAME</columns>
        <columns>Announcement_Date__c</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Created_by_SLR_Automation__c</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <label>Created by automation</label>
    </listViews>
    <listViews>
        <fullName>No_Oppty</fullName>
        <columns>NAME</columns>
        <columns>Contract_Name__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Opportunity__c</field>
            <operation>equals</operation>
        </filters>
        <label>No Oppty</label>
    </listViews>
    <nameField>
        <displayFormat>SLR-{00000}</displayFormat>
        <label>SLR Line Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>SLR Entries</pluralLabel>
    <searchLayouts>
        <searchResultsAdditionalFields>Announcement_Date__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>SLR_Amount_OC__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Project_Code__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Opportunity__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Business_Line__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <startsWith>Vowel</startsWith>
    <visibility>Public</visibility>
</CustomObject>
