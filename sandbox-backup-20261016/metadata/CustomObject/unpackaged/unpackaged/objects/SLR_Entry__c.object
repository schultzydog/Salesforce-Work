    <fields>
        <fullName>Opportunity__c</fullName>
        <label>Opportunity</label>
        <referenceTo>Opportunity</referenceTo>
        <relationshipLabel>SLR Entries</relationshipLabel>
        <relationshipName>SLR_Lines</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>true</reparentableMasterDetail>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Oppty_Project_Code__c</fullName>
        <externalId>false</externalId>
        <formula>Project_Code__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Oppty Project Code</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PV_Reporting_Year__c</fullName>
        <externalId>false</externalId>
        <formula>IF( 
Opportunity__r.Contract_Start_Date__c &lt;= DATE(2018, 12,31)  &amp;&amp;  End_Date__c &gt;= DATE(2018, 12,31), &apos;2018&apos;, 
IF( 
Opportunity__r.Contract_Start_Date__c &lt;= DATE(2019, 12,31)  &amp;&amp;  End_Date__c &gt;= DATE(2019, 12,31), &apos;2019&apos;,
IF(
Opportunity__r.Contract_Start_Date__c &lt;= DATE(2020, 12,31)  &amp;&amp;  End_Date__c &gt;= DATE(2020, 12,31), &apos;2020&apos;, 
IF( 
Opportunity__r.Contract_Start_Date__c &lt;= DATE(2021, 12,31)  &amp;&amp;  End_Date__c &gt;= DATE(2021, 12,31), &apos;2021&apos;,
IF(
Opportunity__r.Contract_Start_Date__c &lt;= DATE(2022, 12,31)  &amp;&amp;  End_Date__c &gt;= DATE(2022, 12,31), &apos;2022&apos;, 
IF( 
Opportunity__r.Contract_Start_Date__c &lt;= DATE(2023, 12,31)  &amp;&amp;  End_Date__c &gt;= DATE(2023, 12,31), &apos;2023&apos;,
IF(
Opportunity__r.Contract_Start_Date__c &lt;= DATE(2024, 12,31)  &amp;&amp;  End_Date__c &gt;= DATE(2024, 12,31), &apos;2024&apos;, 
IF( 
Opportunity__r.Contract_Start_Date__c &lt;= DATE(2025, 12,31)  &amp;&amp;  End_Date__c &gt;= DATE(2025, 12,31), &apos;2025&apos;,
IF(
Opportunity__r.Contract_Start_Date__c &lt;= DATE(2026, 12,31)  &amp;&amp;  End_Date__c &gt;= DATE(2026, 12,31), &apos;2026&apos;, 
IF( 
Opportunity__r.Contract_Start_Date__c &lt;= DATE(2027, 12,31)  &amp;&amp;  End_Date__c &gt;= DATE(2027, 12,31), &apos;2027&apos;,

null))))))))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>PV Reporting Year</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Previous_Oppty_Project_Code__c</fullName>
        <externalId>false</externalId>
        <formula>Opportunity__r.Previous_Opportunity_Project_Code__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Previous Oppty Project Code</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Project_Code__c</fullName>
        <externalId>false</externalId>
        <formula>IF(  ISPICKVAL(Announcement_Type__c , &apos;Lost Business&apos;) ,  Opportunity__r.Previous_Opportunity__r.Project_Code__c , Opportunity__r.Project_Code__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Project Code</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Reason_for_manual_creation__c</fullName>
        <inlineHelpText>As we iterate toward full automation of SLR entries, we can expect the need to create manual entries to close the gaps. Please share the reason for why the entry was created manually so we use the information for refinement of SLR entry automation</inlineHelpText>
        <label>Reason for manual creation</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Recurring__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Recurring</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Renewal_Sub_type__c</fullName>
        <label>Renewal Sub-type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Flat</fullName>
                    <default>false</default>
                    <label>Flat</label>
                </value>
                <value>
                    <fullName>Upsell</fullName>
                    <default>false</default>
                    <label>Upsell</label>
                </value>
                <value>
                    <fullName>Downsell</fullName>
                    <default>false</default>
                    <label>Downsell</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
