    <fields>
        <fullName>Contract_Ends_on_12_31__c</fullName>
        <formula>End_Date__c =  Last_Day_of_Contract_End_Date_Year__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Contract Ends on 12/31</label>
