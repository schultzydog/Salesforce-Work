    <fields>
        <fullName>Net_Sales_Contribution_Category__c</fullName>
        <externalId>false</externalId>
        <formula>IF( ISPICKVAL( Revenue_Type__c, &apos;One Firm&apos;), &apos;One Firm&apos;,
IF( ISPICKVAL( Revenue_Type__c, &apos;Poll&apos;), &apos;Poll&apos;,
IF( ISPICKVAL( Revenue_Type__c, &apos;Voting&apos;), &apos;Voting&apos;, 
IF( ISPICKVAL( Announcement_Type__c , &apos;Lost Business&apos;), &apos;Loss&apos;,
IF( ISPICKVAL(Renewal_Sub_type__c, &apos;Flat&apos;), &apos;Flat Renewal&apos;,
IF( ISPICKVAL( Revenue_Type__c , &apos;Recurring&apos;) ,
IF( ISPICKVAL(Announcement_Type__c , &apos;New Sale&apos;) || ISPICKVAL(Announcement_Type__c , &apos;Trial Conversion&apos;), &apos;New Recurring&apos;,
IF( ISPICKVAL(Announcement_Type__c , &apos;Mid-Year Upsell&apos;) || ISPICKVAL(Renewal_Sub_type__c, &apos;Upsell&apos;), &apos;Upsell&apos;,
IF( ISPICKVAL(Announcement_Type__c , &apos;Mid-Year Downsell&apos;) || ISPICKVAL(Renewal_Sub_type__c, &apos;Downsell&apos;), &apos;Downsell&apos;,
null)))
,
IF( ISPICKVAL( Revenue_Type__c, &apos;Non-Recurring&apos;) || ISPICKVAL( Revenue_Type__c, &apos;Trial&apos;),&apos;Non-Recurring&apos;,

null

)))))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Net Sales Contribution Category</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
