    </fields>
    <fields>
        <fullName>Announcement_Date__c</fullName>
        <description>this field is called &apos;Date&apos; on the original SLR</description>
        <label>Announcement Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Announcement_Date_validation__c</fullName>
        <externalId>false</externalId>
        <formula>IF(  Announcement_Date__c =   Opportunity__r.CloseDate , &apos;PASS&apos;, &apos;FAIL&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Announcement Date validation</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Announcement_Type__c</fullName>
        <label>Announcement Type</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Cancellation</fullName>
                    <default>false</default>
                    <label>Cancellation</label>
                </value>
                <value>
                    <fullName>Lost Business</fullName>
                    <default>false</default>
                    <label>Lost Business</label>
                </value>
                <value>
                    <fullName>Mid-Year Downsell</fullName>
                    <default>false</default>
                    <label>Mid-Year Downsell</label>
                </value>
                <value>
                    <fullName>Mid-Year Upsell</fullName>
                    <default>false</default>
                    <label>Mid-Year Upsell</label>
                </value>
                <value>
                    <fullName>New Sale</fullName>
                    <default>false</default>
                    <label>New Sale</label>
                </value>
                <value>
                    <fullName>Renewal</fullName>
                    <default>false</default>
                    <label>Renewal</label>
                </value>
                <value>
                    <fullName>Trial Conversion</fullName>
                    <default>false</default>
                    <label>Trial Conversion</label>
                </value>
                <value>
                    <fullName>Voting</fullName>
                    <default>false</default>
                    <label>Voting</label>
                </value>
                <value>
                    <fullName>Contract Consolidation</fullName>
                    <default>false</default>
                    <label>Contract Consolidation</label>
                </value>
                <value>
                    <fullName>Trial</fullName>
                    <default>false</default>
                    <label>Trial</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Announcement_Type_validation__c</fullName>
        <externalId>false</externalId>
        <formula>IF(  TEXT( Announcement_Type__c ) =   TEXT(Opportunity__r.Type) , &apos;PASS&apos;, &apos;FAIL&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Announcement Type validation</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Annualized_Contract_Value_OC__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(   Opportunity__r.RevenueType__c  ,&apos;Recurring&apos;), 12 *  Average_Month_OC__c , 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Annualized Contract Value (OC)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Annualized_Contract_Value_USD__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL( Opportunity__r.RevenueType__c,&apos;Recurring&apos;), 12 * Average_Month_USD__c , 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Annualized Contract Value (USD)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Annualized_Recurring_Amount_USD__c</fullName>
        <externalId>false</externalId>
        <label>Annualized Recurring Amount (USD)</label>
        <precision>10</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Assessment__c</fullName>
        <label>Assessment</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Average_Month_OC__c</fullName>
        <externalId>false</externalId>
        <formula>Contract_Amount_OC__c  / Round(IF((  End_Date__c - Opportunity__r.Contract_Start_Date__c ) / 365.25 * 12 &lt; 1, 1, (End_Date__c -  Opportunity__r.Contract_Start_Date__c ) / 365.25 * 12), 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Average $/Month (OC)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Average_Month_USD__c</fullName>
        <externalId>false</externalId>
        <formula>Contract_Amount_USD__c/ Round(IF(( End_Date__c - Opportunity__r.Contract_Start_Date__c ) / 365 * 12 &lt; 1, 1, (End_Date__c - Opportunity__r.Contract_Start_Date__c) / 365 * 12), 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Average $/Month (USD)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
