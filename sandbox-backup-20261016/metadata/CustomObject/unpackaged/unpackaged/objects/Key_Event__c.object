    <fields>
        <fullName>Assessment_vs_key_analytic_assumptions__c</fullName>
        <label>Assessment vs key analytic assumptions</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Consistency</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Category__c</fullName>
        <label>Category</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Political_Risk_Category</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Date_Text__c</fullName>
        <externalId>false</externalId>
        <label>Date Text</label>
        <length>50</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Date__c</fullName>
        <label>Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Event__c</fullName>
        <label>Event</label>
        <length>2500</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>External_Id__c</fullName>
        <caseSensitive>false</caseSensitive>
        <externalId>true</externalId>
        <label>External Id</label>
        <length>255</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Probable_impact_on_risk_negative_higher__c</fullName>
        <label>Probable impact on risk (negative=higher</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Directional_Change</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Regional_Analysis__c</fullName>
        <label>Regional Analysis</label>
        <referenceTo>Regional_Analysis__c</referenceTo>
        <relationshipLabel>Key Events</relationshipLabel>
        <relationshipName>Key_Events</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Risk_Score__c</fullName>
        <externalId>false</externalId>
        <formula>CASE( Probable_impact_on_risk_negative_higher__c ,
  &quot;Significantly negative&quot;, -1.5,
  &quot;Negative&quot;, -1,
  &quot;Neutral&quot;, 0,
  &quot;Positive&quot;, 1,
  &quot;Significantly positive&quot;, 1.5,
0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Risk Score</label>
        <precision>18</precision>
        <required>false</required>
        <scale>1</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Sort_Order__c</fullName>
        <externalId>false</externalId>
        <label>Sort Order</label>
        <precision>2</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Key Event</label>
    <listViews>
        <fullName>All_Events</fullName>
        <columns>Date__c</columns>
        <columns>NAME</columns>
        <columns>Regional_Analysis__c</columns>
        <columns>Category__c</columns>
        <columns>Probable_impact_on_risk_negative_higher__c</columns>
        <columns>Risk_Score__c</columns>
        <filterScope>Everything</filterScope>
        <label>All Events</label>
    </listViews>
    <nameField>
        <displayFormat>KE-{0000}</displayFormat>
        <label>Key Event</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Key Events</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
