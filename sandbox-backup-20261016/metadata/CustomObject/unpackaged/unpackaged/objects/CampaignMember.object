    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>CampaignId</fullName>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>City</fullName>
    </fields>
    <fields>
        <fullName>CompanyOrAccount</fullName>
    </fields>
    <fields>
        <fullName>Company__c</fullName>
        <externalId>false</externalId>
        <formula>IF(NOT(ISBLANK(ContactId)),

 Contact.Account.Name,

 Lead.Company

)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Company</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ContactId</fullName>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>ContactTagConcat__c</fullName>
        <externalId>false</externalId>
        <formula>CASESAFEID(ContactId) &amp;  CASESAFEID(Campaign.Tag__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>ContactTagConcat</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Country</fullName>
    </fields>
    <fields>
        <fullName>Description</fullName>
    </fields>
    <fields>
        <fullName>DoNotCall</fullName>
    </fields>
    <fields>
        <fullName>Email</fullName>
    </fields>
    <fields>
        <fullName>Fax</fullName>
    </fields>
    <fields>
        <fullName>FirstName</fullName>
    </fields>
    <fields>
        <fullName>FirstRespondedDate</fullName>
    </fields>
    <fields>
        <fullName>Flag_for_Deletion__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Flag for Deletion</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>HasOptedOutOfEmail</fullName>
    </fields>
    <fields>
        <fullName>HasOptedOutOfFax</fullName>
    </fields>
    <fields>
        <fullName>HasResponded</fullName>
    </fields>
    <fields>
        <fullName>LastName</fullName>
    </fields>
    <fields>
        <fullName>LeadId</fullName>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>LeadSource</fullName>
        <type>Picklist</type>
    </fields>
    <fields>
        <fullName>MobilePhone</fullName>
    </fields>
    <fields>
        <fullName>Phone</fullName>
    </fields>
    <fields>
        <fullName>PostalCode</fullName>
    </fields>
    <fields>
        <fullName>Related_to_Library_Campaigns__c</fullName>
        <formula>IF(ISBLANK( Campaign.Tag__c ), FALSE, TRUE)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Related to Library Campaigns</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Salutation</fullName>
        <type>Picklist</type>
    </fields>
    <fields>
        <fullName>State</fullName>
    </fields>
    <fields>
        <fullName>Status</fullName>
        <type>Picklist</type>
    </fields>
    <fields>
        <fullName>Street</fullName>
    </fields>
    <fields>
        <fullName>Title</fullName>
    </fields>
    <fields>
        <fullName>ZOFU__Created_by_ZFusion__c</fullName>
        <deprecated>false</deprecated>
        <formula>IF( AND( ContactId &lt;&gt;NULL, Contact.ZOFU__Created_by_Zoom_Fusion__c =TRUE) , Contact.CreatedDate , IF( AND(LeadId &lt;&gt;NULL, Lead.ZOFU__Created_by_Zoom_Fusion__c =TRUE), Lead.CreatedDate , NULL) )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Created by ZFusion</label>
        <required>false</required>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>ZOFU__Zoom_Joined__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <label>Zoom Joined</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>ZOFU__Zoom_Registration__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <label>Zoom Registration</label>
        <referenceTo>ZOFU__Zoom_Webinar_Registration__c</referenceTo>
        <relationshipLabel>Campaign Members</relationshipLabel>
        <relationshipName>Campaign_Members</relationshipName>
        <required>false</required>
        <type>Lookup</type>
    </fields>
    <sharingModel>ControlledByCampaign</sharingModel>
</CustomObject>
