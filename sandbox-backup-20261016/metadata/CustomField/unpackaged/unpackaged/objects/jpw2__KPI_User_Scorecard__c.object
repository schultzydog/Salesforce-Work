Total_Activities_by_Acct_Owner_REPORT__c
 &amp;&quot;/view&quot; &amp; &quot;?fv0=&quot;&amp;  jpw2__User_Name_Filter__c  ,&quot; &quot;&amp;
IMAGE(&quot;/resource/jpw2__AdoptionAppIcons/AdoptionAppIcons/report1.svg&quot;,&quot;Link&quot;,15,17), &apos;_self&apos;))</formula>
