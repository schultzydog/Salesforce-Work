    <fields>
        <fullName>Other_Key_Metrics_Category_ICON__c</fullName>
        <externalId>false</externalId>
        <formula>IF (Other_Key_Metrics_Category_SCORE__c=0,&quot;No Metrics Selected&quot;,
IF(ISNULL(Other_Key_Metrics_Category_SCORE__c),&quot;No Metrics Selected&quot;,
IF
( Other_Key_Metrics_Category_SCORE__c =1,
&quot;1.00&quot; &amp;&quot; &quot;
&amp; IMAGE(&quot;/resource/jpw2__AdoptionAppIcons/AdoptionAppIcons/Red_1.png&quot;,TEXT(Other_Key_Metrics_Category_SCORE__c) ,15,(3))
&amp; IMAGE(&quot;/resource/jpw2__AdoptionAppIcons/AdoptionAppIcons/Gray_0.png&quot;,&quot;&quot;,15,(67)),

IF( Other_Key_Metrics_Category_SCORE__c =2,
&quot;2.00&quot; &amp;&quot; &quot;
&amp; IMAGE(&quot;/resource/jpw2__AdoptionAppIcons/AdoptionAppIcons/Yellow_2.png&quot;,TEXT(Other_Key_Metrics_Category_SCORE__c) ,15,(35))
&amp; IMAGE(&quot;/resource/jpw2__AdoptionAppIcons/AdoptionAppIcons/Gray_0.png&quot;,&quot;&quot;,15,(35)),

IF( Other_Key_Metrics_Category_SCORE__c =3,
&quot;3.00&quot; &amp;&quot; &quot;
&amp; IMAGE(&quot;/resource/jpw2__AdoptionAppIcons/AdoptionAppIcons/Green_3.png&quot;,TEXT(Other_Key_Metrics_Category_SCORE__c) ,15,(70)),

IF( Other_Key_Metrics_Category_SCORE__c &gt;= $CustomMetadata.jpw2__KPI_Category_Color_Thresholds__mdt.jpw2__Category_Threshold_Colors.jpw2__Green_Threshold__c,
RPAD(TEXT(Other_Key_Metrics_Category_SCORE__c),4,&quot;0&quot;) &amp;&quot; &quot;
&amp; IMAGE(&quot;/resource/jpw2__AdoptionAppIcons/AdoptionAppIcons/Green_3.png&quot;,TEXT(Other_Key_Metrics_Category_SCORE__c) ,15,((Other_Key_Metrics_Category_SCORE__c-1)*35))
&amp; IMAGE(&quot;/resource/jpw2__AdoptionAppIcons/AdoptionAppIcons/Gray_0.png&quot;,&quot;&quot;,15,((2-(Other_Key_Metrics_Category_SCORE__c-1))*35)),

IF( Other_Key_Metrics_Category_SCORE__c &lt; $CustomMetadata.jpw2__KPI_Category_Color_Thresholds__mdt.jpw2__Category_Threshold_Colors.jpw2__Red_Threshold1__c,
RPAD(TEXT(Other_Key_Metrics_Category_SCORE__c),4,&quot;0&quot;) &amp;&quot; &quot;
&amp; IMAGE(&quot;/resource/jpw2__AdoptionAppIcons/AdoptionAppIcons/Red_1.png&quot;,TEXT(Other_Key_Metrics_Category_SCORE__c) ,15,((Other_Key_Metrics_Category_SCORE__c-1)*35))
&amp; IMAGE(&quot;/resource/jpw2__AdoptionAppIcons/AdoptionAppIcons/Gray_0.png&quot;,&quot;&quot;,15,((2-(Other_Key_Metrics_Category_SCORE__c-1))*35)),


RPAD(TEXT(Other_Key_Metrics_Category_SCORE__c),4,&quot;0&quot;) &amp;&quot; &quot;
&amp; IMAGE(&quot;/resource/jpw2__AdoptionAppIcons/AdoptionAppIcons/Yellow_2.png&quot;,TEXT(Other_Key_Metrics_Category_SCORE__c) ,15,((Other_Key_Metrics_Category_SCORE__c-1)*35))
&amp; IMAGE(&quot;/resource/jpw2__AdoptionAppIcons/AdoptionAppIcons/Gray_0.png&quot;,&quot;&quot;,15,((2-(Other_Key_Metrics_Category_SCORE__c-1))*35)))))))))&amp;

IF(ISNULL(Other_Key_Metrics_Category_SCORE__c),&quot;&quot;,

HYPERLINK( &quot;/lightning/r/Report/&quot; &amp; Other_Key_Metrics_Category_REPORT__c &amp;&quot;/view&quot; &amp; &quot;?fv0=&quot;&amp; jpw2__User__r.Id ,&quot; &quot;&amp;IMAGE(&quot;/resource/jpw2__AdoptionAppIcons/AdoptionAppIcons/report1.svg&quot;,&quot;more&quot;,15,17) , &apos;_self&apos;))</formula>
