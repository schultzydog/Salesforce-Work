        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>UpSell_DownSell_Amount_OC__c</fullName>
        <externalId>false</externalId>
        <formula>New_Contract_Value_OC__c  -  Original_Contract_Amount_OC__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>UpSell/DownSell Amount (OC)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>UpSell_DownSell_Amount_Value_USD__c</fullName>
        <externalId>false</externalId>
        <formula>UpSell_DownSell_Amount_OC__c / Opportunity__r.FX_rate__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>UpSell/DownSell Amount (USD)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
