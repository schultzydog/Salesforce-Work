    <fields>
        <fullName>Pre_Adjustment_Annualized_Value_OC__c</fullName>
        <externalId>false</externalId>
        <formula>IF( ISPICKVAL( Opportunity__r.RevenueType__c,&apos;Recurring&apos;) , Pre_Adjustment_AverageRevenuePerMonth_OC__c  * 12, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Pre-Adjustment Annualized Value (OC)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Pre_Adjustment_AverageRevenuePerMonth_OC__c</fullName>
        <externalId>false</externalId>
        <formula>Original_Contract_Amount_OC__c / Round(IF(( Original_End_Date__c -  Original_Start_Date__c ) / 365 * 12 &lt; 1, 1, (Original_End_Date__c - Original_Start_Date__c ) / 365 * 12), 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Pre-Adjustment Average $/Month (OC)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
