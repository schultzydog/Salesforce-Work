<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>Account__c</fullName>
        <externalId>false</externalId>
        <formula>Opportunity__r.Account.Name</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Annualized_Upsell_Downsell_Amount_OC__c</fullName>
        <externalId>false</externalId>
        <formula>IF( ISPICKVAL( Opportunity__r.RevenueType__c,&apos;Recurring&apos;) , New_Annualized_Value_OC__c -  Pre_Adjustment_Annualized_Value_OC__c, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Annualized Upsell/Downsell Amount (OC)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Annualized_Upsell_Downsell_Amount_USD__c</fullName>
        <externalId>false</externalId>
        <formula>Annualized_Upsell_Downsell_Amount_OC__c /  Opportunity__r.FX_rate__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Annualized Upsell/Downsell Amount (USD)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Approval_Date__c</fullName>
        <label>Approval Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Approval_Status__c</fullName>
        <label>Approval Status</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Approval_Status</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Average_Month_OC__c</fullName>
        <externalId>false</externalId>
        <formula>New_Contract_Value_OC__c / Round(IF(( New_End_Date__c -  New_Start_Date__c ) / 365 * 12 &lt; 1, 1, (New_End_Date__c - New_Start_Date__c ) / 365 * 12), 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Average $/Month (OC)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Contract_Adjustment_Reason__c</fullName>
        <label>Contract Adjustment Reason</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Voting</fullName>
                    <default>false</default>
                    <label>Voting</label>
                </value>
                <value>
                    <fullName>Cancellation</fullName>
                    <default>false</default>
                    <label>Cancellation</label>
                </value>
                <value>
                    <fullName>Flat Extension</fullName>
                    <default>false</default>
                    <label>Flat Extension</label>
                </value>
                <value>
                    <fullName>Mid-Year Upsell</fullName>
                    <default>false</default>
                    <label>Mid-Year Upsell</label>
                </value>
                <value>
                    <fullName>Mid-Year Downsell</fullName>
                    <default>false</default>
                    <label>Mid-Year Downsell</label>
                </value>
                <value>
                    <fullName>No Cost Extension</fullName>
                    <default>false</default>
                    <label>No Cost Extension (-)</label>
                </value>
                <value>
                    <fullName>Correction</fullName>
                    <default>false</default>
                    <label>Correction</label>
                </value>
                <value>
                    <fullName>Contract Consolidation</fullName>
                    <default>false</default>
                    <label>Contract Consolidation</label>
                </value>
                <value>
                    <fullName>Subcontractor Costs</fullName>
                    <default>false</default>
                    <label>Subcontractor Costs</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>New_Annualized_Value_OC__c</fullName>
        <externalId>false</externalId>
        <formula>IF( ISPICKVAL( Opportunity__r.RevenueType__c,&apos;Recurring&apos;) , Average_Month_OC__c  * 12, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>New Annualized Value (OC)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
