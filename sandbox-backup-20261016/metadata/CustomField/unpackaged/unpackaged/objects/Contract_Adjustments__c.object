    <fields>
        <fullName>Project_Code__c</fullName>
        <externalId>false</externalId>
        <formula>Opportunity__r.Project_Code__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Project Code</label>
