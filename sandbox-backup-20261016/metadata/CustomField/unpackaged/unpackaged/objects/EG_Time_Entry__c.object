    <fields>
        <fullName>Time_Entry_Source__c</fullName>
        <description>Where this time entry was created. Stamp on insert only; later edits from another source must not overwrite it.</description>
        <inlineHelpText>How this time entry was originally created. Blank on records that predate the field.</inlineHelpText>
        <label>Time Entry Source</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Automation</fullName>
                    <default>false</default>
                    <label>Automation</label>
                </value>
                <value>
                    <fullName>Outlook_Panel</fullName>
                    <default>false</default>
                    <label>Outlook Panel</label>
                </value>
                <value>
                    <fullName>Event_Review_Page</fullName>
                    <default>false</default>
                    <label>Event Review Page</label>
                </value>
                <value>
                    <fullName>Timesheet</fullName>
                    <default>false</default>
                    <label>Timesheet</label>
                </value>
                <value>
                    <fullName>Outlook_Review_Panel</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Outlook Review Panel</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
