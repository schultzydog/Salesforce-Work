    <fields>
        <fullName>Start_Time__c</fullName>
        <description>Start time of the meeting this entry logs, taken from Event.StartDateTime. Date__c remains the authoritative date and is what resolves the weekly time card; this field only distinguishes two meetings on the same project, task and day so each can hold its own entry. Left blank on entries typed straight into the timesheet, which have no meeting and stay at one row per project, task and day.</description>
        <label>Start Time</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Time</type>
    </fields>
