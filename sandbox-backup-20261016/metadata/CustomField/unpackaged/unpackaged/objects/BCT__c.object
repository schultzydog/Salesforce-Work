    <fields>
        <fullName>Likelihooddep__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISNULL(Likelihood_of_approval__c), null,

IF(Likelihood_of_approval__c==1,
&apos;Approved&apos;,
TEXT(Likelihood_of_approval__c*100) + &apos;%&apos;

))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Likelihood (text)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
