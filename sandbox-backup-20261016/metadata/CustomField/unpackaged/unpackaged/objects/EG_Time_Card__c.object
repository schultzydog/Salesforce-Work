        <fullName>Location_Completion__c</fullName>
        <formula>(Location_Monday_Counter__c  + Location_Tuesday_Counter__c  + Location_Wednesday_Counter__c + Location_Thursday_Counter__c + Location_Friday_Counter__c)/5</formula>
