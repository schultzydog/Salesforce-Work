        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Percent_Research_Writing_Hours__c</fullName>
        <formula>IF(Hours_Worked__c &gt; 0, Research_Writing_hours__c /  Hours_Worked__c, null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>% Research/Writing Hours</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Remote__c</fullName>
        <formula>Owner:User.Remote__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Remote</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Research_Writing_hours__c</fullName>
        <label>Research/Writing Hours</label>
        <summarizedField>EG_Time_Entry__c.Hours_Worked__c</summarizedField>
        <summaryFilterItems>
            <field>EG_Time_Entry__c.Time_Category__c</field>
            <operation>equals</operation>
            <value>Research/Writing</value>
        </summaryFilterItems>
        <summaryFilterItems>
            <field>EG_Time_Entry__c.Hours_Worked__c</field>
            <operation>greaterThan</operation>
            <value>0</value>
        </summaryFilterItems>
        <summaryForeignKey>EG_Time_Entry__c.EG_Time_Card__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Staff_Class__c</fullName>
        <externalId>false</externalId>
        <formula>Text(Owner:User.Staff_Class__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Staff Class</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Start_Date__c</fullName>
        <label>Week Commencing</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
