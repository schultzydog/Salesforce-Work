        <externalId>true</externalId>
        <label>TimeCardExternalId</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Timesheets_Required__c</fullName>
        <formula>Owner:User.Timesheet_Required__c &amp;&amp;  Owner:User.IsActive</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
