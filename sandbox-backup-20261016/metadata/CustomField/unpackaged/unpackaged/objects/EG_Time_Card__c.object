    <fields>
        <fullName>Location_Complete_Ratio__c</fullName>
        <externalId>false</externalId>
        <formula>CASE(  Location_Completion__c ,
0,&apos;0/5&apos;,
20,&apos;1/5&apos;,
40,&apos;2/5&apos;,
60,&apos;3/5&apos;,
80,&apos;4/5&apos;,
100, &apos;5/5&apos;,

null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Location Complete Ratio</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Location_Complete__c</fullName>
        <externalId>false</externalId>
        <formula>IF( 
ISBLANK(TEXT(Location_Monday__c)) ||
ISBLANK(TEXT(Location_Tuesday__c))||
ISBLANK(TEXT(Location_Wednesday__c))|| 
ISBLANK(TEXT(Location_Thursday__c))|| 
ISBLANK(TEXT(Location_Friday__c))
, &apos;No&apos;, &apos;Yes&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Location Complete</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
