    <fields>
        <fullName>Complete__c</fullName>
        <formula>IF( Hours_Worked__c  &gt;=  40, 1, Hours_Worked__c/40)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>% Complete</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Compliance_Status__c</fullName>
        <externalId>false</externalId>
        <formula>IF(NOT(Does_not_require_FT_timesheet__c) &amp;&amp;  Hours_Worked__c &lt; 10, IMAGE(&quot;https://eurasiagroup.file.force.com/servlet/servlet.ImageServer?id=0154V000005RYL4&amp;oid=00DWL00000BtPgz&amp;lastMod=1656446538000&quot;, &quot;red&quot;),

IF( NOT(Does_not_require_FT_timesheet__c) &amp;&amp; Hours_Worked__c &lt; 40, IMAGE(&quot;https://eurasiagroup.file.force.com/servlet/servlet.ImageServer?id=0154V000005RYL9&amp;oid=00DWL00000BtPgz&amp;lastMod=1656446525000&quot;, &quot;orange&quot;),

IF(NOT(Does_not_require_FT_timesheet__c) &amp;&amp;  Hours_Worked__c &gt;= 40 , IMAGE(&quot;https://eurasiagroup.file.force.com/servlet/servlet.ImageServer?id=0154V000005RYLY&amp;oid=00DWL00000BtPgz&amp;lastMod=1656446470000&quot;, &quot;green&quot;),


null)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Compliance Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Count_of_Excused_Offsite_Event__c</fullName>
        <externalId>false</externalId>
        <formula>IF(TEXT( Location_Monday__c) = &apos;Excused - Offsite / Event&apos;, 1, 0) + 
IF(TEXT( Location_Tuesday__c ) = &apos;Excused - Offsite / Event&apos;, 1, 0) +
IF(TEXT( Location_Wednesday__c ) = &apos;Excused - Offsite / Event&apos;, 1, 0) +
IF(TEXT( Location_Thursday__c ) = &apos;Excused - Offsite / Event&apos;, 1, 0) +
IF(TEXT( Location_Friday__c ) = &apos;Excused - Offsite / Event&apos;, 1, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
