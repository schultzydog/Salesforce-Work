    <fields>
        <fullName>Delete_due_to_age_of_disablement__c</fullName>
        <formula>ISPICKVAL(Contact__r.Status__c, &apos;Disabled&apos;) &amp;&amp;  today() -datevalue(Contact__r.Latest_Status_Disablement_date__c) &gt; 120</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Delete due to age of disablement</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Delivery_Type__c</fullName>
        <externalId>false</externalId>
        <formula>IF(Summary_Emails__c &amp;&amp; !Individual_Emails__c, &apos;Summary Only&apos;, 
IF(!Summary_Emails__c &amp;&amp; Individual_Emails__c, &apos;Individual Only&apos;,
IF(Summary_Emails__c &amp;&amp; Individual_Emails__c, &apos;Both&apos;, null)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Delivery Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
