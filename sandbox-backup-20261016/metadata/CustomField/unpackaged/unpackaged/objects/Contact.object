    <fields>
        <fullName>Send_new_user_survey__c</fullName>
        <description>This field is used in the New User Survey engagement studio flow in pardot</description>
        <formula>ISPICKVAL(Status__c  , &apos;Enabled&apos;)  &amp;&amp;
 Worldflow_Email_Access__c = TRUE &amp;&amp;
 Worldflow_Portal_Access__c = TRUE &amp;&amp;
 Opt_out_of_New_User_Survey__c = FALSE &amp;&amp;
  ISBLANK(New_User_Survey_Submission_Date__c ) &amp;&amp;
ISBLANK(New_User_Survey_Sent_Date__c) &amp;&amp;
 ISPICKVAL(Account.Type , &apos;Client&apos;) &amp;&amp;
(Today()- DATEVALUE(Latest_Status_Enablement_date__c) &gt; 42   ||  
(Today()- DATEVALUE(CreatedDate) &lt; 180 &amp;&amp; Today()- DATEVALUE(CreatedDate) &gt; 50))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Send new user survey</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
