        <formula>DateValue( EG_Event__r.Event_Start_Time__c ) &gt; TODAY() - 730 &amp;&amp;
DateValue( EG_Event__r.Event_Start_Time__c ) &lt; TODAY() - 365</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
