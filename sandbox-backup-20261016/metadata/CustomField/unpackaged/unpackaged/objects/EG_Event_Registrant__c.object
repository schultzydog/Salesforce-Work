    <fields>
        <fullName>Registrant_Level__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
  OR(
    CONTAINS(UPPER(Title__c), &quot;CHIEF&quot;),
    CONTAINS(UPPER(Title__c), &quot;CEO&quot;),
    CONTAINS(UPPER(Title__c), &quot;CFO&quot;),
    CONTAINS(UPPER(Title__c), &quot;COO&quot;),
    CONTAINS(UPPER(Title__c), &quot;CIO&quot;),
    CONTAINS(UPPER(Title__c), &quot;CTO&quot;),
    CONTAINS(UPPER(Title__c), &quot;CISO&quot;),
    CONTAINS(UPPER(Title__c), &quot;CHRO&quot;),
    CONTAINS(UPPER(Title__c), &quot;PRESIDENT&quot;)
  ),
  &quot;C-suite&quot;,
  IF(
    OR(
      CONTAINS(UPPER(Title__c), &quot;EVP&quot;),
      CONTAINS(UPPER(Title__c), &quot;EXECUTIVE VICE PRESIDENT&quot;),
      CONTAINS(UPPER(Title__c), &quot;SVP&quot;),
      CONTAINS(UPPER(Title__c), &quot;SENIOR VICE PRESIDENT&quot;),
      CONTAINS(UPPER(Title__c), &quot;VP&quot;),
      CONTAINS(UPPER(Title__c), &quot;VICE PRESIDENT&quot;),
      CONTAINS(UPPER(Title__c), &quot;HEAD&quot;),
      CONTAINS(UPPER(Title__c), &quot;BOARD&quot;),
CONTAINS(UPPER(Title__c), &quot;MD&quot;),
      CONTAINS(UPPER(Title__c), &quot;MANAGING DIRECTOR&quot;),
      CONTAINS(UPPER(Title__c), &quot;PARTNER&quot;)
    ),
    &quot;Senior Leader&quot;,
    IF(
      OR(
        CONTAINS(UPPER(Title__c), &quot;DIRECTOR&quot;),
        CONTAINS(UPPER(Title__c), &quot;MANAGER&quot;),
CONTAINS(UPPER(Title__c), &quot;PM&quot;),
        CONTAINS(UPPER(Title__c), &quot;LEAD&quot;),
        CONTAINS(UPPER(Title__c), &quot;COUNSEL&quot;),
        CONTAINS(UPPER(Title__c), &quot;ANALYST&quot;),
CONTAINS(UPPER(Title__c), &quot;ASSOCIATE&quot;),
        CONTAINS(UPPER(Title__c), &quot;SPECIALIST&quot;),
        CONTAINS(UPPER(Title__c), &quot;COORDINATOR&quot;)
      ),
      &quot;Working-Level&quot;,
      &quot;&quot;
    )
  )
)</formula>
        <label>Registrant Level</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
