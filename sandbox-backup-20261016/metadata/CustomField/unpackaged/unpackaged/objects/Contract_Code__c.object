        <type>Date</type>
    </fields>
    <fields>
        <fullName>Contract_Code_Tenure__c</fullName>
        <externalId>false</externalId>
        <formula>( Active_Contract_End_Date__c -  Contract_Code_Start_Date__c ) / 365</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Tenure is the number of years (to the nearest tenth) from the first Project Code&apos;s Contract Start Date to the Contract End Date of the currently Active contract, or the last active contract if there is no current contract.</inlineHelpText>
        <label>Contract Code Tenure</label>
        <precision>18</precision>
        <required>false</required>
        <scale>1</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Contract_Code__c</fullName>
        <caseSensitive>false</caseSensitive>
        <externalId>true</externalId>
        <label>Contract Code</label>
        <length>20</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
