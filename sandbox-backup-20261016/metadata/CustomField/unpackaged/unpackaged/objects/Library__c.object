    <fields>
        <fullName>Quant_Product__c</fullName>
        <formula>IF( CONTAINS(SortName__c, &apos;Global Navigator&apos;)||CONTAINS(SortName__c, &apos;Country Portfolio&apos;) ||CONTAINS(SortName__c, &apos;GPRI&apos;),true, false )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Quant Product</label>
        <trackHistory>false</trackHistory>
