<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>Analyst_Access__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Analyst Access</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Assessment__c</fullName>
        <label>Assessment</label>
        <length>1000</length>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Automate_Entitlement_Creation__c</fullName>
        <formula>PricebookEntry.Product2.Automate_Entitlement_Creation__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Automate Entitlement Creation</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Bill_To_Intacct_Contact_Id__c</fullName>
        <externalId>false</externalId>
        <formula>Bill_To__r.ia_crm__Intacct_Contact_ID__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Bill To Intacct Contact Id</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Bill_To__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Bill To</label>
        <referenceTo>Contact</referenceTo>
        <relationshipLabel>Opportunity Product (Bill To)</relationshipLabel>
        <relationshipName>Opportunity_Product</relationshipName>
        <required>false</required>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Business_Line__c</fullName>
        <label>Product Business Line</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Business_Line</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Contract_Active__c</fullName>
        <formula>Opportunity.Contract_Active__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Contract Active</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Contract_Type__c</fullName>
        <description>R - Recurring
S - Speaking
V - Voting
N - No-recurring
T - Trial
L  - Loss</description>
        <inlineHelpText>R - Recurring
S - Speaking
V - Voting
N - No-recurring
T - Trial
L  - Loss</inlineHelpText>
        <label>Contract Type</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>R</fullName>
                    <default>false</default>
                    <label>R</label>
                </value>
                <value>
                    <fullName>S</fullName>
                    <default>false</default>
                    <label>S</label>
                </value>
                <value>
                    <fullName>V</fullName>
                    <default>false</default>
                    <label>V</label>
                </value>
                <value>
                    <fullName>N</fullName>
                    <default>false</default>
                    <label>N</label>
                </value>
                <value>
                    <fullName>T</fullName>
                    <default>false</default>
                    <label>T</label>
                </value>
                <value>
                    <fullName>L</fullName>
                    <default>false</default>
                    <label>L</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Contract__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Contract</label>
        <referenceTo>Contract</referenceTo>
        <relationshipLabel>Opportunity Product</relationshipLabel>
        <relationshipName>Opportunity_Product</relationshipName>
        <required>false</required>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Created_for_slr_retirement__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Created for slr retirement</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Dept_Code_formula__c</fullName>
        <externalId>false</externalId>
        <formula>IF( ISPICKVAL( Business_Line__c , &apos;Global Markets&apos;) , 

 CASE(  Opportunity.Geography__c , 
&apos;North America&apos;, &apos;315&apos;, 
&apos;EMEA&apos;, &apos;311&apos;,
&apos;Japan&apos;, &apos;312&apos;,
&apos;Brazil&apos;, &apos;314&apos;,
&apos;Asia ex-Japan&apos;, &apos;313&apos;,
&apos;LatAm ex-Brazil&apos;, &apos;314&apos;,
&apos;N/A&apos;) , 

 IF(ISPICKVAL(Business_Line__c, &apos;Corporate&apos;), 

 CASE(Opportunity.Corporate_Sector_Team__c , 
&apos;Energy, Climate, Resources (ECR)&apos;, &apos;321&apos;, 
&apos;Aerospace &amp; Defense&apos;, &apos;361&apos;,
&apos;Professional Services, Philanthropy &amp; Non-Profit, Public Sector (PPP)&apos;, &apos;329&apos;,
&apos;Healthcare&apos;, &apos;323&apos;,
&apos;Consumer &amp; Retail (C&amp;R)&apos;, &apos;325&apos;,
&apos;Geotech&apos;, &apos;326&apos;,
&apos;Other&apos;, &apos;320&apos;,
&apos;Global Sustainability&apos;, &apos;363&apos;, 
&apos;Financial Institutions Group (FIG)&apos;, &apos;322&apos;,
&apos;Trade &amp; Supply Chains&apos;, &apos;324&apos;,
&apos;N/A&apos;) ,  

 IF(ISPICKVAL(Business_Line__c, &apos;OOP&apos;), &apos;407&apos;, 
 IF(ISPICKVAL(Business_Line__c, &apos;GZERO&apos;), &apos;411&apos;,  

&apos;N/A&apos;))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Dept Code formula</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Entitlement_Specifics__c</fullName>
        <label>Entitlement Specifics</label>
        <required>false</required>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Entitlement_Specifics</valueSetName>
        </valueSet>
        <visibleLines>10</visibleLines>
    </fields>
    <fields>
        <fullName>GL_Posting_Date__c</fullName>
        <label>GL Posting Date</label>
        <required>false</required>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>GL_SubAccount__c</fullName>
        <label>GL SubAccount</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Department_Codes</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Has_Product_Libraries__c</fullName>
        <formula>PricebookEntry.Product2.Has_Product_Libraries__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Has Product Libraries</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Ian_speaking__c</fullName>
        <formula>CONTAINS( Product_Name__c , &apos;Ian Bremmer - In-Person&apos;) ||  CONTAINS( Product_Name__c , &apos;Ian Bremmer - Virtual&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Ian speaking</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Include_in_Top_30__c</fullName>
        <formula>Opportunity.IsWon &amp;&amp;
Opportunity.Account.Name != &apos;WNET&apos; &amp;&amp;
Opportunity.Account.Name != &apos;Washington Speakers Bureau&apos; &amp;&amp;

( (NOT(ISPICKVAL( Revenue_Type__c , &apos;Recurring&apos;)) &amp;&amp; ( Opportunity.Contract_Start_Date__c &gt; Today() - 365 &amp;&amp; Opportunity.Contract_Start_Date__c &lt; Today() +1) )

||

(( NOT ISBLANK(Opportunity.Renewal_Opportunity__c) &amp;&amp; Opportunity.Renewal_Opportunity_Open__c = TRUE &amp;&amp; ISPICKVAL(Opportunity.Contract_Status__c, &apos;Expired&apos;) || Opportunity.Contract_Active__c ) ))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Include in Top 30</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>IsActive__c</fullName>
        <formula>PricebookEntry.IsActive</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>IsActive?</label>
        <type>Checkbox</type>
    </fields>
