    </fields>
    <fields>
        <fullName>Ready_for_Contract_creation__c</fullName>
        <formula>NOT ISBLANK( ia_crm__Billing_Template__c ) &amp;&amp;
NOT ISBLANK(TEXT(  ia_crm__Contract_Line_Save_Cancel_He__c )) &amp;&amp;
NOT ISBLANK(  ia_crm__Intacct_Location__c ) &amp;&amp;
NOT ISBLANK(   ia_crm__Class__c ) &amp;&amp;
NOT ISBLANK(TEXT(  ia_crm__Billing_Method__c )) &amp;&amp;
NOT ISBLANK(  ia_crm__Department__c) &amp;&amp;
PricebookEntry.Product2.IsActive</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Product ready for Contract creation</label>
        <type>Checkbox</type>
    </fields>
