    <fields>
        <fullName>Risk_Color_Domestic_Stability__c</fullName>
        <externalId>false</externalId>
        <formula>IF(Risk_Score_Domestic_Stability__c&gt;=5.0, &quot;#638C1C&quot;, /* darkest green */
IF(Risk_Score_Domestic_Stability__c&gt;=4.5, &quot;#70972C&quot;,
IF(Risk_Score_Domestic_Stability__c&gt;=4.0, &quot;#7EA23C&quot;,
IF(Risk_Score_Domestic_Stability__c&gt;=3.5, &quot;#8BAE4C&quot;,
IF(Risk_Score_Domestic_Stability__c&gt;=3.0, &quot;#99B95C&quot;,
IF(Risk_Score_Domestic_Stability__c&gt;=2.5, &quot;#A6C46C&quot;,
IF(Risk_Score_Domestic_Stability__c&gt;=2.0, &quot;#B4D07D&quot;,
IF(Risk_Score_Domestic_Stability__c&gt;=1.5, &quot;#C1DB8D&quot;,
IF(Risk_Score_Domestic_Stability__c&gt;=1.0, &quot;#CFE79D&quot;,
IF(Risk_Score_Domestic_Stability__c&gt;=0.5, &quot;#DCF2AD&quot;, /* lightest green */

IF(Risk_Score_Domestic_Stability__c&lt;=-5.0, &quot;#C10230&quot;, /* darkest red */
IF(Risk_Score_Domestic_Stability__c&lt;=-4.5, &quot;#C71842&quot;,
IF(Risk_Score_Domestic_Stability__c&lt;=-4.0, &quot;#CD2E55&quot;,
IF(Risk_Score_Domestic_Stability__c&lt;=-3.5, &quot;#D44467&quot;,
IF(Risk_Score_Domestic_Stability__c&lt;=-3.0, &quot;#DA5A7A&quot;,
IF(Risk_Score_Domestic_Stability__c&lt;=-2.5, &quot;#E06F8C&quot;,
IF(Risk_Score_Domestic_Stability__c&lt;=-2.0, &quot;#E6859F&quot;,
IF(Risk_Score_Domestic_Stability__c&lt;=-1.5, &quot;#ED9BB1&quot;,
IF(Risk_Score_Domestic_Stability__c&lt;=-1.0, &quot;#F3B1C4&quot;,
IF(Risk_Score_Domestic_Stability__c&lt;=-0.5, &quot;#F9C7D6&quot;, /* lightest red */

&quot;#EFEFEF&quot;)))))))))))))))))))) /* neutral grey */</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Risk Color - Domestic Stability</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
