    <fields>
        <fullName>Risk_Change_Domestic_Stability__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Risk_Score_Domestic_Stability__c &gt;= 3, &quot;Extremely positive&quot;,
IF( Risk_Score_Domestic_Stability__c &gt;= 2, &quot;Significantly positive&quot;,
IF( Risk_Score_Domestic_Stability__c &gt;= 1, &quot;Positive&quot;,
IF( Risk_Score_Domestic_Stability__c &lt;= -3, &quot;Extremely negative&quot;,
IF( Risk_Score_Domestic_Stability__c &lt;= -2, &quot;Significantly negative&quot;,
IF( Risk_Score_Domestic_Stability__c &lt;= -1, &quot;Negative&quot;,
&quot;Neutral&quot;))))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Risk Change - Domestic Stability</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
