    <fields>
        <fullName>Stage_Change__c</fullName>
        <formula>IF( NOT ISBLANK(Previous_Opportunity_Snapshot__c) &amp;&amp; Stage__c  &lt;&gt;  Previous_Opportunity_Snapshot__r.Stage__c  , TRUE, FALSE)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Stage Change</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
