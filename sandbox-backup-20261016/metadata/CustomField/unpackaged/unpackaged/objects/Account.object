    <fields>
        <fullName>Client_Risk_Level__c</fullName>
        <inlineHelpText>This field notes the level of risk of client attrition.  The default value is Low.</inlineHelpText>
        <label>Client Risk Level</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Low</fullName>
                    <default>true</default>
                    <label>Low</label>
                </value>
                <value>
                    <fullName>Medium</fullName>
                    <default>false</default>
                    <label>Medium</label>
                </value>
                <value>
                    <fullName>High</fullName>
                    <default>false</default>
                    <label>High</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Client_Sector_Risk__c</fullName>
        <externalId>false</externalId>
        <formula>CASE( Industry , &quot;Aerospace &amp; Defense&quot;, &quot;High&quot;, 
