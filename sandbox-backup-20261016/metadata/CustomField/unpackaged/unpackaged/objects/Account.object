        <fullName>Sum_of_Active_Contracts_OC__c</fullName>
        <description>roll up of active contracts contract amount (OC) values
OC = Original Currency</description>
        <inlineHelpText>OC = Original Currency</inlineHelpText>
        <label>Sum of Active Contracts (OC)</label>
        <summarizedField>Opportunity.Contract_Amount_OC__c</summarizedField>
        <summaryFilterItems>
            <field>Opportunity.Contract_Active_checkbox__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryForeignKey>Opportunity.AccountId</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Sum_of_Active_Contracts_USD__c</fullName>
        <label>Sum of Active Contracts (USD)</label>
        <summarizedField>Opportunity.Contract_Amount_USD__c</summarizedField>
        <summaryFilterItems>
            <field>Opportunity.Contract_Active_checkbox__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryForeignKey>Opportunity.AccountId</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Sum_of_Active_Recurring_Contracts_USD__c</fullName>
        <label>Sum of Active Recurring Contracts (USD)</label>
        <summarizedField>Opportunity.Contract_Amount_USD__c</summarizedField>
        <summaryFilterItems>
            <field>Opportunity.RevenueType__c</field>
            <operation>equals</operation>
            <value>Recurring</value>
        </summaryFilterItems>
        <summaryFilterItems>
            <field>Opportunity.Contract_Active_checkbox__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryForeignKey>Opportunity.AccountId</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Sum_of_Active_Submitted_Contracts__c</fullName>
        <externalId>false</externalId>
        <formula>Sum_of_Active_Contracts_USD__c  +  Sum_of_Submitted_Contracts__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Sum of Active &amp; Submitted Contracts</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Sum_of_Non_Recurring_Contracts_USD__c</fullName>
        <label>Sum of Non-Recurring Contracts (USD)</label>
        <summarizedField>Opportunity.Contract_Amount_USD__c</summarizedField>
        <summaryFilterItems>
            <field>Opportunity.Contract_Active_checkbox__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryFilterItems>
            <field>Opportunity.RevenueType__c</field>
            <operation>notEqual</operation>
            <value>Recurring</value>
        </summaryFilterItems>
        <summaryForeignKey>Opportunity.AccountId</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
