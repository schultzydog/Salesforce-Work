    <fields>
        <fullName>Source__c</fullName>
        <externalId>false</externalId>
        <formula>IF(NOT ISBLANK(Appearance_URL__c),HYPERLINK( Appearance_URL__c, Headline__c , &quot;_blank&quot;), Headline__c )</formula>
