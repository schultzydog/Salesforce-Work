    <fields>
        <fullName>For_Today_s_Meeting_prior_to_4pm_ET__c</fullName>
        <formula>CreatedDate &lt; DATETIMEVALUE( Text(TODAY()-1) &amp; &apos; 20:00:00&apos; ) &amp;&amp; CreatedDate &gt; DATETIMEVALUE( Text(TODAY() - 2) &amp; &apos; 20:00:00&apos; )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>For today&apos;s meeting - prior to 4pm ET</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>For_todays_meeting__c</fullName>
        <formula>CreatedDate &lt; DATETIMEVALUE( Text(TODAY())  &amp; &apos; 12:00:00&apos; )  &amp;&amp;  CreatedDate &gt; DATETIMEVALUE( Text(TODAY() - 1)  &amp; &apos; 12:00:00&apos; )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>For today&apos;s meeting</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>For_tomorrow_s_meeting__c</fullName>
        <formula>CreatedDate  &gt;=  DATETIMEVALUE( Text(TODAY()-1) &amp; &apos; 20:00:00&apos; )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>For tomorrow&apos;s meeting - after 4pm ET</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
