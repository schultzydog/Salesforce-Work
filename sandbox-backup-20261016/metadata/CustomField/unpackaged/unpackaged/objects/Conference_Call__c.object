    <fields>
        <fullName>Process_for_Create_Activity_History__c</fullName>
        <formula>NOT ISBLANK(Zoom_Webinar_UUID__c) &amp;&amp; NOT ISNULL(Zoom_Webinar_UUID__c) &amp;&amp;  Date_formula__c  &lt; Today()+ 2 &amp;&amp;  Create_Activity_History__c = FALSE &amp;&amp; Date__c &gt;  DATE(2025,01,01)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Process for Create Activity History</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
