    <fields>
        <fullName>Date_formula__c</fullName>
        <formula>DATEVALUE( Event_Start_Time__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Date formula</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Day__c</fullName>
        <externalId>false</externalId>
        <formula>CASE( MOD( Date__c - DATE(1900, 1, 7), 7),  0, &quot;Sunday&quot;,  1, &quot;Monday&quot;,  2, &quot;Tuesday&quot;,  3, &quot;Wednesday&quot;,  4, &quot;Thursday&quot;,  5, &quot;Friday&quot;,  6, &quot;Saturday&quot;, &quot;Error&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Day</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Department_Attribution_Type__c</fullName>
        <externalId>false</externalId>
        <formula>IF( CONTAINS(Speaker_Departments__c, &apos;;&apos;) &amp;&amp;  ISPICKVAL( Type__c , &apos;EG Conference Call&apos;), &apos;Collaborative&apos;,  IF(NOT CONTAINS(Speaker_Departments__c, &apos;;&apos;) &amp;&amp;  ISPICKVAL( Type__c , &apos;EG Conference Call&apos;), &apos;Single-practice&apos;, null) )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Department Attribution Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
