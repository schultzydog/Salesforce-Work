        <scale>1</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Avg_Usefulness__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Count_Usefulness__c&gt; 0, Sum_Usefulness__c / Count_Usefulness__c, null)</formula>
