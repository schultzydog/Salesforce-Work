<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>APAC_friendly_call__c</fullName>
        <formula>IF( TIMEVALUE(Event_Start_Time__c) &gt;= TIMEVALUE(&quot;23:00:00.000&quot;)  ||  TIMEVALUE(Event_End_Time__c) &lt;= TIMEVALUE(&quot;09:00:00.000&quot;), TRUE, FALSE)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>APAC-friendly call</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>All_Speakers__c</fullName>
        <externalId>false</externalId>
        <formula>TRIM(
    IF(ISBLANK(Speaker_Names__c), &quot;&quot;, Speaker_Names__c) &amp;
    IF(AND(NOT(ISBLANK(Speaker_Names__c)), NOT(ISBLANK(External_Speaker__c))), &quot;;&quot;, &quot;&quot;) &amp;
    IF(ISBLANK(External_Speaker__c), &quot;&quot;, External_Speaker__c)
)</formula>
        <label>All Speakers</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Avg_How_easy_to_access_call__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Count_How_easy_to_access_call__c &gt; 0, Sum_How_easy_to_access_call__c /  Count_How_easy_to_access_call__c, null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Avg - How easy to access call</label>
        <precision>18</precision>
        <required>false</required>
        <scale>1</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Avg_Recommendation_scale__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Count_Recommendation_scale__c &gt; 0, Sum_Recommendation_scale__c  /   Count_Recommendation_scale__c, null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Avg - Recommendation scale</label>
        <precision>18</precision>
        <required>false</required>
        <scale>1</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Avg_Speaker_clarity__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Count_Speaker_clarity__c &gt; 0, Sum_Speaker_clarity__c / Count_Speaker_clarity__c, null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Avg - Speaker clarity</label>
        <precision>18</precision>
