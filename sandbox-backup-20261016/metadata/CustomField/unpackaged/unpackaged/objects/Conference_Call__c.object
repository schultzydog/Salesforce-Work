                    <label>Hybrid</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Maziar__c</fullName>
        <formula>IF(
  CONTAINS(All_Speakers__c, &quot;Maziar&quot;),
  TRUE,
  FALSE
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Maziar</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Month__c</fullName>
        <externalId>false</externalId>
        <formula>Text(MONTH( Date__c ))  &amp; &apos;/&apos;  &amp;  text( YEAR(Date__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Month</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Multiple_speakers_no_semi_colon__c</fullName>
        <formula>Count_of_Speakers__c &gt;1  &amp;&amp;  NOT CONTAINS(  Speaker_Departments__c , &apos;;&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Multiple speakers no semi colon</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Number_of_Audience_Questions__c</fullName>
        <externalId>false</externalId>
        <label># of Audience Questions</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Number_of_other_Attendees__c</fullName>
        <externalId>false</externalId>
        <formula>Count_of_Contact_Attendees__c -  Count_of_Corporates_Attendees__c -  Count_of_Global_Markets_Attendees__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Number of other Attendees</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Percent_Attended_To_Registered__c</fullName>
        <formula>IF(Total_Number_of_Registrants__c &gt; 0, Total_Number_of_Attendees__c   /   Total_Number_of_Registrants__c, null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total % of Attended To Registered</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Percentage_Corporate_Attendees__c</fullName>
        <formula>IF(Count_of_Contact_Attendees__c &gt; 0, Count_of_Corporates_Attendees__c /  Count_of_Contact_Attendees__c, null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>% of Corporate Attendees</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Percentage_Global_Markets_Attendees__c</fullName>
        <formula>IF(Count_of_Contact_Attendees__c&gt; 0, Count_of_Global_Markets_Attendees__c /  Count_of_Contact_Attendees__c, null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>% of Global Markets Attendees</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Percentage_other_Attendees__c</fullName>
        <description>non-global markets and non-corporate business line</description>
        <formula>IF(Count_of_Contact_Attendees__c&gt; 0, Number_of_other_Attendees__c /  Count_of_Contact_Attendees__c, null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>% of other Attendees</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
