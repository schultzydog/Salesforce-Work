    <fields>
        <fullName>Recurring_Lost_Amount__c</fullName>
        <externalId>false</externalId>
        <formula>IF(AND(IsWon=FALSE, IsClosed=TRUE),  Annualized_Value_USD_Recurring__c , 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
