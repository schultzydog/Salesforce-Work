        <fullName>Renewal_Opportunity_Amount__c</fullName>
        <formula>IF( Renewal_Opportunity__r.Amount &gt; 0, Renewal_Opportunity__r.Amount, null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
