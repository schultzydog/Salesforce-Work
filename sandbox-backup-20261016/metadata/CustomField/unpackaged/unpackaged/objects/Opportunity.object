        <formula>IF( ISPICKVAL( RevenueType__c , &apos;Recurring&apos;) ,  Contract_End_Date__c  + 1, null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Renewal Date</label>
