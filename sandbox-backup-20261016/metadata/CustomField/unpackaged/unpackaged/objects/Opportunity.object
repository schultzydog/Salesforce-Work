    <fields>
        <fullName>Contract_Status_formula__c</fullName>
        <externalId>false</externalId>
        <formula>IF(Contract_Active__c &amp;&amp; Today() &gt; Contract_End_Date__c, &apos;Expired&apos;, 
 IF(Contract_Active__c , &apos;Executed&apos;, 
  IF(IsWon &amp;&amp; (CONTAINS(TEXT( Approval_Status__c ), &apos;Business&apos;) || CONTAINS(TEXT( Approval_Status__c ), &apos;Finance&apos;)) , &apos;Submitted&apos;,
   IF( IsWon, &apos;Draft&apos;, 
null
))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Contract Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
