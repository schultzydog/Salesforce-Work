    <fields>
        <fullName>Unpaid_Trial_Opportunity__c</fullName>
        <externalId>false</externalId>
        <formula>IF(IsClosed = FALSE &amp;&amp; 
    Account.Count_of_Open_Renewals_Opportunities__c = 0 &amp;&amp; 
    Account.Count_of_Active_Contracts__c = 0 &amp;&amp; 
 Account.Count_of_Enabled_Contacts__c &gt; 0 &amp;&amp;
    NOT(ISPICKVAL(Account.Type, &quot;Media&quot;)) &amp;&amp;  
    NOT(ISPICKVAL(Account.Type, &quot;Friend of Firm&quot;)) &amp;&amp;  
    NOT(ISPICKVAL(Account.Type, &quot;Friend of Ian&quot;)) &amp;&amp; 
    NOT(ISPICKVAL(Account.Type, &quot;Client&quot;)) &amp;&amp; 
    NOT(ISPICKVAL(Type, &quot;Renewal&quot;)) &amp;&amp;  
    NOT(ISPICKVAL(Type, &quot;Voting&quot;)) &amp;&amp; 
    NOT(ISPICKVAL(Type, &quot;Vote Invoice Request&quot;)) &amp;&amp; 
    NOT(ISPICKVAL(Business_Line__c, &quot;GZERO&quot;)) &amp;&amp; 
    NOT(ISPICKVAL(Business_Line__c, &quot;OOP&quot;)), &quot;Yes&quot;, TEXT(Unpaid_Trial_Opportunity_history__c))</formula>
        <label>Unpaid Trial Opportunity</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Unpaid_Trial_Opportunity_history__c</fullName>
        <description>used to hold a static value of unpaid trial oppty when oppty closes</description>
        <label>Unpaid Trial Opportunity history</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <controllingField>Type</controllingField>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>No</fullName>
                    <default>false</default>
                    <label>No</label>
                </value>
                <value>
                    <fullName>Yes</fullName>
                    <default>false</default>
                    <label>Yes</label>
                </value>
            </valueSetDefinition>
            <valueSettings>
                <controllingFieldValue>New Sale</controllingFieldValue>
                <controllingFieldValue>Trial Conversion</controllingFieldValue>
                <controllingFieldValue>Renewal</controllingFieldValue>
                <controllingFieldValue>Voting</controllingFieldValue>
                <valueName>No</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>New Sale</controllingFieldValue>
                <valueName>Yes</valueName>
            </valueSettings>
        </valueSet>
    </fields>
    <fields>
        <fullName>UpSellDownSellAmount_OC__c</fullName>
        <description>Net Sale Amount displays the difference between this Opportunity amount and the Previous Opportunity Amount</description>
        <externalId>false</externalId>
        <formula>IF( (ISPICKVAL(Type,&apos;Renewal&apos;) &amp;&amp; NOT ISBLANK(Previous_Opportunity__c)) , Amount  -  Previous_Opportunity__r.Amount, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Net Sale Amount displays the difference between this Opportunity amount and the Previous Opportunity Amount.  If there is no Previous Opportunity then Net Sale equals this Opportunity amount.</inlineHelpText>
        <label>UpSell/DownSell Amount (OC)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
