        <label>Amount Recurring (OC)</label>
        <summarizedField>OpportunityLineItem.TotalPrice</summarizedField>
        <summaryFilterItems>
            <field>OpportunityLineItem.Revenue_Type__c</field>
            <operation>equals</operation>
