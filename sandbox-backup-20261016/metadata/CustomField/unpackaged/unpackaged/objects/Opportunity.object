    <fields>
        <fullName>Todays_Date__c</fullName>
        <description>This field is created to give proper date display in Outlaw integration</description>
        <externalId>false</externalId>
        <formula>CASE(MONTH(  TODAY() ),
1, &quot;January&quot;,
2, &quot;February&quot;,
3, &quot;March&quot;, 
4, &quot;April&quot;, 
5, &quot;May&quot;, 
6, &quot;June&quot;,
7, &quot;July&quot;,
8, &quot;August&quot;,
9, &quot;September&quot;,
10, &quot;October&quot;,
11, &quot;November&quot;,
12, &quot;December&quot;,
&quot;None&quot;) 
&amp; &quot; &quot; &amp; TEXT(DAY(TODAY()))
&amp; &quot;, &quot; &amp;
TEXT(YEAR( TODAY()))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Today&apos;s Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
