    <fields>
        <fullName>Contract_Active_for_PV_reporting__c</fullName>
        <formula>Contract_End_Date__c &gt;= Today()&amp;&amp; Contract_Start_Date__c &lt;= Today() &amp;&amp; IsWon &amp;&amp; (ISPICKVAL( Approval_Status__c , &apos;Approved&apos;)|| ISPICKVAL( Approval_Status__c , &apos;Pending Finance Approval&apos;)) &amp;&amp; (ISPICKVAL( Contract_Status__c , &apos;Executed&apos;) || ISPICKVAL( Contract_Status__c , &apos;Submitted&apos;))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Contract Active for PV reporting</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
