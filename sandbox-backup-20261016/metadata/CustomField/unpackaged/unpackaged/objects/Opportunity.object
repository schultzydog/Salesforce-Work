    <fields>
        <fullName>Expired_but_include_in_PV__c</fullName>
        <formula>Today() &gt; Contract_End_Date__c  &amp;&amp; IsWon &amp;&amp; Renewal_Opportunity__c != NULL &amp;&amp; Renewal_Opportunity__r.IsClosed = FALSE</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Expired but include in PV</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>External_Id__c</fullName>
        <externalId>false</externalId>
        <label>External Id</label>
        <length>18</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>FX_Impact__c</fullName>
        <externalId>false</externalId>
        <formula>IF(TEXT(CurrencyIsoCode) = TEXT(Previous_Opportunity__r.CurrencyIsoCode) , (Previous_Opportunity__r.Annualized_Value_OC__c/FX_rate__c) - (Previous_Opportunity__r.Annualized_Value_OC__c/Previous_Opportunity__r.FX_rate__c), null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>FX Impact</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
