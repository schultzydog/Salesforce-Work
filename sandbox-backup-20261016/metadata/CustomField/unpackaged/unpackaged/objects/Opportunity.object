    <fields>
        <fullName>Actual_Lost_Revenue_Due_to_Renewal_Delay__c</fullName>
        <formula>IF( ISPICKVAL(  RevenueType__c  ,&apos;Recurring&apos;)&amp;&amp; Days_Between_Prev_End_Current_Start__c &gt; 0 ,  Annualized_Value_OC__c * Days_Between_Prev_End_Current_Start__c/365, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Actual Lost Revenue Due to Renewal Delay</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
