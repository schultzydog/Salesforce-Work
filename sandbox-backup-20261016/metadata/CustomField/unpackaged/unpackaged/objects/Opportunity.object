        <fullName>Renewal_Stage__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(Renewal_Opportunity__r.StageName)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Renewal Stage</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Renewal_Sub_type__c</fullName>
        <externalId>false</externalId>
        <formula>IF( ISPICKVAL( Type , &apos;Renewal&apos;) &amp;&amp; NOT ISBLANK( UpSell_DownSell_Annualized_Recurring__c ) &amp;&amp; NOT ISNULL(UpSell_DownSell_Annualized_Recurring__c) ,
IF( UpSell_DownSell_Annualized_Recurring__c &gt; 1, &apos;Upsell&apos;,
IF( UpSell_DownSell_Annualized_Recurring__c &lt; -1, &apos;Downsell&apos;,&apos;Flat&apos;)), &apos;&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Renewal Sub-type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Renewal_Upsell_Downsell_Amount__c</fullName>
        <formula>IF(Renewal_Opportunity_Amount__c &gt; 0, Renewal_Opportunity_Amount__c - Amount, null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Renewal Upsell/Downsell Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Renewal_Won_on_Time_Day__c</fullName>
        <formula>IsWon  &amp;&amp;  Days_Between_Close_Date_and_Current_Star__c &lt;= 0</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Renewal Won on Time (Day)</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Renewal_Won_on_Time_Quarter__c</fullName>
        <formula>OR( AND(CEILING( MONTH (CloseDate)  / 3 )  &lt;=  CEILING( MONTH(  Contract_Start_Date__c -1  ) / 3 ),
   YEAR(  CloseDate  )  &lt;=  YEAR(   Contract_Start_Date__c -1  )), CEILING( MONTH (CloseDate)  / 3 )    &gt;=    CEILING( MONTH(  Contract_Start_Date__c -1  ) / 3 )  &amp;&amp; YEAR(  CloseDate  )   &lt;   YEAR(   Contract_Start_Date__c -1  ), 	Renewal_Won_on_Time_Day__c = TRUE)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Renewal Won on Time (Quarter)</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
