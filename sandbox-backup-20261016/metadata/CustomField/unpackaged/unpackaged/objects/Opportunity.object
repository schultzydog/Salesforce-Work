        <unique>false</unique>
    </fields>
    <fields>
        <fullName>UpSell_DownSell_Annualized_Recurring__c</fullName>
        <externalId>false</externalId>
        <formula>IF( ISPICKVAL( RevenueType__c ,&apos;Recurring&apos;) &amp;&amp; NOT ISPICKVAL( Type ,&apos;New Sale&apos;) &amp;&amp; NOT ISPICKVAL( Type ,&apos;Trial Conversion&apos;) &amp;&amp; NOT ISBLANK(Previous_Opportunity__c),  Annualized_Value_USD_Recurring__c  -  Previous_Opportunity__r.Annualized_Value_USD_Recurring__c , 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>UpSell/DownSell- Annualized (Recurring)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>UpSell_DownSell_Annualized_Value_OC__c</fullName>
        <formula>IF( ISPICKVAL( RevenueType__c ,&apos;Recurring&apos;) &amp;&amp; NOT ISPICKVAL( Type ,&apos;New Sale&apos;) &amp;&amp; NOT ISPICKVAL( Type ,&apos;Trial Conversion&apos;)
,  Annualized_Value_OC__c - Previous_Opportunity__r.Annualized_Value_OC__c , 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>UpSell/DownSell - Annualized Value (OC)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>UpSell_DownSell_Annualized_Value_USD__c</fullName>
        <externalId>false</externalId>
        <formula>U_D_Annual_Value_Corporate_USD__c +  U_D_Annual_Value_Gloma_USD__c +  U_D_Annual_Value_GZERO_USD__c +  U_D_Annual_Value_OOP_USD__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>UpSell/DownSell - Annualized Value (USD)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>UpSell_DownSell_Expected_Revenue__c</fullName>
        <formula>Probability *  UpSellDownSellAmount_OC__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>UpSell/DownSell Expected Revenue</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Update__c</fullName>
        <label>Update for Maziar</label>
        <length>2000</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Update_to_Closed_Aged_out__c</fullName>
        <formula>NOT IsClosed &amp;&amp; Age__c &gt; 360 &amp;&amp; Days_since_last_touched__c &gt; 90 &amp;&amp; Days_past_Close_Date__c &gt; 30 &amp;&amp; ISPICKVAL(Type, &apos;New Sale&apos;) &amp;&amp; AccountId  &lt;&gt;  &apos;00130000016FGqUAAW&apos;</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Update to Closed/Aged out</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Voting__c</fullName>
        <formula>Number_of_Voting_Products__c &gt; 0</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Voting</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Won_60_days_in_advance__c</fullName>
        <formula>IF(
  IsWon = TRUE,
  Days_Between_Close_Date_and_Current_Star__c &lt;= 60,
  FALSE
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Won 60 days in advance</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>fr_PricebookId__c</fullName>
        <description>Used to initiate Cloning Flow - Do not delete</description>
        <externalId>false</externalId>
        <formula>Pricebook2Id</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>fr_PricebookId</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
</CustomObject>
