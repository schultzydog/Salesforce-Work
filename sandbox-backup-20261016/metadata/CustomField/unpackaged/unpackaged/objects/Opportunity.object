        <fullName>Ready_for_Contract_creation__c</fullName>
        <formula>NOT ISBLANK(Account.ia_crm__Term__c) &amp;&amp; 
NOT ISBLANK( ia_crm__Intacct_Entity__c ) &amp;&amp; 
NOT ISBLANK(TEXT(  Billing_Cycle__c  )) &amp;&amp; 
NOT ISBLANK(  ia_crm__Bill_to__c ) &amp;&amp;
NOT ISPICKVAL(Billing_Cycle__c , &apos;None&apos;) &amp;&amp;
NOT ISBLANK( ia_crm__Bill_to__r.MailingCity ) &amp;&amp;
NOT ISBLANK( ia_crm__Bill_to__r.Email ) &amp;&amp;
NOT ISBLANK( Account.BillingCity ) &amp;&amp; 
ISBLANK( Intacct_Contract_Id_data_loaded__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Oppty Ready for Contract creation</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Reason_for_Approval_Rejection__c</fullName>
        <externalId>false</externalId>
