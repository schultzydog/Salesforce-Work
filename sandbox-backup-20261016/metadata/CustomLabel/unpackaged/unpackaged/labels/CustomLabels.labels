    <labels>
        <fullName>Timesheets_Project_Task_Guidance</fullName>
        <categories>Time</categories>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>Timesheets Project &amp; Task Guidance</shortDescription>
        <value>&lt;b&gt;Timesheet basics:&lt;/b&gt;
&lt;ul&gt;
&lt;li&gt;&lt;b&gt;Log time directly to clients and prospects.&lt;/b&gt; Avoid using general categories whenever possible.&lt;/li&gt;
&lt;li&gt;&lt;b&gt;Use 15-minute increments (.25)&lt;/b&gt; to accurately capture time spent on specific clients.&lt;/li&gt;
&lt;li&gt;&lt;b&gt;Unsure where to log time?&lt;/b&gt; Check the &lt;a href=&quot;https://eurasiagroup.sharepoint.com/:x:/s/Internal/IQBK8-yv0jwPSrD6chGPYXf3AY1OMTaBxV-ldQpWhD5RDkU&quot; target=&quot;_blank&quot;&gt;category guidance&lt;/a&gt;, reference the &lt;a href=&quot;https://eurasiagroup.sharepoint.com/:w:/s/Internal/IQAxwrfspn6-Q4cJGwcPev7kAfV6bOrucxrp-XVRkp04kZM&quot; target=&quot;_blank&quot;&gt;cheat sheet&lt;/a&gt;, or ask the &lt;a href=&quot;https://app.cassidyai.com/chat?aid=cmon56eyn001lqj011lj3wyny&amp;oid=cmbfd6gti00zr3f25cgctc0ew&quot; target=&quot;_blank&quot;&gt;Cassidy Timesheet Bot&lt;/a&gt;. &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Still unclear?&lt;/b&gt; Don&apos;t guess. Contact the account manager, your supervisor, or Christina Wehrmann.&lt;/li&gt;
&lt;/ul&gt;</value>
    </labels>
</CustomLabels>
