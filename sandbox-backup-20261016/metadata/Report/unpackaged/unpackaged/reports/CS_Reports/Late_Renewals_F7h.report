    <currency>USD</currency>
    <description>Report used to figure out contracts where the announcement date was later than the start date</description>
    <filter>
        <criteriaItems>
            <column>SLR_Entry__c$Announcement_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>,Trial Conversion,Renewal</value>
        </criteriaItems>
        <criteriaItems>
            <column>SLR_Entry__c$Business_Line__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>,Corporate,Global Markets,Gzero Media,N/A,OOP/Shared Services,Other,Summit</value>
        </criteriaItems>
        <criteriaItems>
            <column>SLR_Entry__c$Announcement_Date__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterThan</operator>
            <value>12/31/2022</value>
        </criteriaItems>
    </filter>
    <format>Tabular</format>
    <name>Late Renewals</name>
    <params>
        <name>co</name>
