<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <columns>
        <field>User$Name</field>
    </columns>
    <columns>
        <field>User.Lead$OwnerId$Company</field>
    </columns>
    <columns>
        <field>User.Lead$OwnerId$FirstName</field>
    </columns>
    <columns>
        <field>User.Lead$OwnerId$LastName</field>
    </columns>
    <columns>
        <field>User.Lead$OwnerId$Title</field>
    </columns>
    <columns>
        <field>User.Lead$OwnerId$Email</field>
    </columns>
    <columns>
        <field>User.Lead$OwnerId$City</field>
    </columns>
    <columns>
        <field>User.Lead$OwnerId$LastActivityDate</field>
    </columns>
    <columns>
        <field>User*User$Department__c</field>
    </columns>
    <currency>USD</currency>
    <filter>
        <criteriaItems>
            <column>User.Lead$OwnerId$LastActivityDate</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>THIS_MONTH</value>
        </criteriaItems>
        <criteriaItems>
            <column>User.Lead$OwnerId$Status</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>Closed - Converted to Contact,Closed - Spam,Closed- Not Converted,Closed - did not convert</value>
        </criteriaItems>
        <criteriaItems>
            <column>User*User$Department__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>Corporates Aerospace &amp; Defense,Corporates Consumer &amp; Retail,Corporates Financial Institutions Group,Corporates General,Corporates Geo-technology,Corporates Healthcare &amp; Medical Devices,&quot;Corporates Professional Services, Philanthropy &amp; Non-Profit, Public Sector (PPP)&quot;</value>
        </criteriaItems>
    </filter>
    <format>Tabular</format>
    <name>Corps Open Leads This Month</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>Leads_with_Owners__c</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>User$CreatedDate</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
</Report>
