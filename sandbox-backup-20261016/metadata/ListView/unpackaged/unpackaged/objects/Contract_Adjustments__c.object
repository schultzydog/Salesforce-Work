        <label>All</label>
    </listViews>
    <listViews>
        <fullName>Copy_of_Pending_Approval</fullName>
        <columns>NAME</columns>
        <columns>Account__c</columns>
        <columns>New_Contract_Value_OC__c</columns>
        <columns>Original_Contract_Amount_OC__c</columns>
        <columns>Contract_Adjustment_Reason__c</columns>
        <columns>Original_Start_Date__c</columns>
        <columns>Original_End_Date__c</columns>
