        <filters>
            <field>CASES.ORIGIN</field>
            <operation>equals</operation>
            <value>Client requests in WF</value>
        </filters>
        <filters>
            <field>CASES.STATUS</field>
            <operation>notEqual</operation>
            <value>Completed,Closed - no action required,Closed</value>
        </filters>
        <label>Client Requests in WF</label>
    </listViews>
    <listViews>
        <fullName>Closed_Cases_Today</fullName>
        <columns>CASES.CASE_NUMBER</columns>
        <columns>CASES.SUBJECT</columns>
