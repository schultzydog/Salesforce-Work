<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <listViews>
        <fullName>Accounts_w_Trial</fullName>
        <columns>ACCOUNT.NAME</columns>
        <columns>ACCOUNT.TYPE</columns>
        <columns>Business_Line__c</columns>
        <columns>CORE.USERS.LAST_NAME</columns>
        <columns>Status_Enable_Disable__c</columns>
        <columns>Account_Conf_Call_Total_Unique_Contacts__c</columns>
        <columns>Count_of_Contacts_Receiving_Research__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>ACCOUNT.TYPE</field>
            <operation>notEqual</operation>
            <value>Client,Friend of Ian,Friend of Firm,Media</value>
        </filters>
        <filters>
            <field>Count_of_Contacts_Receiving_Research__c</field>
            <operation>greaterThan</operation>
            <value>0</value>
        </filters>
        <filters>
            <field>Status_Enable_Disable__c</field>
            <operation>equals</operation>
            <value>Enabled</value>
        </filters>
        <label>Accounts w Trial</label>
    </listViews>
