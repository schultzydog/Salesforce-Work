        <filters>
            <field>OPPORTUNITY.FISCAL_YEAR</field>
            <operation>equals</operation>
            <value>2020</value>
        </filters>
        <filters>
            <field>OPPORTUNITY.TYPE</field>
            <operation>equals</operation>
            <value>Renewal</value>
        </filters>
        <filters>
            <field>OPPORTUNITY.TYPE</field>
            <operation>equals</operation>
            <value>Upsell</value>
        </filters>
        <filters>
            <field>OPPORTUNITY.TYPE</field>
            <operation>equals</operation>
            <value>Downsell</value>
        </filters>
        <filters>
            <field>OPPORTUNITY.TYPE</field>
            <operation>equals</operation>
            <value>Loss</value>
        </filters>
        <filters>
            <field>OPPORTUNITY.CLOSED</field>
            <operation>notEqual</operation>
            <value>1</value>
        </filters>
        <label>Renewal Opportunities 2020</label>
    </listViews>
    <listViews>
        <fullName>Renewal_Opportunity_Pipeline</fullName>
