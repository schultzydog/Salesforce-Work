<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>52.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>eg Related List Component</masterLabel>
    <description>This show list of records from the source object</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__Tab</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage,lightning__AppPage, lightning__HomePage, lightningCommunity__Default">
            <property name="title" type="String" description="Header Title" label="Header Title" default="" required="true"/>
            <property name="headerStyle" type="String" description="Header Style" label="Header Style" default=""/>
            <property name="iconName" type="String" description="icon to display" required="true" label="Icon" default="standard:account" />
            <property name="relatedObject" type="String" description="Related Object API Name" required="true" label="Source Object"/>
            <property name="fields" type="String" description="Fields to display (Field API Name from Source Object comma seperated)" required="true" label="Columns" default="Name"/>
            <property name="filterQuery" type="String" description="Additional Filters for the Query" label="Filter: Additional Query Filter criteria" default=""/>
            <property name="sortQuery" type="String" description="Order By Query clause" label="Sort: Order By clause" default="Name desc"/>
            <property name="referenceFieldAPI" type="String" description="Related Field API Name to current Object" label="Filter: Context lookup field API Name"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>