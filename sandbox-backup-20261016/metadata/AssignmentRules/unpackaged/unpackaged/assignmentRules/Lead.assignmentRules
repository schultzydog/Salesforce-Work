<?xml version="1.0" encoding="UTF-8"?>
<AssignmentRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <assignmentRule>
        <fullName>Assign Subscription Request Leads</fullName>
        <active>false</active>
        <ruleEntry>
            <criteriaItems>
                <field>Lead.LeadSource</field>
                <operation>equals</operation>
                <value>Conference Call</value>
            </criteriaItems>
            <criteriaItems>
                <field>Lead.CountryCode</field>
                <operation>equals</operation>
                <value>SG</value>
            </criteriaItems>
        </ruleEntry>
    </assignmentRule>
    <assignmentRule>
        <fullName>Conf Call Leads Assignment Rule</fullName>
        <active>false</active>
    </assignmentRule>
    <assignmentRule>
        <fullName>Lead Assignment Rules</fullName>
        <active>false</active>
        <ruleEntry>
            <assignedTo>BD_Team</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.LeadSource</field>
                <operation>equals</operation>
                <value>2019 09 25 whitepaper</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>PolFast_US</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.LeadSource</field>
                <operation>contains</operation>
                <value>PoliticsFast</value>
            </criteriaItems>
            <criteriaItems>
                <field>Lead.Country</field>
                <operation>equals</operation>
                <value>United States</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>PolFast_EMEA</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.LeadSource</field>
                <operation>contains</operation>
                <value>PoliticsFast</value>
            </criteriaItems>
        </ruleEntry>
    </assignmentRule>
</AssignmentRules>
