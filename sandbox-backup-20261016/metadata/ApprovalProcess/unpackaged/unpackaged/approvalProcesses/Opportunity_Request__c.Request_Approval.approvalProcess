            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>oliveira@eurasiagroup.net</name>
                <type>user</type>
            </approver>
            <approver>
                <name>wehrmann@eurasiagroup.net</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Sales Ops approval</label>
        <name>Sales_Ops_approval</name>
        <rejectionActions>
            <action>
                <name>Approval_Status_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>fitzpatrick.ne@eurasiagroup.net</name>
                <type>user</type>
            </approver>
            <approver>
                <name>mendoza@eurasiagroup.net</name>
                <type>user</type>
            </approver>
            <approver>
                <name>pali@eurasiagroup.net</name>
                <type>user</type>
            </approver>
            <approver>
                <name>zhang@eurasiagroup.net</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Finance approval</label>
        <name>Finance_approval</name>
        <rejectBehavior>
            <type>BackToPrevious</type>
        </rejectBehavior>
    </approvalStep>
    <emailTemplate>unfiled$public/New_Opportunity_Request_for_approval</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <finalApprovalActions>
        <action>
            <name>Approval_Status_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Approval_Status_Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Approval_Status_Pending_Business</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Request Approval</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Approval_Status_Recalled</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
