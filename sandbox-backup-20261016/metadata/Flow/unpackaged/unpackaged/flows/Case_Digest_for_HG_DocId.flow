<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <environments>Default</environments>
    <formulas>
        <name>characterof</name>
        <dataType>Number</dataType>
        <expression>FIND(&quot;@eurasiagroup.net&gt;&quot;, {!$Record.Description})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>frm_CleanDescription</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(
    SUBSTITUTE(
        SUBSTITUTE(
            {!$Record.Description},
            CHR(13),
            &quot; &quot;
        ),
        CHR(10),
        &quot; &quot;
    ),
    &quot;  &quot;,
    &quot; &quot;
)</expression>
    </formulas>
    <formulas>
        <name>frm_ExtractedDocId</name>
        <dataType>String</dataType>
        <expression>TRIM(
    SUBSTITUTE(
        LEFT(
            MID(
                {!$Record.Description},
                FIND(&quot;X-HG-DocID &quot;, {!$Record.Description}) + LEN(&quot;X-HG-DocID &quot;),
                50
            ),
            FIND(
                &quot; &quot;,
                MID(
                    {!$Record.Description},
                    FIND(&quot;X-HG-DocID &quot;, {!$Record.Description}) + LEN(&quot;X-HG-DocID &quot;),
                    50
                ) &amp; &quot; &quot;
            ) - 1
        ),
        &quot;Opt&quot;,
        &quot;&quot;
    )
)</expression>
    </formulas>
    <formulas>
        <name>MessageContents</name>
        <dataType>String</dataType>
        <expression>LEFT( {!$Record.Description},  FIND(&quot;@eurasiagroup.net&gt;&quot;, {!$Record.Description} )    )</expression>
    </formulas>
    <interviewLabel>Case: Digest for HG DocId {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case: Digest for HG DocId</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Case</name>
        <label>Update Case</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <inputAssignments>
            <field>HG_DocId__c</field>
            <value>
                <elementReference>frm_ExtractedDocId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Publication_reply_text_approximate__c</field>
            <value>
                <elementReference>MessageContents</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Closed - no action required</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Case</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Description</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Origin</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Publication Replies</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
