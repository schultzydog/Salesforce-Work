    <environments>Default</environments>
    <formulas>
        <name>renewalContractEndDate</name>
        <dataType>Date</dataType>
        <expression>DATE( YEAR({!$Record.Contract_End_Date__c}) + 1, MONTH({!$Record.Contract_End_Date__c}) , DAY({!$Record.Contract_End_Date__c}) )</expression>
    </formulas>
    <formulas>
        <name>renewalContractStartDate</name>
        <dataType>Date</dataType>
        <expression>{!$Record.Contract_End_Date__c} + 1</expression>
    </formulas>
    <formulas>
        <name>RenewalopportunityName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Name} &amp; &apos; &apos; &amp; Text(Year({!renewalContractStartDate}))</expression>
    </formulas>
    <interviewLabel>Opportunity: {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity: Create Trial Conversion oppty</label>
    <loops>
        <name>Opportunity_Products</name>
        <label>Opportunity Products</label>
        <locationX>176</locationX>
        <locationY>1079</locationY>
        <collectionReference>Current_Opportunity_Products</collectionReference>
        <iterationOrder>Asc</iterationOrder>
