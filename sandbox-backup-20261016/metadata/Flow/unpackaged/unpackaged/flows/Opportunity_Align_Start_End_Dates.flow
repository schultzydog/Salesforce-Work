<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>The Sage Intacct package has its own Start/End dates. EG has custom Contract Start/End date fields that are included in numerous formulas/workflows. In order to minimize change mgmt, this flow aligns the Sage Intacct Start/End date fields to the already used Contract Start/End date fields</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity: Align Start/End Dates {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity: Align Start/End Dates</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Ensure_Start_and_End_dates_are_aligned</name>
        <label>Ensure Start and End dates are aligned</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>or</filterLogic>
        <filters>
            <field>ia_crm__Start_Date__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Contract_Start_Date__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>ia_crm__End_Date__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Contract_End_Date__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>ia_crm__Ship_to__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.ia_crm__Bill_to__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>ia_crm__End_Date__c</field>
            <value>
                <elementReference>$Record.Contract_End_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ia_crm__Ship_to__c</field>
            <value>
                <elementReference>$Record.ia_crm__Bill_to__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ia_crm__Start_Date__c</field>
            <value>
                <elementReference>$Record.Contract_Start_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Ensure_Start_and_End_dates_are_aligned</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
