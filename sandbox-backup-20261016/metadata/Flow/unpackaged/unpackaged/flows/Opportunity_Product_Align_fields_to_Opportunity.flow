<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>Sage Intacct requires certain fields to be filled out on the Opportunity Product records. Some of these fields can be &apos;inherited&apos; from the parent Opportunity. This flow performs this alignment.</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity Product: Align fields to Opportunity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Product: Align fields to Opportunity</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_oppty_product</name>
        <label>Update oppty product</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Product_End_Date__c</field>
            <value>
                <elementReference>$Record.Opportunity.Contract_End_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Product_Start_Date__c</field>
            <value>
                <elementReference>$Record.Opportunity.Contract_Start_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ia_crm__Amount__c</field>
            <value>
                <elementReference>$Record.TotalPrice</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ia_crm__Billing_End_Date__c</field>
            <value>
                <elementReference>$Record.Opportunity.Contract_End_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ia_crm__Billing_Start_Date__c</field>
            <value>
                <elementReference>$Record.Opportunity.Contract_Start_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ia_crm__End_Date__c</field>
            <value>
                <elementReference>$Record.Opportunity.Contract_End_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ia_crm__Intacct_Location__c</field>
            <value>
                <elementReference>$Record.Opportunity.ia_crm__Intacct_Location__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ia_crm__Start_Date__c</field>
            <value>
                <elementReference>$Record.Opportunity.Contract_Start_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_oppty_product</targetReference>
        </connector>
        <object>OpportunityLineItem</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
