    <environments>Default</environments>
    <formulas>
        <name>IncrementedProjectCode</name>
        <dataType>String</dataType>
        <expression>IF(NOT ISBLANK({!$Record.Project_Code__c}), LEFT({!$Record.Project_Code__c}, 6) &amp; 
LPAD(TEXT(VALUE(RIGHT({!$Record.Project_Code__c}, 4)) + 1), 4, &quot;0&quot;), null)</expression>
    </formulas>
    <formulas>
        <name>renewalContractEndDate</name>
        <dataType>Date</dataType>
        <expression>DATE( YEAR({!$Record.Contract_End_Date__c}) + 1, MONTH({!$Record.Contract_End_Date__c}) , DAY({!$Record.Contract_End_Date__c}) )</expression>
    </formulas>
    <formulas>
        <name>renewalContractStartDate</name>
        <dataType>Date</dataType>
        <expression>{!$Record.Contract_End_Date__c} + 1</expression>
    </formulas>
    <formulas>
        <name>renewalEndMonthYear</name>
        <dataType>String</dataType>
        <expression>LEFT(CASE(MONTH( {!renewalContractEndDate}),
1, &quot;January&quot;,
2, &quot;February&quot;,
3, &quot;March&quot;,
4, &quot;April&quot;,
5, &quot;May&quot;,
6, &quot;June&quot;,
7, &quot;July&quot;,
8, &quot;August&quot;,
9, &quot;September&quot;,
10, &quot;October&quot;,
11, &quot;November&quot;,
12, &quot;December&quot;,
&quot;None&quot;), 3)&amp;
TEXT(YEAR({!renewalContractEndDate}))</expression>
    </formulas>
    <formulas>
        <name>renewalName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Account.Name}&amp;&apos;, &apos;&amp;{!$Record.First_Product_Name__c}&amp;&apos;, &apos;&amp;
LEFT(CASE(MONTH( {!renewalContractStartDate}),
1, &quot;January&quot;,
2, &quot;February&quot;,
3, &quot;March&quot;,
4, &quot;April&quot;,
5, &quot;May&quot;,
6, &quot;June&quot;,
7, &quot;July&quot;,
8, &quot;August&quot;,
9, &quot;September&quot;,
10, &quot;October&quot;,
11, &quot;November&quot;,
12, &quot;December&quot;,
&quot;None&quot;), 3)&amp;
TEXT(YEAR({!renewalContractStartDate}))&amp;&apos;-&apos;&amp;
LEFT(CASE(MONTH( {!renewalContractEndDate}),
1, &quot;January&quot;,
2, &quot;February&quot;,
3, &quot;March&quot;,
4, &quot;April&quot;,
5, &quot;May&quot;,
6, &quot;June&quot;,
7, &quot;July&quot;,
8, &quot;August&quot;,
9, &quot;September&quot;,
10, &quot;October&quot;,
11, &quot;November&quot;,
12, &quot;December&quot;,
&quot;None&quot;), 3)&amp;
TEXT(YEAR({!renewalContractEndDate}))</expression>
    </formulas>
    <formulas>
        <name>renewalStartMonthYear</name>
        <dataType>String</dataType>
        <expression>LEFT(CASE(MONTH( {!renewalContractStartDate}),
1, &quot;January&quot;,
2, &quot;February&quot;,
3, &quot;March&quot;,
4, &quot;April&quot;,
5, &quot;May&quot;,
6, &quot;June&quot;,
7, &quot;July&quot;,
8, &quot;August&quot;,
9, &quot;September&quot;,
10, &quot;October&quot;,
11, &quot;November&quot;,
12, &quot;December&quot;,
&quot;None&quot;), 3)&amp;
TEXT(YEAR({!renewalContractStartDate}))</expression>
    </formulas>
    <interviewLabel>Opportunity: Set Renewal Opportunity on Contract {!$Flow.CurrentDateTime}</interviewLabel>
