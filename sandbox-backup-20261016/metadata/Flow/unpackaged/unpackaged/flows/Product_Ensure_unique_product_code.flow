<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <customErrors>
        <name>Product_Code_is_not_unique</name>
        <label>Product Code is not unique</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Product Code must be unique</errorMessage>
            <fieldSelection>ProductCode</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Is_Product_Code_Unique</name>
        <label>Is Product Code Unique?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Product_Code_is_not_unique</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_no_match</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_products</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Yes - no match</label>
        </rules>
        <rules>
            <name>Yes_code_matches_on_this_record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.ProductCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.ProductCode</elementReference>
                </rightValue>
            </conditions>
            <label>Yes - code matches on this record</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Product: Ensure unique product code {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Product: Ensure unique product code</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
