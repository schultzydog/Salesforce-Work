    <textTemplates>
        <name>DeliverableDetails</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;font-size: 11pt; font-family: &amp;quot;Aptos&amp;quot;, sans-serif;&quot;&gt;You have a request for a deliverable for {!$Record.Opportunity__r.Account.Name} from {!Get_Oppty_Owner.Name}. Please reply with any questions regarding the request or to request an extension on the delivery date.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Project: {!$Record.Opportunity__r.Name}&lt;/p&gt;&lt;p&gt;Project Value: {!$Record.Opportunity__r.Amount}&lt;/p&gt;&lt;p&gt;Description: {!$Record.Description__c}&lt;/p&gt;&lt;p&gt;Type of Deliverable: {!$Record.Type__c}&lt;/p&gt;&lt;p&gt;Priority: {!$Record.Priority__c}&lt;/p&gt;&lt;p&gt;Deadline: {!$Record.Deadline__c}&lt;/p&gt;&lt;p&gt;Kick off call needed: {!$Record.Kick_off_call_needed__c}&lt;/p&gt;&lt;p&gt;Project lead: {!Get_Project_Lead.Name}&lt;/p&gt;&lt;p&gt;Analysts needed: {!$Record.Analysts_Needed__c}&lt;/p&gt;</text>
    </textTemplates>
