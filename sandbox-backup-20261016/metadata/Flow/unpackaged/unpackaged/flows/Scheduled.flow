    <constants>
        <name>EmailAddresses</name>
        <dataType>String</dataType>
        <value>
            <stringValue>schultz@eurasiagroup.net,oliveira@eurasiagroup.net,Accounting@eurasiagroup.net,accountspayable@eurasiagroup.net,spratt@eurasiagroup.net</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Check_Callout_Response</name>
        <label>Check Callout Response</label>
        <locationX>182</locationX>
        <locationY>468</locationY>
        <defaultConnectorLabel>Unsuccessful</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>currencyapi.responseCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>200.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Active_Currencies</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>added AED, removed the email alert, no longer needed, update to do daily updates</description>
    <environments>Default</environments>
    <formulas>
        <name>AED_Rate_Inverse</name>
        <dataType>Number</dataType>
        <expression>{!AED_rate}</expression>
        <scale>6</scale>
    </formulas>
    <formulas>
        <name>BRL_Rate_Inverse</name>
        <dataType>Number</dataType>
        <expression>1/{!BRL_Rate}</expression>
        <scale>6</scale>
    </formulas>
    <formulas>
        <name>CAD_Rate_Inverse</name>
        <dataType>Number</dataType>
        <expression>1/{!CAD_Rate}</expression>
        <scale>6</scale>
    </formulas>
    <formulas>
        <name>CurrencyExchangeRates</name>
        <dataType>Number</dataType>
        <expression>If(ISPICKVAL({!Loop.IsoCode}, &quot;EUR&quot;), {!currencyapi.2XX.data.EUR.value},
If(ISPICKVAL({!Loop.IsoCode}, &quot;BRL&quot;), {!currencyapi.2XX.data.BRL.value},
If(ISPICKVAL({!Loop.IsoCode}, &quot;JPY&quot;), {!currencyapi.2XX.data.JPY.value},
If(ISPICKVAL({!Loop.IsoCode}, &quot;SGD&quot;), {!currencyapi.2XX.data.SGD.value},
If(ISPICKVAL({!Loop.IsoCode}, &quot;CAD&quot;), {!currencyapi.2XX.data.CAD.value},
If(ISPICKVAL({!Loop.IsoCode}, &quot;GBP&quot;), {!currencyapi.2XX.data.GBP.value},
If(ISPICKVAL({!Loop.IsoCode}, &quot;AED&quot;), {!currencyapi.2XX.data.AED.value},
 0.0000)))))))</expression>
        <scale>6</scale>
    </formulas>
    <formulas>
        <name>EUR_Rate_Inverse</name>
        <dataType>Number</dataType>
        <expression>1/{!EUR_Rate}</expression>
        <scale>6</scale>
    </formulas>
    <formulas>
        <name>GBP_Rate_Inverse</name>
        <dataType>Number</dataType>
        <expression>1/{!GBP_Rate}</expression>
        <scale>6</scale>
    </formulas>
    <formulas>
        <name>JPY_Rate_Inverse</name>
        <dataType>Number</dataType>
        <expression>1/{!JPY_Rate}</expression>
        <scale>6</scale>
    </formulas>
    <formulas>
        <name>SGD_Rate_Inverse</name>
        <dataType>Number</dataType>
        <expression>1/{!SGD_Rate}</expression>
        <scale>6</scale>
    </formulas>
    <interviewLabel>Scheduled {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Currency Updates: scheduled flow to pull updates from currency api</label>
    <loops>
        <name>Loop</name>
        <label>Loop Through Currencies</label>
        <locationX>50</locationX>
        <locationY>1440</locationY>
        <collectionReference>Get_Active_Currencies</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>DatedConversionRate_Mapping</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_DatedConversionRates</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
