        <locationX>50</locationX>
        <locationY>1848</locationY>
        <inputReference>VarR_DatedConversionRates</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Active_Currencies</name>
        <label>Get Active Currencies</label>
        <locationX>50</locationX>
        <locationY>576</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_GBP</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>IsCorporate</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>CurrencyType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Wait</targetReference>
        </connector>
        <schedule>
            <dayOfMonthToRun>0</dayOfMonthToRun>
            <frequency>Daily</frequency>
            <frequencyNumber>0</frequencyNumber>
            <startDate>2024-06-03</startDate>
            <startTime>08:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>Body</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Currency rates have been automatically updated in Salesforce with the following values:&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;table class=&quot;ql-table-blob&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;tg-1i9y&quot;&gt;Currency Code&lt;/th&gt;&lt;th class=&quot;tg-4hdi&quot;&gt;&lt;span style=&quot;font-weight:700;text-decoration:none;color:windowtext;background-color:white&quot;&gt;Exchange Rate (USD to X)&lt;/span&gt;&lt;/th&gt;&lt;th class=&quot;tg-4hdi&quot;&gt;&lt;span style=&quot;font-weight:700;text-decoration:none;color:windowtext;background-color:white&quot;&gt;Exchange Rate (X to USD )&lt;/span&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td class=&quot;tg-4vrb&quot;&gt;&lt;span style=&quot;font-weight:400;text-decoration:none;color:windowtext;background-color:white&quot;&gt;BRL&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;tg-fcvt&quot;&gt;&lt;span style=&quot;font-weight:400;text-decoration:none;color:windowtext;background-color:white&quot;&gt;{!BRL_Rate}&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;tg-fcvt&quot;&gt;&lt;span style=&quot;font-weight:400;text-decoration:none;color:windowtext;background-color:white&quot;&gt;{!BRL_Rate_Inverse}&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td class=&quot;tg-4vrb&quot;&gt;&lt;span style=&quot;font-weight:400;text-decoration:none;color:windowtext;background-color:white&quot;&gt;CAD&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;tg-fcvt&quot;&gt;&lt;span style=&quot;font-weight:400;text-decoration:none;color:windowtext;background-color:white&quot;&gt;{!CAD_Rate}&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;tg-fcvt&quot;&gt;&lt;span style=&quot;font-weight:400;text-decoration:none;color:windowtext;background-color:white&quot;&gt;{!CAD_Rate_Inverse}&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td class=&quot;tg-4vrb&quot;&gt;&lt;span style=&quot;font-weight:400;text-decoration:none;color:windowtext;background-color:white&quot;&gt;GBP&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;tg-fcvt&quot;&gt;&lt;span style=&quot;font-weight:400;text-decoration:none;color:windowtext;background-color:white&quot;&gt;{!GBP_Rate}&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;tg-fcvt&quot;&gt;&lt;span style=&quot;font-weight:400;text-decoration:none;color:windowtext;background-color:white&quot;&gt;{!GBP_Rate_Inverse}&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td class=&quot;tg-4vrb&quot;&gt;&lt;span style=&quot;font-weight:400;text-decoration:none;color:windowtext;background-color:white&quot;&gt;JPY&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;tg-fcvt&quot;&gt;&lt;span style=&quot;font-weight:400;text-decoration:none;color:windowtext;background-color:white&quot;&gt;{!JPY_Rate}&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;tg-fcvt&quot;&gt;&lt;span style=&quot;font-weight:400;text-decoration:none;color:windowtext;background-color:white&quot;&gt;{!JPY_Rate_Inverse}&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td class=&quot;tg-4vrb&quot;&gt;&lt;span style=&quot;font-weight:400;text-decoration:none;color:windowtext;background-color:white&quot;&gt;SGD&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;tg-fcvt&quot;&gt;&lt;span style=&quot;font-weight:400;text-decoration:none;color:windowtext;background-color:white&quot;&gt;{!SGD_Rate}&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;tg-fcvt&quot;&gt;&lt;span style=&quot;font-weight:400;text-decoration:none;color:windowtext;background-color:white&quot;&gt;{!SGD_Rate_Inverse}&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;</text>
    </textTemplates>
