<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <assignments>
        <name>Assign_Count_of_Enabled</name>
        <label>Assign Count of Enabled</label>
        <locationX>176</locationX>
        <locationY>468</locationY>
        <assignmentItems>
            <assignToReference>CountofEnabledContacts</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Contacts</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Count_of_Enabled_Receiving_Research</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Count_of_Enabled_Receiving_Research</name>
        <label>Assign Count of Enabled Receiving Research</label>
        <locationX>176</locationX>
        <locationY>576</locationY>
        <assignmentItems>
            <assignToReference>CountofContactsReceivingResearch</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Contacts_enabled_and_receiving_research</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Account</targetReference>
        </connector>
    </assignments>
    <description>counts enabled contacts and contacts receiving research</description>
    <environments>Default</environments>
    <interviewLabel>Account: Scheduled job to roll up Contact counts {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account: Scheduled job to roll up Contact counts</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Contacts</name>
        <label>Get Enabled Contacts</label>
        <locationX>176</locationX>
        <locationY>252</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Contacts_enabled_and_receiving_research</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Enabled</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Contact</object>
        <sortField>Date_First_Research_Sent__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Contacts_enabled_and_receiving_research</name>
        <label>Get Contacts - enabled and receiving research</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Count_of_Enabled</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Enabled</stringValue>
            </value>
        </filters>
        <filters>
            <field>Research_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Is Receiving Research</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Contact</object>
        <sortField>Date_First_Research_Sent__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Account</name>
        <label>Update Account</label>
        <locationX>176</locationX>
        <locationY>684</locationY>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Count_of_Enabled_Contacts__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>CountofEnabledContacts</elementReference>
            </value>
        </filters>
        <filters>
            <field>Count_of_Contacts_Receiving_Research__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>CountofContactsReceivingResearch</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Count_of_Contacts_Receiving_Research__c</field>
            <value>
                <elementReference>CountofContactsReceivingResearch</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
