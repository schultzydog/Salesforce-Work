<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <decisions>
        <name>Currency_decision</name>
        <label>Currency decision</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_non_BRL_Location_Entity</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>BRL</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CurrencyIsoCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>BRL</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_BRL_Location_Entity</targetReference>
            </connector>
            <label>BRL</label>
        </rules>
    </decisions>
    <description>To support the Sage Intacct integration, the Oppty/Prods/Contract must have a Location Entity value. To make this process easier, this flow automates population of that value</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity: Set default Location Entity based on currency {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity: Set default Location Entity based on currency</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_BRL_Location_Entity</name>
        <label>Get BRL Location Entity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Oppty_for_BRL</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ia_crm__Intacct_Entity_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>500</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ia_crm__Intacct_Entity__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_non_BRL_Location_Entity</name>
        <label>Get non-BRL Location Entity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Oppty_for_non_BRL</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ia_crm__Intacct_Entity_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>100</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ia_crm__Intacct_Entity__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Oppty_for_BRL</name>
        <label>Update Oppty for BRL</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>or</filterLogic>
        <filters>
            <field>ia_crm__Intacct_Entity__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>Get_BRL_Location_Entity.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>ia_crm__Intacct_Location__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>Get_BRL_Location_Entity.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>ia_crm__Intacct_Entity__c</field>
            <value>
                <elementReference>Get_BRL_Location_Entity.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ia_crm__Intacct_Location__c</field>
            <value>
                <elementReference>Get_BRL_Location_Entity.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Oppty_for_non_BRL</name>
        <label>Update Oppty for non-BRL</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>or</filterLogic>
        <filters>
            <field>ia_crm__Intacct_Entity__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>Get_non_BRL_Location_Entity.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>ia_crm__Intacct_Location__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>Get_non_BRL_Location_Entity.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>ia_crm__Intacct_Entity__c</field>
            <value>
                <elementReference>Get_non_BRL_Location_Entity.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ia_crm__Intacct_Location__c</field>
            <value>
                <elementReference>Get_non_BRL_Location_Entity.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Currency_decision</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CurrencyIsoCode</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>null</stringValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
