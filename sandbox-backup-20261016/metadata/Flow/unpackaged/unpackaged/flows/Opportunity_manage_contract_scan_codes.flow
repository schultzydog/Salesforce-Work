<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <decisions>
        <name>Decide_if_Contract_Code_exists</name>
        <label>Decide if Contract Code exists</label>
        <locationX>182</locationX>
        <locationY>947</locationY>
        <defaultConnector>
            <targetReference>Set_Contract_Code_Lookup_existing</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Contract Code Exists</defaultConnectorLabel>
        <rules>
            <name>Contract_Code_does_not_exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contract_Code</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Contract_Code_record</targetReference>
            </connector>
            <label>Contract Code does not exist</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decide_if_Scan_Code_exists</name>
        <label>Decide if Scan Code exists</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Get_Scan_Code_again</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Scan_Code_does_not_exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Scan_Code.Scan_Code__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Scan_Code</targetReference>
            </connector>
            <label>Scan Code does not exist</label>
        </rules>
    </decisions>
    <description>When a Project Code is added to an Opportunity, Create Contract Code and Scan Code as needed</description>
    <environments>Default</environments>
    <formulas>
        <name>ContractCode</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.Project_Code__c}, 8)</expression>
    </formulas>
    <formulas>
        <name>ScanCode</name>
        <dataType>String</dataType>
        <expression>left({!$Record.Project_Code__c, 6})</expression>
    </formulas>
    <interviewLabel>Opportunity: Create Contract Code and Scan Code {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity: manage contract/scan codes</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Contract_Code_record</name>
        <label>Create Contract Code record</label>
        <locationX>50</locationX>
        <locationY>1055</locationY>
        <connector>
            <targetReference>Get_New_Contract_Code</targetReference>
        </connector>
        <inputAssignments>
            <field>Contract_Code__c</field>
            <value>
                <elementReference>ContractCode</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Scan_Code__c</field>
            <value>
                <elementReference>Get_Scan_Code_again.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Contract_Code__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_Scan_Code</name>
        <label>Create Scan Code</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <connector>
            <targetReference>Get_Scan_Code_again</targetReference>
        </connector>
        <inputAssignments>
            <field>Account__c</field>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Scan_Code__c</field>
            <value>
                <elementReference>ScanCode</elementReference>
            </value>
        </inputAssignments>
        <object>Scan_Code__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Contract_Code</name>
        <label>Get Contract Code</label>
        <locationX>182</locationX>
        <locationY>839</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decide_if_Contract_Code_exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Contract_Code__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ContractCode</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contract_Code__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_New_Contract_Code</name>
        <label>Get New Contract Code</label>
        <locationX>50</locationX>
        <locationY>1163</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Contract_Code_Lookup</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Contract_Code__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ContractCode</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contract_Code__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Scan_Code</name>
        <label>Get Scan Code</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decide_if_Scan_Code_exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Scan_Code__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ScanCode</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Scan_Code__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>repeating this query in case a new scan code was created</description>
        <name>Get_Scan_Code_again</name>
        <label>Get Scan Code again</label>
        <locationX>182</locationX>
        <locationY>731</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Contract_Code</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Scan_Code__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ScanCode</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Scan_Code__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Set_Contract_Code_Lookup</name>
        <label>Update opportunity with Contract Code Lookup</label>
        <locationX>50</locationX>
        <locationY>1271</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Contract_Code__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Contract_Code__c</field>
            <value>
                <elementReference>Get_New_Contract_Code.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Set_Contract_Code_Lookup_existing</name>
        <label>Set Contract Code Lookup for existing Contract Code</label>
        <locationX>314</locationX>
        <locationY>1055</locationY>
        <inputAssignments>
            <field>Contract_Code__c</field>
            <value>
                <elementReference>Get_Contract_Code.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Scan_Code</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Project_Code__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </filters>
        <filters>
            <field>Contract_Code__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>ContractCodeRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Contract_Code__c</objectType>
    </variables>
</Flow>
