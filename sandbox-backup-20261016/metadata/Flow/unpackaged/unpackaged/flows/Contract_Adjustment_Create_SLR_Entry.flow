<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <environments>Default</environments>
    <formulas>
        <name>OwnerName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Opportunity__r.Owner.FirstName} &amp; &apos; &apos;&amp; {!$Record.Opportunity__r.Owner.LastName}</expression>
    </formulas>
    <formulas>
        <name>SLRAmount</name>
        <dataType>Number</dataType>
        <expression>IF( ISPICKVAL({!$Record.Opportunity__r.RevenueType__c}, &apos;Recurring&apos;), 0, {!$Record.SLR_Amount_USD_formula__c})</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Contract Adjustment: Create SLR Entry {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contract Adjustment: Create SLR Entry</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_SLR_Entry</name>
        <label>Create SLR Entry</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <connector>
            <targetReference>Update_with_Approval_Date</targetReference>
        </connector>
        <inputAssignments>
            <field>Announcement_Date__c</field>
            <value>
                <elementReference>$Record.Submission_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Announcement_Type__c</field>
            <value>
                <elementReference>$Record.Contract_Adjustment_Reason__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Business_Line__c</field>
            <value>
                <elementReference>$Record.Opportunity__r.Business_Line__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Contract_Adjustment__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Contract_Amount_OC__c</field>
            <value>
                <elementReference>$Record.New_Contract_Value_OC__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Created_by_SLR_Automation__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CurrencyIsoCode</field>
            <value>
                <elementReference>$Record.CurrencyIsoCode</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>End_Date__c</field>
            <value>
                <elementReference>$Record.New_End_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Opportunity__c</field>
            <value>
                <elementReference>$Record.Opportunity__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SLR_Amount_OC__c</field>
            <value>
                <elementReference>$Record.UpSell_DownSell_Amount_OC__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SLR_Amount_USD__c</field>
            <value>
                <elementReference>SLRAmount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Scope_of_Work__c</field>
            <value>
                <elementReference>$Record.Product_Change_Details__c</elementReference>
            </value>
        </inputAssignments>
        <object>SLR_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>Update_with_Approval_Date</name>
        <label>Update with Approval Date</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <inputAssignments>
            <field>Approval_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_SLR_Entry</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Approval_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <object>Contract_Adjustments__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
