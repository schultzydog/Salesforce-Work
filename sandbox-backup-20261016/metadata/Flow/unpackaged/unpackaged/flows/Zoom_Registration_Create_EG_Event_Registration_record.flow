<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <decisions>
        <name>Do_not_Create_Registrant_record_for_eg_staff</name>
        <label>Do not Create Registrant record for eg staff</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>Create_EG_Event_Registrant</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Not_EG_Staff</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ZOFU__Email__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>eurasiagroup.net</stringValue>
                </rightValue>
            </conditions>
            <label>Not EG Staff</label>
        </rules>
    </decisions>
    <decisions>
        <name>Does_EG_Event_exist</name>
        <label>Does EG Event exist?</label>
        <locationX>248</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_EG_Event</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Do_not_Create_Registrant_record_for_eg_staff</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>this flow creates and relates an eg registrant record. it ensures registrant records are not created for EG Staff</description>
    <environments>Default</environments>
    <interviewLabel>Zoom Registration: Create EG Event Registration record {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Zoom Registration: Create EG Event Registration record</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_EG_Event_Registrant</name>
        <label>Create EG Event Registrant</label>
        <locationX>182</locationX>
        <locationY>647</locationY>
        <connector>
            <targetReference>Update_Zoom_Registration</targetReference>
        </connector>
        <inputAssignments>
            <field>Attended__c</field>
            <value>
                <elementReference>$Record.ZOFU__Joined__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>City__c</field>
            <value>
                <elementReference>$Record.ZOFU__City__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Contact__c</field>
            <value>
                <elementReference>$Record.ZOFU__Contact__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Country__c</field>
            <value>
                <elementReference>$Record.ZOFU__Country__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>EG_Event__c</field>
            <value>
                <elementReference>Get_EG_Event.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Email__c</field>
            <value>
                <elementReference>$Record.ZOFU__Email__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>First_Name__c</field>
            <value>
                <elementReference>$Record.ZOFU__First_Name__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Last_Name__c</field>
            <value>
                <elementReference>$Record.ZOFU__Last_Name__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Lead__c</field>
            <value>
                <elementReference>$Record.ZOFU__Lead__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Phone__c</field>
            <value>
                <elementReference>$Record.ZOFU__Phone__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>State_Province__c</field>
            <value>
                <elementReference>$Record.ZOFU__State__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Title__c</field>
            <value>
                <elementReference>$Record.ZOFU__Job_Title__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Zoom_Registrant_Id__c</field>
            <value>
                <elementReference>$Record.ZOFU__Zoom_Registrant_Id__c</elementReference>
            </value>
        </inputAssignments>
        <object>EG_Event_Registrant__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_EG_Event</name>
        <label>Get EG Event</label>
        <locationX>248</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Does_EG_Event_exist</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Event_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ZOFU__Campaign__r.ZOFU__Zoom_Webinar_Id__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Conference_Call__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Zoom_Registration</name>
        <label>Update Zoom Registration</label>
        <locationX>182</locationX>
        <locationY>755</locationY>
        <inputAssignments>
            <field>EG_Event_Registrant__c</field>
            <value>
                <elementReference>Create_EG_Event_Registrant</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>122</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_EG_Event</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>EG_Event_Registrant__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>ZOFU__Zoom_Webinar_Registration__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
