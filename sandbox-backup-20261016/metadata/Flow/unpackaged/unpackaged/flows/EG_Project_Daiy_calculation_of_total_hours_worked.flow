<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <assignments>
        <name>Add_to_Total_Hours_Worked</name>
        <label>Add to Total Hours Worked</label>
        <locationX>264</locationX>
        <locationY>468</locationY>
        <assignmentItems>
            <assignToReference>TotalHoursWorked</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_over_EG_Time_Entries.Hours_Worked__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_over_EG_Time_Entries</targetReference>
        </connector>
    </assignments>
    <environments>Default</environments>
    <interviewLabel>EG Project: Daiy calculation of total hours worked {!$Flow.CurrentDateTime}</interviewLabel>
    <label>EG Project: Daily calculation of total hours worked</label>
    <loops>
        <name>Loop_over_EG_Time_Entries</name>
        <label>Loop over EG Time Entries</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <collectionReference>Get_EG_Time_Entries</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_to_Total_Hours_Worked</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_EG_Project_Total_Hours_Worked</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_EG_Time_Entries</name>
        <label>Get EG Time Entries</label>
        <locationX>176</locationX>
        <locationY>252</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_over_EG_Time_Entries</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>EG_Project__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>EG_Time_Entry__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Hours_Worked__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_EG_Project_Total_Hours_Worked</name>
        <label>Update EG Project Total Hours Worked</label>
        <locationX>176</locationX>
        <locationY>660</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Total_Hours_Worked__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>TotalHoursWorked</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Total_Hours_Worked__c</field>
            <value>
                <elementReference>TotalHoursWorked</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_EG_Time_Entries</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <object>EG_Project__c</object>
        <schedule>
            <dayOfMonthToRun>0</dayOfMonthToRun>
            <frequency>Daily</frequency>
            <frequencyNumber>0</frequencyNumber>
            <startDate>2022-08-31</startDate>
            <startTime>17:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>TotalHoursWorked</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
</Flow>
