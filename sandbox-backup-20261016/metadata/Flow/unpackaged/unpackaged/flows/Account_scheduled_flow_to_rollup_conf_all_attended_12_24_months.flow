    <recordLookups>
        <name>Get_EG_Event_Registrants_12_24_months</name>
        <label>Get EG Event Registrants - 12-24 months</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_12_month_count</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Attended__c</field>
            <operator>EqualTo</operator>
            <value>
