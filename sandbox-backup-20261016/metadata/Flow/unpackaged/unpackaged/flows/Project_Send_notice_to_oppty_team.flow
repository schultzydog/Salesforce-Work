    <status>Obsolete</status>
    <textTemplates>
        <name>ProjectDetails</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;A new Project was added to {!Get_Project.Opportunity__r.Account.Name}. Please create a deliverable to request support from relevant analysts. All necessary fields, including Deadline, Analysts Needed, and Description must be thoroughly reviewed and updated before submitting to research team.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://eurasiagroup.lightning.force.com/lightning/r/Project__c/{!Get_Project.Id}/view&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 12px;&quot;&gt;Link&lt;/a&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt; to record in Salesforce. &lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Project: {!Get_Project.Opportunity__r.Name}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Client: {!Get_Project.Opportunity__r.Account.Name}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Project Value: {!Get_Project.Opportunity__r.Amount}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Client Status: {!Get_Project.Opportunity__r.Account.Status_Enable_Disable__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Service Category: {!Get_Project.Service_Category__c}&lt;/span&gt;&lt;/p&gt;</text>
    </textTemplates>
