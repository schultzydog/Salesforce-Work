            <targetReference>Send_Email</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Has_Leads</name>
        <label>Has Leads?</label>
        <locationX>182</locationX>
        <locationY>360</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Leads</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_email_intro_text_to_body</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>User: Scheduled flow to send new weekly leads {!$Flow.CurrentDateTime}</interviewLabel>
    <label>User: Scheduled flow to send new weekly leads email</label>
    <loops>
        <name>Loop_Leads</name>
        <label>Loop Leads</label>
        <locationX>50</locationX>
        <locationY>576</locationY>
        <collectionReference>Get_Leads</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_to_Email_Body</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Add_Email_Text_at_bottom</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Leads</name>
        <label>Get Leads</label>
        <locationX>182</locationX>
        <locationY>252</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Leads</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Created_in_last_week__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>OwnerId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Lead</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Leads</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Email</field>
            <operator>Contains</operator>
            <value>
                <stringValue>eurasiagroup.net</stringValue>
            </value>
        </filters>
        <filters>
            <field>UserType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Standard</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>User</object>
        <schedule>
            <frequency>Weekly</frequency>
            <startDate>2024-09-19</startDate>
            <startTime>10:30:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>EmailTextBottom</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;a href=&quot;https://eurasiagroup.lightning.force.com/lightning/o/Lead/list?filterName=00B3A00000A2Vaq&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;My leads list view in Salesforce&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://eurasiagroup.lightning.force.com/lightning/r/Report/00O4V000009hkByUAI/view&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;My leads report in Salesforce&lt;/a&gt;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>EmailTextTop</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;The following leads were assigned to you over the last week. Please review the guide on &lt;/span&gt;&lt;a href=&quot;https://eurasiagroup.sharepoint.com/sites/External/Client contracts  relationship management/Forms/AllItems.aspx?id=%2Fsites%2FExternal%2FClient%20contracts%20%20relationship%20management%2FConvert%20a%20lead%2Epdf&amp;amp;parent=%2Fsites%2FExternal%2FClient%20contracts%20%20relationship%20management&amp;amp;p=true&amp;amp;ga=1&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 18px;&quot;&gt;how to convert leads&lt;/a&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;.&lt;/span&gt;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>LeadDetails</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Lead name: {!Loop_Leads.FirstName} {!Loop_Leads.LastName}&lt;/p&gt;&lt;p&gt;Lead source: {!Loop_Leads.LeadSource}&lt;/p&gt;&lt;p&gt;Email: {!Loop_Leads.Email}&lt;/p&gt;&lt;p&gt;Link to record: https://eurasiagroup.lightning.force.com/lightning/r/Lead/{!Loop_Leads.Id}/view&lt;/p&gt;&lt;p&gt;_________________________________________________________________&lt;/p&gt;</text>
    </textTemplates>
