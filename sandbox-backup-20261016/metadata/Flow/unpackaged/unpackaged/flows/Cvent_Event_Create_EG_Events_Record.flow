<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <assignments>
        <name>Add_Registrant_to_list</name>
        <label>Add Registrant to list</label>
        <locationX>264</locationX>
        <locationY>863</locationY>
        <assignmentItems>
            <assignToReference>RegistrantsInsertList</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>EGEventRegistrant</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Cvent_Attendees</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_EG_Event_Registrant</name>
        <label>Assign EG Event Registrant</label>
        <locationX>264</locationX>
        <locationY>755</locationY>
        <assignmentItems>
            <assignToReference>EGEventRegistrant.Contact__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Cvent_Attendees.CventEvents__Contact__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>EGEventRegistrant.EG_Event__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_newly_created_Event_Id.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>EGEventRegistrant.Attended__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>CventAttendance</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>EGEventRegistrant.Lead__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Cvent_Attendees.CventEvents__Lead__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Registrant_to_list</targetReference>
        </connector>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>CventAttendance</name>
        <dataType>Boolean</dataType>
        <expression>IF(TEXT({!Loop_Cvent_Attendees.CventEvents__Attended__c}) = &apos;Yes&apos;, TRUE, FALSE)</expression>
    </formulas>
    <formulas>
        <description>truncated to 80 char</description>
        <name>EventName</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.CventEvents__pkg_Title__c}, 80)</expression>
    </formulas>
    <interviewLabel>Cvent Event: Create EG Events Record {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Cvent Event: Create EG Events Record</label>
    <loops>
        <name>Loop_Cvent_Attendees</name>
        <label>Loop Cvent Attendees</label>
        <locationX>176</locationX>
        <locationY>647</locationY>
        <collectionReference>Get_Cvent_Attendees</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_EG_Event_Registrant</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Insert_EG_Event_Registrants</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_EG_Events_record</name>
        <label>Create EG Events record</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <connector>
            <targetReference>Get_newly_created_Event_Id</targetReference>
        </connector>
        <inputAssignments>
            <field>Created_from_Cvent_Event__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Cvent_Code__c</field>
            <value>
                <elementReference>$Record.CventEvents__pkg_Code__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Event_End_Time__c</field>
            <value>
                <elementReference>$Record.EndDateTime__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Event_Start_Time__c</field>
            <value>
                <elementReference>$Record.StartDateTime__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Location_Type__c</field>
            <value>
                <elementReference>$Record.CventEvents__pkg_EventFormat__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>EventName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Type__c</field>
            <value>
                <elementReference>$Record.CventEvents__pkg_Category__c</elementReference>
            </value>
        </inputAssignments>
        <object>Conference_Call__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Insert_EG_Event_Registrants</name>
        <label>Insert EG Event Registrants</label>
        <locationX>176</locationX>
        <locationY>1055</locationY>
        <inputReference>RegistrantsInsertList</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Cvent_Attendees</name>
        <label>Get Cvent Attendees</label>
        <locationX>176</locationX>
        <locationY>539</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Cvent_Attendees</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CventEvents__Event__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>CventEvents__Attendee__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_newly_created_Event_Id</name>
        <label>Get newly created Event Id</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Cvent_Attendees</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Cvent_Code__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CventEvents__pkg_Code__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Conference_Call__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_EG_Events_record</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CventEvents__pkg_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <object>CventEvents__Event__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>EGEventRegistrant</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>EG_Event_Registrant__c</objectType>
    </variables>
    <variables>
        <name>RegistrantsInsertList</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>EG_Event_Registrant__c</objectType>
    </variables>
</Flow>
