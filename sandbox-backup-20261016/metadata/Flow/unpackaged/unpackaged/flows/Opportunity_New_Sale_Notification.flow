    <apiVersion>59.0</apiVersion>
    <decisions>
        <name>Gloma_AND_New_Sale</name>
        <label>Gloma AND New Sale</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Not Gloma and New Sale</defaultConnectorLabel>
        <rules>
            <name>Gloma</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Business_Line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Global Markets</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New Sale</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_email_to_Oliver</targetReference>
            </connector>
            <label>Gloma and New Sale</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Opportunity: New Sale Notification {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity: New Sale Notification</label>
    <processMetadataValues>
