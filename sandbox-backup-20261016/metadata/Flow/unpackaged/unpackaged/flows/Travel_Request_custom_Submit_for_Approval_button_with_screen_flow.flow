    <apiVersion>65.0</apiVersion>
    <decisions>
        <name>Check_for_number_of_clients</name>
        <label>Check for number of clients</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Confirmation_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No clients selected</defaultConnectorLabel>
        <rules>
            <name>Number_of_clients_0</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Travel_Request.Number_of_clients__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Travel_Request.Confirmed_no_clients__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Purpose</targetReference>
            </connector>
            <label>Number of clients &gt; 0</label>
        </rules>
    </decisions>
    <decisions>
        <name>Purpose</name>
        <label>Purpose</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Submit_for_non_research_travel_approval</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not research travel</defaultConnectorLabel>
        <rules>
            <name>Research_Travel</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Travel_Request.Purpose__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Research Travel</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Submit_for_research_travel_approval</targetReference>
            </connector>
            <label>Research Travel</label>
        </rules>
    </decisions>
