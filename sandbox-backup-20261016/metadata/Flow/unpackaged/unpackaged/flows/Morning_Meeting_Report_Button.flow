<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Email</name>
        <label>Send Email</label>
        <locationX>50</locationX>
        <locationY>650</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>$User.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>List of submissions from Morning Meeting Notes daily report</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>EmailBody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sendRichBody</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>61.0</apiVersion>
    <assignments>
        <name>Add_to_Email_Body</name>
        <label>Add to Email Body</label>
        <locationX>138</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>EmailBody</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>submissionEmailEntry</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_over_submissions</targetReference>
        </connector>
    </assignments>
    <constants>
        <name>EmailAddresses</name>
        <dataType>String</dataType>
        <value>
            <stringValue>schultz@eurasiagroup.net</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Are_there_submissions</name>
        <label>Are there submissions</label>
        <locationX>182</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>NoSubmissionMessage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_there_are_submissions</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Today_s_MM_Submissions</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_over_submissions</targetReference>
            </connector>
            <label>Yes there are submissions</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Morning Meeting Report Button {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Morning Meeting Report Button</label>
    <loops>
        <name>Loop_over_submissions</name>
        <label>Loop over submissions</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <collectionReference>Get_Today_s_MM_Submissions</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_to_Email_Body</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Send_Email</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Today_s_MM_Submissions</name>
        <label>Get Today&apos;s MM Submissions</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Are_there_submissions</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>For_todays_meeting__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Morning_Meeting_Note__c</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>NoSubmissionMessage</name>
        <label>NoSubmissionMessage</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Message</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;There are no morning meeting note submissions today!&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Close</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Today_s_MM_Submissions</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>submissionEmailEntry</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;strong&gt;Submitted by:&lt;/strong&gt; {!Loop_over_submissions.Submitted_by_Name__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Region/Sector:&lt;/strong&gt; {!Loop_over_submissions.Topic__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Proposed Title:&lt;/strong&gt; {!Loop_over_submissions.Proposed_Title__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Client Justification&lt;/strong&gt;: {!Loop_over_submissions.Client_justification__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Argument/bullets:&lt;/strong&gt; {!Loop_over_submissions.Argument__c}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;_________________________________________________________________&lt;/p&gt;</text>
    </textTemplates>
    <variables>
        <name>EmailBody</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>runningUserEmail</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <elementReference>$User.Email</elementReference>
        </value>
    </variables>
</Flow>
