        <filters>
            <field>Risk_Dashboard_Access__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>True</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Risk_Dashboard_send_email__c</field>
            <value>
