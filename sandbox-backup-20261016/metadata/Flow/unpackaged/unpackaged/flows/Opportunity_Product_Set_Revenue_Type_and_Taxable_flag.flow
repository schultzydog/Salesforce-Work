<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <environments>Default</environments>
    <formulas>
        <name>Taxable</name>
        <dataType>Boolean</dataType>
        <expression>IF(  ISPICKVAL({!$Record.Product2.Family}, &apos;Advisory&apos;) || ISPICKVAL({!$Record.Product2.Family}, &apos;Publications&apos;), TRUE, FALSE)</expression>
    </formulas>
    <interviewLabel>Opportunity Product: Set Revenue Type and Taxable flag {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Product: Set Revenue Type and Taxable flag</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_OLI</name>
        <label>Update OLI</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <inputAssignments>
            <field>Revenue_Type__c</field>
            <value>
                <elementReference>$Record.Product2.Revenue_Type__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Taxable__c</field>
            <value>
                <elementReference>Taxable</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_OLI</targetReference>
        </connector>
        <object>OpportunityLineItem</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
