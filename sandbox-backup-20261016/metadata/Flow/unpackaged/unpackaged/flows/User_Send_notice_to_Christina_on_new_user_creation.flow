    <textTemplates>
        <name>EmailBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;{!$Record.FirstName} {!$Record.LastName}&lt;/p&gt;&lt;p&gt;{!$Record.Username}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Link to new user in SF -&lt;/p&gt;&lt;p&gt;https://eurasiagroup.lightning.force.com/{!$Record.Id}&lt;/p&gt;</text>
