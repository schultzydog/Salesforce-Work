<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <decisions>
        <name>Contact_Lead_or_No_Match</name>
        <label>Contact Lead or No Match</label>
        <locationX>842</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Existing_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Contact__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Existing_Contact_fields</targetReference>
            </connector>
            <label>Existing Contact</label>
        </rules>
        <rules>
            <name>Populate_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_matching_Contacts.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Contact_Match</targetReference>
            </connector>
            <label>Populate Contact</label>
        </rules>
        <rules>
            <name>Populate_Lead</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_matching_Contacts.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_matching_Leads.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_with_Lead_Id</targetReference>
            </connector>
            <label>Populate Lead</label>
        </rules>
        <rules>
            <name>Create_Lead_path</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Lead__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Last_Name__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Lead</targetReference>
            </connector>
            <label>Create Lead</label>
        </rules>
    </decisions>
    <decisions>
        <name>Lead_Successfully_created</name>
        <label>Lead Successfully created</label>
        <locationX>974</locationX>
        <locationY>755</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Create_Lead</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_with_Lead_Id_2</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>handles both zoom-originated registrations and others</description>
    <environments>Default</environments>
    <formulas>
        <name>ContactIdLengthCheck</name>
        <dataType>Boolean</dataType>
        <expression>LEN({!Get_matching_Contacts.Id}) = 18</expression>
    </formulas>
    <formulas>
        <name>EGEventAttendeeContactExternalIdCheck</name>
        <dataType>String</dataType>
        <expression>{!$Record.EG_Event__c} + {!$Record.Contact__c}</expression>
    </formulas>
    <formulas>
        <name>EGEventAttendeeLeadExternalIdCheck</name>
        <dataType>String</dataType>
        <expression>{!$Record.EG_Event__c} + {!$Record.Lead__c}</expression>
    </formulas>
    <formulas>
        <name>LeadIdLengthCheck</name>
        <dataType>Boolean</dataType>
        <expression>LEN({!Get_matching_Leads.Id}) = 18</expression>
    </formulas>
    <interviewLabel>EG Event Registrant: Process incoming records {!$Flow.CurrentDateTime}</interviewLabel>
    <label>EG Event Registrant: Process incoming records</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Lead</name>
        <label>Create Lead</label>
        <locationX>974</locationX>
        <locationY>647</locationY>
        <connector>
            <targetReference>Lead_Successfully_created</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Update_Fault_Messge_during_lead_creation</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>City</field>
