    <textTemplates>
        <name>DeliverableDetails</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;font-size: 12px; font-family: &amp;quot;Aptos&amp;quot;, sans-serif;&quot;&gt;You have a request for a deliverable for &lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;{!Deliverable.Opportunity__r.Account.Name} from {!Deliverable.Opportunity__r.Owner.FirstName}. &lt;/span&gt;&lt;span style=&quot;font-size: 12px; font-family: &amp;quot;Aptos&amp;quot;, sans-serif;&quot;&gt;Please reply with any questions regarding the request or to request an extension on the delivery date.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://eurasiagroup.lightning.force.com/lightning/r/Deliverable__c/{!Deliverable.Id}/view&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 12px;&quot;&gt;Link&lt;/a&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt; to record in Salesforce. &lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Project: {!Deliverable.Opportunity__r.Name}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Client: {!Deliverable.Opportunity__r.Account.Name}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Analysts needed: {!Deliverable.Analysts_Needed__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Project Value: {!Deliverable.Opportunity__r.Amount}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Deadline: {!Deliverable.Deadline__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Type of Deliverable: {!Deliverable.Type__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Description: {!Deliverable.Description__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Project lead: {!Deliverable.Project_Lead__r.FirstName} {!Deliverable.Project_Lead__r.LastName}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Kick off call needed: {!Deliverable.Kick_off_call_needed__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Priority: {!Deliverable.Priority__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Relationship Status: {!Deliverable.Relationship_Status__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Client Status: {!Deliverable.Opportunity__r.Account.Status_Enable_Disable__c}&lt;/span&gt;&lt;/p&gt;</text>
