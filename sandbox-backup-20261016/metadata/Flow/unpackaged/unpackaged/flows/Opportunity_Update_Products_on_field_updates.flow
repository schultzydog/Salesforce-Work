<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>To support the Sage Inacct integration, this flow listens for relevant field changes and updates child products accordingly</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity: Update Products on field updates {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity: Update Products on field updates</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Billing_Template</name>
        <label>Get Billing Template</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Products</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Billing_Cycle__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ia_crm__Billing_Template__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Products</name>
        <label>Update Products</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>1 AND (2 OR 3 OR 4 OR 5 OR 6 OR 7 OR 8 OR 9)</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Product_End_Date__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Contract_End_Date__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Product_Start_Date__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Contract_Start_Date__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>ia_crm__Billing_End_Date__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Contract_End_Date__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>ia_crm__Billing_Start_Date__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Contract_Start_Date__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>ia_crm__End_Date__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Contract_End_Date__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>ia_crm__Start_Date__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Contract_Start_Date__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>ia_crm__Billing_Template__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>Get_Billing_Template.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>ia_crm__Intacct_Location__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.ia_crm__Intacct_Location__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>GL_Posting_Date__c</field>
            <value>
                <elementReference>$Record.Contract_Start_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Product_End_Date__c</field>
            <value>
                <elementReference>$Record.Contract_End_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Product_Start_Date__c</field>
            <value>
                <elementReference>$Record.Contract_Start_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ia_crm__Billing_End_Date__c</field>
            <value>
                <elementReference>$Record.Contract_End_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ia_crm__Billing_Start_Date__c</field>
            <value>
                <elementReference>$Record.Contract_Start_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ia_crm__Billing_Template__c</field>
            <value>
                <elementReference>Get_Billing_Template.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ia_crm__End_Date__c</field>
            <value>
                <elementReference>$Record.Contract_End_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ia_crm__Intacct_Location__c</field>
            <value>
                <elementReference>$Record.ia_crm__Intacct_Location__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ia_crm__Start_Date__c</field>
            <value>
                <elementReference>$Record.Contract_Start_Date__c</elementReference>
            </value>
        </inputAssignments>
        <object>OpportunityLineItem</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Billing_Template</targetReference>
        </connector>
        <filterLogic>1 and (2 or 3 or 4)</filterLogic>
        <filters>
            <field>Has_Products__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Billing_Cycle__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Contract_Start_Date__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Contract_End_Date__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
