    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Oppty</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Last_Discussed_at_LSG__c</field>
            <operator>NotEqualTo</operator>
            <value>
