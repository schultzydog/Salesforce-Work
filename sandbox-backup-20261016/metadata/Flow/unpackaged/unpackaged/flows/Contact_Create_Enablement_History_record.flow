    <apiVersion>58.0</apiVersion>
    <decisions>
        <name>Enable_Disable</name>
        <label>Enable/Disable?</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Enabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Enabled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Enablement_History_record_Enabled</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Enabled</label>
        </rules>
        <rules>
            <name>Disabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Disabled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Enablement_History_record_Disabled</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Disabled</label>
        </rules>
    </decisions>
