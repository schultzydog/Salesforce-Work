    <recordLookups>
        <description>query for EG Event by Zoom Webinar Id</description>
        <name>Get_EG_Event</name>
        <label>Get EG Event</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>EG_Event_found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Event_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ZOFU__Zoom_Webinar_Id__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Conference_Call__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
