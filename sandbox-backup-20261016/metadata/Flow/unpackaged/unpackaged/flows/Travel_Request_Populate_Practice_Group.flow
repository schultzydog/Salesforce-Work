<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <decisions>
        <name>Was_Member_record_returned</name>
        <label>Was Member record returned?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Practice_Members</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Travel_Request</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Travel Request: Populate Practice Group {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Travel Request: Populate Practice Group</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Practice_Members</name>
        <label>Get Practice Members</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Was_Member_record_returned</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Practice_member__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Analyst__r.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Member__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Travel_Request</name>
        <label>Update Travel Request</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Practice_Group__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>Get_Practice_Members.Practice_Group__r.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Practice_Group__c</field>
            <value>
                <elementReference>Get_Practice_Members.Practice_Group__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Practice_Head_Email__c</field>
            <value>
                <elementReference>Get_Practice_Members.Practice_Group__r.Practice_Head__r.Email</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Practice_Members</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Analyst__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </filters>
        <object>Travel_Request__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
