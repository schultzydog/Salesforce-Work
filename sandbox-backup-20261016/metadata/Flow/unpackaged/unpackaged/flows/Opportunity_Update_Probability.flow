<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <decisions>
        <name>Standard_or_Custom_update</name>
        <label>Standard or Custom update?</label>
        <locationX>314</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>no updates</defaultConnectorLabel>
        <rules>
            <name>Standard_field_changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Probability</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Probability</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Probability__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Custom_Probability</targetReference>
            </connector>
            <label>Standard Probability changed</label>
        </rules>
        <rules>
            <name>Custom_Probability_changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Probability__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Probability__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Probability</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Standard_Probability</targetReference>
            </connector>
            <label>Custom Probability changed</label>
        </rules>
    </decisions>
    <description>This flow updates the standard Probability field with the custom Probability field value</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity: Update Probability {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity: Update Probability</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Custom_Probability</name>
        <label>Update Custom Probability</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Probability__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Probability</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Probability__c</field>
            <value>
                <elementReference>$Record.Probability</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Standard_Probability</name>
        <label>Update Standard Probability</label>
        <locationX>314</locationX>
        <locationY>395</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Probability</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Probability__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Probability</field>
            <value>
                <elementReference>$Record.Probability__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Standard_or_Custom_update</targetReference>
        </connector>
        <filterLogic>1 OR 2</filterLogic>
        <filters>
            <field>Probability__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Probability</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
