    <recordCreates>
        <name>Create_PV_Entries</name>
        <label>Create PV Entries</label>
        <locationX>182</locationX>
        <locationY>2963</locationY>
        <connector>
            <targetReference>Update_oppty_to_remove_trigger_checkbox</targetReference>
        </connector>
        <inputReference>NewPVEntries</inputReference>
    </recordCreates>
    <recordDeletes>
        <name>Delete_existing_PV_entries</name>
        <label>Delete existing PV entries</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <connector>
            <targetReference>Assign_PV_Reporting_Years</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <object>PV_Entry__c</object>
    </recordDeletes>
    <recordLookups>
        <name>Get_Existing_PV_records</name>
        <label>Get Existing PV records</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Do_PV_Entries_exist</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>PV_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_oppty_to_remove_trigger_checkbox</name>
        <label>Update oppty to remove trigger checkbox</label>
        <locationX>182</locationX>
        <locationY>3071</locationY>
        <inputAssignments>
            <field>Trigger_PV_Entry_flow__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Existing_PV_records</targetReference>
        </connector>
        <filterLogic>1 and 2 and  (3 OR 4 OR 5 OR 6 OR 7)</filterLogic>
        <filters>
            <field>IsWon</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Number_of_year_ends_in_contract__c</field>
            <operator>GreaterThan</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>Trigger_PV_Entry_flow__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Revenue_Corporate_R__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Revenue_GZERO_R__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Revenue_Gloma_R__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Revenue_OOP_R__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
