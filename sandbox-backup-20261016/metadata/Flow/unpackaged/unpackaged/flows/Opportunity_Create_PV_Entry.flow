    <decisions>
        <name>Corporate_entry_creation</name>
        <label>Corporate entry creation</label>
        <locationX>402</locationX>
        <locationY>1247</locationY>
        <defaultConnector>
            <targetReference>Global_markets_PV_entry_creation</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Corporate</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Annualized_Value_Corporate_USD__c</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <connector>
                <targetReference>Assign_Corporate_PV_Entry_values</targetReference>
            </connector>
            <label>Yes Corporate</label>
        </rules>
    </decisions>
    <decisions>
        <name>Do_PV_Entries_exist</name>
        <label>Do PV Entries exist?</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Assign_PV_Reporting_Years</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_PV_entries_exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_PV_records</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_existing_PV_entries</targetReference>
            </connector>
            <label>Yes PV entries exist</label>
        </rules>
    </decisions>
    <decisions>
        <name>Global_markets_PV_entry_creation</name>
