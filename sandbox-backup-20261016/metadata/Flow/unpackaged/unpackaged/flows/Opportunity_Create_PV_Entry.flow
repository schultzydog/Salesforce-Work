    <decisions>
        <name>Has_Second_PV_Reporting_Year</name>
        <label>Has Second PV Reporting Year</label>
        <locationX>182</locationX>
        <locationY>839</locationY>
        <defaultConnector>
            <targetReference>Loop_PV_Reporting_Years</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Second_PV_Reporting_Year__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
