    <apiVersion>57.0</apiVersion>
    <decisions>
        <name>Is_it_a_gloma_oppty</name>
        <label>Is it a gloma oppty?</label>
        <locationX>182</locationX>
        <locationY>252</locationY>
        <defaultConnector>
            <targetReference>email_to_corps</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Business_Line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Global Markets</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Email_to_gloma</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Opportunity: Trial Expiration Reminder {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity: Trial Expiration Reminder</label>
    <processMetadataValues>
