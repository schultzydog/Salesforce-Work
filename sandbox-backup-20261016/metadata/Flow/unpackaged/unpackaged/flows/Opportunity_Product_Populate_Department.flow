<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <decisions>
        <name>Department_found</name>
        <label>Department found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Department</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Product</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>To support the  Sage Intacct integration, the Department field is required to populate on products. This automation populates based on a formula field value.</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity Product: Populate Department {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Product: Populate Department</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Department</name>
        <label>Get Department</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Department_found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ia_crm__Department_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Dept_Code_formula__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>ia_crm__Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ia_crm__Department__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Product</name>
        <label>Update Product</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ia_crm__Department__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>Get_Department.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>ia_crm__Department__c</field>
            <value>
                <elementReference>Get_Department.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Department</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Dept_Code_formula__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Dept_Code_formula__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>N/A</stringValue>
            </value>
        </filters>
        <object>OpportunityLineItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
