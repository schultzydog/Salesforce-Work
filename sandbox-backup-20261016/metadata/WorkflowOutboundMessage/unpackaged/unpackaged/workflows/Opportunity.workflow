        <fields>Id</fields>
        <includeSessionId>false</includeSessionId>
        <integrationUser>schultz@eurasiagroup.net</integrationUser>
        <name>Zapier create SOW zap</name>
        <protected>false</protected>
        <useDeadLetterQueue>false</useDeadLetterQueue>
    </outboundMessages>
</Workflow>
