                    <name>richTextValue</name>
                    <value>&lt;p&gt;&lt;span style=&quot;color: rgb(253, 13, 13);&quot;&gt;Please note this is a renewal Upsell/Downsell opportunity. Check if the Upsell/Downsell Amt - Annualized Value is s&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;howing up as expected.&lt;/span&gt;&lt;/p&gt;</value>
                </componentInstanceProperties>
