                    <name>richTextValue</name>
                    <value>&lt;p&gt;&lt;span style=&quot;color: rgb(253, 3, 3);&quot;&gt;Business Line does not match previous opportunity Business Line.&lt;/span&gt;&lt;/p&gt;</value>
                </componentInstanceProperties>
                <componentName>flexipage:richText</componentName>
                <identifier>flexipage_richText2</identifier>
                <visibilityRule>
                    <booleanFilter>1 AND 2</booleanFilter>
                    <criteria>
                        <leftValue>{!Record.Previous_Business_Line_Different__c}</leftValue>
