                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;p&gt;&lt;span style=&quot;color: rgb(255, 5, 5);&quot;&gt;There is a gap or overlap between the opportunity Contract Start Date and the previous opportunity Contract End Date.&lt;/span&gt;&lt;/p&gt;</value>
                </componentInstanceProperties>
                <componentName>flexipage:richText</componentName>
